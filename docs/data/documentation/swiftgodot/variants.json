{"abstract":[{"text":"Follow up on the fundamental building block of Godot’s data types.","type":"text"}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"article","title":"Variants","modules":[{"name":"SwiftGodot"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"You will often find the type ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","isActive":true,"type":"reference"},{"text":" in Godot source code.   Variants are","type":"text"},{"type":"text","text":" "},{"text":"Godot’s way of passing around certain data types.  They are similar to Swift’s","type":"text"},{"text":" ","type":"text"},{"code":"Any","type":"codeVoice"},{"type":"text","text":" type, but they can only hold Godot types (most structures and classes"},{"type":"text","text":" "},{"type":"text","text":"that derive from "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","isActive":true,"type":"reference"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Creating-Variant-values","text":"Creating Variant values"},{"inlineContent":[{"text":"You can create ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","isActive":true},{"text":"s from types that conform to the","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible","isActive":true,"type":"reference"},{"type":"text","text":" protocol."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This includes the following types:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Godot’s native types: ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GString","type":"reference","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"Vector"},{"type":"text","text":", "},{"code":"Rect","type":"codeVoice"},{"type":"text","text":", "},{"code":"Transform","type":"codeVoice"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Plane"},{"text":", ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Quaternion","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AABB","type":"reference"},{"type":"text","text":",  "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Basis","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Projection","isActive":true},{"text":", ","type":"text"},{"type":"codeVoice","code":"Int64"},{"text":", ","type":"text"},{"code":"NodePaths","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RIDs"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Callable"},{"type":"text","text":", "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantDictionary","type":"reference","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" "},{"type":"text","text":"and PackedArrays."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Swift types that SwiftGodot adds convenience conformances for: ","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" (and all signed\/unsigned width varieties such as ","type":"text"},{"code":"UInt32","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int16","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Double"},{"type":"text","text":","}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Godot’s objects: e.g. "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Area2D","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your own subclasses of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object"},{"text":" type.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Other types that you can manually conform to ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can construct a "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","isActive":true,"type":"reference"},{"type":"text","text":" using these approaches, they are identical:"}]},{"code":["let trueVaraint = Variant(true)","let falseVariant = false.toVariant()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can get a string representation of a variant by calling "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","isActive":true},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant\/description","isActive":true},{"text":" method:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["print(trueVariant.description)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant"},{"type":"text","text":" and want to extract its value, there are some patterns which you can use interchangeably,"},{"type":"text","text":" "},{"text":"they are functionally identical:","type":"text"}]},{"code":["func someFunctionTakingBool(_ bool: Bool?, successCount: inout Int) {","    if let bool {","        successCount += 1","        ","        print(\"\\(bool) again!\")","    }","}","","func boolsUnwrapped(variant: Variant?) -> Int {","    var successCount = 0","    ","    \/\/ 1. Type.init(_ variant: Variant)","    \/\/ Available for all types except `Object`-derived","    if let boolValue = Bool(variant) {","        print(\"I'm \\(boolValue)!\")","        successCount += 1","    }","    ","    \/\/ 2. Type.fromVariant","    if let boolValue = Bool.fromVariant(variant) {","        print(\"Still \\(boolValue)...\")","        successCount += 1","    }","    ","    \/\/ 3. Variant.to(Type.self)","    if let boolValue = variant.to(Bool.self) {","        print(\"Nothing changed, it's \\(boolValue)\")","        successCount += 1","    }","    ","    \/\/ 4. The (3) option is even more useful when Swift can deduct the type you want to convert to!","    \/\/ Here Swift understands that `variant.to()` should unwrap `Bool` because on the left part says `: Bool`.","    if let boolValue: Bool = variant.to() {","        print(\"Oh, I see you enjoy Swift type inferrence! I'm \\(boolValue)\")","        successCount += 1","    }","    ","    \/\/ 5. (3) can work even if type is specified somewhere else! ","    someFunctionTakingBool(variant.to(), successCount: &successCount)","","    return successCount","}","","print(boolsUnwrapped(true.toVariant()) \/\/ prints 5! We unwrapped our `true` 5 times!"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Note that all the functions above return "},{"type":"codeVoice","code":"Bool?"},{"type":"text","text":" because there is no guaruantee that"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Variant?","type":"codeVoice"},{"type":"text","text":" is actually not "},{"type":"codeVoice","code":"nil"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","isActive":true,"type":"reference"},{"type":"text","text":" even if it’s not "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", contains a "},{"type":"codeVoice","code":"Bool"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"variant.to(Type.self)"},{"type":"text","text":", "},{"code":"Type.fromVariant(variant)","type":"codeVoice"},{"text":" return ","type":"text"},{"code":"T?","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"codeVoice","code":"Type.init(variant)"},{"type":"text","text":" or just "},{"type":"codeVoice","code":"Type(variant)"},{"text":" is a ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/swift\/blog\/?id=17"},{"type":"text","text":""},{"type":"text","text":" "},{"text":"If the variant does not contain the type you are requesting the result of the call is ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"So in general unwrapping a variant can use the following pattern:","type":"text"}]},{"type":"codeListing","code":["if let string = String.fromVariant(variant) {","    \/\/ do something with `String`!","    print(string)","}"],"syntax":"swift"},{"inlineContent":[{"text":"or this:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["guard let vector0 = Vector3.fromVariant(variant0) else {","    return","}","","guard let vector1 = Vector3.fromVariant(variant1) else {","    return","}","","\/\/ We are guaranteed to have both vectors now! ","let vector2 = vector0 + vector1"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use throwing version of those APIs:"}]},{"code":["let variants = [","    Vector3.back.toVariant(),","    Vector3.right.toVariant(),","    Vector3.up.toVariant(),","]","                    ","do {","    var result = Vector3()","    for variant in variants {","        result += try Vector3.fromVariantOrThrow(variant)","    }","    \/\/ use result    ","} catch {","    \/\/ error is guaranteed typed `VariantConversionError`","    print(error.description)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Common Usage Patterns","anchor":"Common-Usage-Patterns","type":"heading"},{"inlineContent":[{"text":"The following are some examples of how to work with Variants in practice, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"some idioms suitable to be used with Swift."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following example, imagine that an API returns a Variant value that"},{"text":" ","type":"text"},{"type":"text","text":"contains a dictionary with string keys and values are "},{"type":"codeVoice","code":"PackedArrayInt32"},{"text":", this","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is how you would decode this:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/\/ This converts a variant that contains a dictionary of string keys and an ","\/\/\/ array of integers into the native Swift dictionary","func decode (variant: Variant) -> [String: [Int32]]? {","    guard let dict = VariantDictionary (variant) else {","        \/\/ If the variant is not a dictionary, we return nil","        return nil","    }","    var result = [String: [Int32]] ()","    for (key, value) in dict {","        guard let packedArray = PackedArrayInt32 (value) else {","            \/\/ If the `value` in the dictionary is not of type `PackedArrayInt32`, we ski it","            continue","        }","        result [key] = packedArray","    }","    return result","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The above shows a defensive style of programming, where we prepare for the","type":"text"},{"text":" ","type":"text"},{"text":"possibility that we do not receive a dictionary, or the values in the dictionary","type":"text"},{"type":"text","text":" "},{"text":"are not of type ","type":"text"},{"code":"PackedArrayInt32","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples shows how to encode an array that contains"},{"type":"text","text":" "},{"type":"text","text":"paris of file names and sizes into a Godot "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","isActive":true},{"text":" with","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantDictionary"},{"text":" elements:","type":"text"}]},{"type":"codeListing","code":["func encode(values: [(String,Int)]) -> Variant {","    let array = VariantArray ()","    for (fileName, size) in values {","        let dict = VariantDictionary ()","        dict [\"file_name\"] = Variant (fileName)","        dict [\"size\"] = Variant (size)","        array.append (dict)","    }","    return Variant (array)","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The next example shows how to decode the result of the above.  The "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","type":"reference","isActive":true},{"type":"text","text":" "},{"text":"and ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantDictionary","type":"reference","isActive":true},{"text":" are weakly typed, so the inverse operation takes a defensive","type":"text"},{"type":"text","text":" "},{"text":"approach.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func decode(variant: Variant) -> [(String, Int)]? {","    guard let array = Array (variant) else {","        \/\/ If the variant is not an array, we return nil","        return nil","    }","    var result = [(String, Int)] ()","    for element in array {","        guard let dict = VariantDictionary (element) else {","            \/\/ If the element in the array is not a dictionary, we skip it","            continue","        }","        guard let fileNameV = dict [\"file_name\"], ","              let fileName = String (filenameV) else {","            \/\/ If the dictionary does not contain a string with the ","            \/\/ key \"file_name\", we skip it","            continue","        }","        guard let sizeV = dict [\"size\"],","              let size = Int (sizeV) else {","            \/\/ If the dictionary does not contain an integer with the key ","            \/\/ \"size\", or if the value can not be converted to an Int,","            \/\/ we skip it","            continue","        }","        result.append ((fileName, size))","    }","    return result","}"],"type":"codeListing"},{"type":"heading","text":"Extracting Godot-derived objects from Variants","anchor":"Extracting-Godot-derived-objects-from-Variants","level":2},{"type":"paragraph","inlineContent":[{"text":"You can use the same principles to turn a Godot object encoded into a Variant","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into a SwiftGodot object that you used above like "},{"type":"codeVoice","code":"Node.fromVariant()"},{"type":"text","text":" or you"},{"text":" ","type":"text"},{"type":"text","text":"can use the "},{"code":".asObject()","type":"codeVoice"},{"text":" method on the variant to get the object back.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func getNode (variant: Variant) -> Node? {","    guard let node = variant.asObject (Node.self)) else {","\t  return nil","    }","    return node","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or you can use the alternative version:"}]},{"code":["func getNode (variant: Variant) -> Node? {","    guard let node = Node.fromVariant(variant) else {","\t  return nil","    }","    return node","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The reason why we do not surface object constructors that take a variant, is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that we need to ensure that for any given Godot-object, only a single"},{"text":" ","type":"text"},{"type":"text","text":"SwiftGodot.Object exists."}],"type":"paragraph"},{"type":"heading","text":"Accessing Array Elements","anchor":"Accessing-Array-Elements","level":2},{"type":"paragraph","inlineContent":[{"text":"Some of the variant types contain arrays, either objects, or a particular","type":"text"},{"type":"text","text":" "},{"type":"text","text":"packed version of those.   You can access the individual elements of the"},{"type":"text","text":" "},{"type":"text","text":"those with a convenient subscript provided on the array."}]},{"syntax":"swift","code":["func foo(_ array: VariantArray) {","    let variant = array[4] \/\/ returns Variant? since Godot arrays can store `nil`s","}"],"type":"codeListing"},{"text":"Calling Variant Methods","type":"heading","level":2,"anchor":"Calling-Variant-Methods"},{"inlineContent":[{"type":"text","text":"It is possible to invoke the built-in variant methods that exist in the Godot"},{"text":" ","type":"text"},{"type":"text","text":"universe by using the "},{"type":"codeVoice","code":"call"},{"type":"text","text":" method on a Variant.   This is very similar to the"},{"text":" ","type":"text"},{"text":"call method on an Object.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For example, you can invoke this generic “size” method on an array to get the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"size of an array, regardless of the specific type of array:"}]},{"code":["func printSize (myArray: Variant) {","    switch variant.call(method: \"size\") {","    case .failure(let err):","        print (err)","        return 0","    case .success(let val):","        return Int (val) ?? 0","    }","}"],"syntax":"swift","type":"codeListing"},{"level":1,"anchor":"Under-the-hood","type":"heading","text":"Under the hood"},{"inlineContent":[{"text":"SwiftGodot surfaces Variants in two ways, one is ","type":"text"},{"type":"codeVoice","code":"Variant"},{"text":" that we have","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"discussed above extensively which is a class type, and this is necessary for"},{"type":"text","text":" "},{"type":"text","text":"ensuring that the variants release the underlying data when they are no longer"},{"text":" ","type":"text"},{"type":"text","text":"in use."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"SwiftGodot surfaces the Variant type in returns and as input parameters to its"},{"text":" ","type":"text"},{"type":"text","text":"API."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"There is an advanced ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FastVariant"},{"type":"text","text":" type that uses Swift’s "},{"type":"codeVoice","code":"~Copyable"},{"text":" support","type":"text"},{"type":"text","text":" "},{"text":"that creates a lightweight Variant, and is essentially the same as the C++","type":"text"},{"type":"text","text":" "},{"text":"counterpart in terms of performance.  This is used internally in SwiftGodot, and","type":"text"},{"type":"text","text":" "},{"text":"you can convert back and forth from the Variant types, this means that there are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fewer heap allocations and you do not incur on the overhead of"},{"type":"text","text":" "},{"type":"text","text":"automatic-reference counting, and instead use Swift’s built-in type ownership support."}]},{"type":"paragraph","inlineContent":[{"text":"The longer-term plan is to make it so that our APIs can take both Variant and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"FastVariant."}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/swiftgodot\/variants"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation"],"title":"Articles and Tutorials","anchor":"Articles-and-Tutorials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants"},"references":{"doc://SwiftGodot/documentation/SwiftGodot/FastVariant":{"navigatorTitle":[{"kind":"identifier","text":"FastVariant"}],"title":"FastVariant","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"FastVariant","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FastVariant","abstract":[{"text":"Sibling of ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","type":"reference","isActive":true},{"type":"text","text":" for cases where performance is critical."},{"type":"text","text":" "},{"type":"text","text":"It doesn’t require heap allocation but it’s a move-only type so it’s more cumbersome to work with."},{"type":"text","text":" "},{"type":"text","text":"This type is guaranteed to contain a non-nil Godot Variant payload."}],"role":"symbol","url":"\/documentation\/swiftgodot\/fastvariant"},"doc://SwiftGodot/documentation/SwiftGodot/Basis":{"abstract":[{"text":"A 3×3 matrix for representing 3D rotation and scale.","type":"text"}],"title":"Basis","url":"\/documentation\/swiftgodot\/basis","navigatorTitle":[{"kind":"identifier","text":"Basis"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Basis","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"Basis","kind":"identifier"}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/CustomTypes":{"kind":"article","type":"topic","title":"Using Custom Types","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","url":"\/documentation\/swiftgodot\/customtypes","role":"article","abstract":[{"type":"text","text":"You will typically extend the functionality of your Godot game by creating"},{"type":"text","text":" "},{"text":"classes that derive from one of the various Godot types and adjust the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"behavior accordingly."}]},"doc://SwiftGodot/documentation/SwiftGodot/RunningInEditor":{"kind":"article","type":"topic","title":"Running Code in the Godot Editor","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","url":"\/documentation\/swiftgodot\/runningineditor","role":"article","abstract":[{"type":"text","text":"There are cases where you might want some of your Swift code for your extension"},{"type":"text","text":" "},{"text":"to run while it is being used in the Godot Editor.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Node":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Node","kind":"identifier"}],"kind":"symbol","title":"Node","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","navigatorTitle":[{"text":"Node","kind":"identifier"}],"abstract":[{"type":"text","text":"Base class for all scene objects."}],"role":"symbol","type":"topic","url":"\/documentation\/swiftgodot\/node"},"doc://SwiftGodot/documentation/SwiftGodot/VariantDictionary":{"url":"\/documentation\/swiftgodot\/variantdictionary","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantDictionary"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"VariantDictionary","kind":"identifier"}],"kind":"symbol","title":"VariantDictionary","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantDictionary","type":"topic","abstract":[{"type":"text","text":"A built-in data structure that holds key-value pairs."}]},"doc://SwiftGodot/documentation/SwiftGodot/Exports":{"kind":"article","type":"topic","title":"Exports","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","url":"\/documentation\/swiftgodot\/exports","role":"article","abstract":[{"type":"text","text":"In Godot, class members can be exported. This means their value gets saved along"},{"type":"text","text":" "},{"text":"with the resource (such as the scene) they’re attached to. They will also be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"available for editing in the property editor. Exporting is done by using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Export"},{"text":" annotation.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Callable":{"navigatorTitle":[{"text":"Callable","kind":"identifier"}],"role":"symbol","title":"Callable","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Callable","kind":"symbol","abstract":[{"text":"A built-in type representing a method or a standalone function.","type":"text"}],"url":"\/documentation\/swiftgodot\/callable","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"ide