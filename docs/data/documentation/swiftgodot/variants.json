{"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"kind":"article","abstract":[{"text":"Follow up on the fundamental building block of Godot’s data types.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/variants"]}],"metadata":{"modules":[{"name":"SwiftGodot"}],"title":"Variants","roleHeading":"Article","role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"You will often find the type ","type":"text"},{"code":"Variant","type":"codeVoice"},{"text":" in Godot source code.   Variants are","type":"text"},{"text":" ","type":"text"},{"text":"Godot’s way of passing around certain data types.  They are similar to Swift’s","type":"text"},{"text":" ","type":"text"},{"code":"Any","type":"codeVoice"},{"text":" type, but they can only hold Godot types (most structures and classes","type":"text"},{"text":" ","type":"text"},{"text":"that derive from ","type":"text"},{"code":"Object","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"heading","text":"Creating Variant values","level":2,"anchor":"Creating-Variant-values"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create "},{"type":"codeVoice","code":"Variant"},{"type":"text","text":"s from types that conform to the"},{"type":"text","text":" "},{"type":"codeVoice","code":"VariantConvertible"},{"type":"text","text":" protocol."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This includes the following types:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Godot’s native types: "},{"code":"GString","type":"codeVoice"},{"type":"text","text":", "},{"code":"Vector","type":"codeVoice"},{"type":"text","text":", "},{"code":"Rect","type":"codeVoice"},{"type":"text","text":", "},{"code":"Transform","type":"codeVoice"},{"type":"text","text":", "},{"code":"Plane","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Quaternion"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"AABB"},{"type":"text","text":",  "},{"type":"codeVoice","code":"Basis"},{"type":"text","text":", "},{"type":"codeVoice","code":"Projection"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int64"},{"text":", ","type":"text"},{"code":"NodePaths","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RIDs","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Callable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"VariantDictionary","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and PackedArrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Swift types that SwiftGodot adds convenience conformances for: ","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" (and all signed\/unsigned width varieties such as ","type":"text"},{"code":"UInt32","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int16","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Float"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Double"},{"type":"text","text":","}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Godot’s objects: e.g. "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Area2D","isActive":true}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Your own subclasses of "},{"code":"Object","type":"codeVoice"},{"type":"text","text":" type."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other types that you can manually conform to "},{"type":"codeVoice","code":"VariantConvertible"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can construct a "},{"type":"codeVoice","code":"Variant"},{"type":"text","text":" using these approaches, they are identical:"}]},{"type":"codeListing","syntax":"swift","code":["let trueVaraint = Variant(true)","let falseVariant = false.toVariant()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can get a string representation of a variant by calling "},{"type":"codeVoice","code":"Variant"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Variant\/description"},{"type":"text","text":" method:"}]},{"type":"codeListing","syntax":"swift","code":["print(trueVariant.description)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a "},{"code":"Variant","type":"codeVoice"},{"type":"text","text":" and want to extract its value, there are some patterns which you can use interchangeably,"},{"type":"text","text":" "},{"type":"text","text":"they are functionally identical:"}]},{"code":["func someFunctionTakingBool(_ bool: Bool?, successCount: inout Int) {","    if let bool {","        successCount += 1","        ","        print(\"\\(bool) again!\")","    }","}","","func boolsUnwrapped(variant: Variant?) -> Int {","    var successCount = 0","    ","    \/\/ 1. Type.init(_ variant: Variant)","    \/\/ Available for all types except `Object`-derived","    if let boolValue = Bool(variant) {","        print(\"I'm \\(boolValue)!\")","        successCount += 1","    }","    ","    \/\/ 2. Type.fromVariant","    if let boolValue = Bool.fromVariant(variant) {","        print(\"Still \\(boolValue)...\")","        successCount += 1","    }","    ","    \/\/ 3. Variant.to(Type.self)","    if let boolValue = variant.to(Bool.self) {","        print(\"Nothing changed, it's \\(boolValue)\")","        successCount += 1","    }","    ","    \/\/ 4. The (3) option is even more useful when Swift can deduct the type you want to convert to!","    \/\/ Here Swift understands that `variant.to()` should unwrap `Bool` because on the left part says `: Bool`.","    if let boolValue: Bool = variant.to() {","        print(\"Oh, I see you enjoy Swift type inferrence! I'm \\(boolValue)\")","        successCount += 1","    }","    ","    \/\/ 5. (3) can work even if type is specified somewhere else! ","    someFunctionTakingBool(variant.to(), successCount: &successCount)","","    return successCount","}","","print(boolsUnwrapped(true.toVariant()) \/\/ prints 5! We unwrapped our `true` 5 times!"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that all the functions above return "},{"code":"Bool?","type":"codeVoice"},{"type":"text","text":" because there is no guaruantee that"}]},{"items":[{"content":[{"inlineContent":[{"code":"Variant?","type":"codeVoice"},{"text":" is actually not ","type":"text"},{"code":"nil","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Variant"},{"text":" even if it’s not ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", contains a ","type":"text"},{"type":"codeVoice","code":"Bool"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"variant.to(Type.self)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Type.fromVariant(variant)"},{"text":" return ","type":"text"},{"type":"codeVoice","code":"T?"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Type.init(variant)"},{"type":"text","text":" or just "},{"type":"codeVoice","code":"Type(variant)"},{"type":"text","text":" is a "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/swift\/blog\/?id=17"},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"If the variant does not contain the type you are requesting the result of the call is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So in general unwrapping a variant can use the following pattern:"}]},{"code":["if let string = String.fromVariant(variant) {","    \/\/ do something with `String`!","    print(string)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"or this:","type":"text"}]},{"code":["guard let vector0 = Vector3.fromVariant(variant0) else {","    return","}","","guard let vector1 = Vector3.fromVariant(variant1) else {","    return","}","","\/\/ We are guaranteed to have both vectors now! ","let vector2 = vector0 + vector1"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can also use throwing version of those APIs:","type":"text"}]},{"type":"codeListing","code":["let variants = [","    Vector3.back.toVariant(),","    Vector3.right.toVariant(),","    Vector3.up.toVariant(),","]","                    ","do {","    var result = Vector3()","    for variant in variants {","        result += try Vector3.fromVariantOrThrow(variant)","    }","    \/\/ use result    ","} catch {","    \/\/ error is guaranteed typed `VariantConversionError`","    print(error.description)","}"],"syntax":"swift"},{"type":"heading","text":"Common Usage Patterns","level":2,"anchor":"Common-Usage-Patterns"},{"type":"paragraph","inlineContent":[{"text":"The following are some examples of how to work with Variants in practice, and","type":"text"},{"text":" ","type":"text"},{"text":"some idioms suitable to be used with Swift.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In the following example, imagine that an API returns a Variant value that","type":"text"},{"text":" ","type":"text"},{"text":"contains a dictionary with string keys and values are ","type":"text"},{"code":"PackedInt32Array","type":"codeVoice"},{"text":", this","type":"text"},{"text":" ","type":"text"},{"text":"is how you would decode this:","type":"text"}]},{"type":"codeListing","code":["\/\/\/ This converts a variant that contains a dictionary of string keys and an ","\/\/\/ array of integers into the native Swift dictionary","func decode (variant: Variant) -> [String: [Int32]]? {","    guard let dict = VariantDictionary (variant) else {","        \/\/ If the variant is not a dictionary, we return nil","        return nil","    }","    var result = [String: [Int32]] ()","    for (key, value) in dict {","        guard let packedArray = PackedInt32Array (value) else {","            \/\/ If the `value` in the dictionary is not of type `PackedInt32Array`, we skip it","            continue","        }","        result [key] = packedArray","    }","    return result","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The above shows a defensive style of programming, where we prepare for the"},{"type":"text","text":" "},{"type":"text","text":"possibility that we do not receive a dictionary, or the values in the dictionary"},{"type":"text","text":" "},{"type":"text","text":"are not of type "},{"type":"codeVoice","code":"PackedInt32Array"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following examples shows how to encode an array that contains"},{"type":"text","text":" "},{"type":"text","text":"paris of file names and sizes into a Godot "},{"type":"codeVoice","code":"VariantArray"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"VariantDictionary"},{"type":"text","text":" elements:"}]},{"type":"codeListing","code":["func encode(values: [(String,Int)]) -> Variant {","    let array = VariantArray ()","    for (fileName, size) in values {","        let dict = VariantDictionary ()","        dict [\"file_name\"] = Variant (fileName)","        dict [\"size\"] = Variant (size)","        array.append (dict)","    }","    return Variant (array)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The next example shows how to decode the result of the above.  The "},{"code":"VariantArray","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"VariantDictionary","type":"codeVoice"},{"type":"text","text":" are weakly typed, so the inverse operation takes a defensive"},{"type":"text","text":" "},{"type":"text","text":"approach."}]},{"type":"codeListing","code":["func decode(variant: Variant) -> [(String, Int)]? {","    guard let array = Array (variant) else {","        \/\/ If the variant is not an array, we return nil","        return nil","    }","    var result = [(String, Int)] ()","    for element in array {","        guard let dict = VariantDictionary (element) else {","            \/\/ If the element in the array is not a dictionary, we skip it","            continue","        }","        guard let fileNameV = dict [\"file_name\"], ","              let fileName = String (filenameV) else {","            \/\/ If the dictionary does not contain a string with the ","            \/\/ key \"file_name\", we skip it","            continue","        }","        guard let sizeV = dict [\"size\"],","              let size = Int (sizeV) else {","            \/\/ If the dictionary does not contain an integer with the key ","            \/\/ \"size\", or if the value can not be converted to an Int,","            \/\/ we skip it","            continue","        }","        result.append ((fileName, size))","    }","    return result","}"],"syntax":"swift"},{"type":"heading","text":"Extracting Godot-derived objects from Variants","level":2,"anchor":"Extracting-Godot-derived-objects-from-Variants"},{"type":"paragraph","inlineContent":[{"text":"You can use the same principles to turn a Godot object encoded into a Variant","type":"text"},{"text":" ","type":"text"},{"text":"into a SwiftGodot object that you used above like ","type":"text"},{"code":"Node.fromVariant()","type":"codeVoice"},{"text":" or you","type":"text"},{"text":" ","type":"text"},{"text":"can use the ","type":"text"},{"code":".asObject()","type":"codeVoice"},{"text":" method on the variant to get the object back.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example:","type":"text"}]},{"type":"codeListing","code":["func getNode (variant: Variant) -> Node? {","    guard let node = variant.asObject (Node.self)) else {","\t  return nil","    }","    return node","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or you can use the alternative version:"}]},{"type":"codeListing","code":["func getNode (variant: Variant) -> Node? {","    guard let node = Node.fromVariant(variant) else {","\t  return nil","    }","    return node","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reason why we do not surface object constructors that take a variant, is"},{"type":"text","text":" "},{"type":"text","text":"that we need to ensure that for any given Godot-object, only a single"},{"type":"text","text":" "},{"type":"text","text":"SwiftGodot.Object exists."}]},{"type":"heading","text":"Accessing Array Elements","level":2,"anchor":"Accessing-Array-Elements"},{"type":"paragraph","inlineContent":[{"text":"Some of the variant types contain arrays, either objects, or a particular","type":"text"},{"text":" ","type":"text"},{"text":"packed version of those.   You can access the individual elements of the","type":"text"},{"text":" ","type":"text"},{"text":"those with a convenient subscript provided on the array.","type":"text"}]},{"type":"codeListing","code":["func foo(_ array: VariantArray) {","    let variant = array[4] \/\/ returns Variant? since Godot arrays can store `nil`s","}"],"syntax":"swift"},{"type":"heading","text":"Calling Variant Methods","level":2,"anchor":"Calling-Variant-Methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to invoke the built-in variant methods that exist in the Godot"},{"type":"text","text":" "},{"type":"text","text":"universe by using the "},{"type":"codeVoice","code":"call"},{"type":"text","text":" method on a Variant.   This is very similar to the"},{"type":"text","text":" "},{"type":"text","text":"call method on an Object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, you can invoke this generic “size” method on an array to get the"},{"type":"text","text":" "},{"type":"text","text":"size of an array, regardless of the specific type of array:"}]},{"type":"codeListing","code":["func printSize (myArray: Variant) {","    switch variant.call(method: \"size\") {","    case .failure(let err):","        print (err)","        return 0","    case .success(let val):","        return Int (val) ?? 0","    }","}"],"syntax":"swift"},{"type":"heading","text":"Under the hood","level":1,"anchor":"Under-the-hood"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftGodot surfaces Variants in two ways, one is "},{"type":"codeVoice","code":"Variant"},{"type":"text","text":" that we have"},{"type":"text","text":" "},{"type":"text","text":"discussed above extensively which is a class type, and this is necessary for"},{"type":"text","text":" "},{"type":"text","text":"ensuring that the variants release the underlying data when they are no longer"},{"type":"text","text":" "},{"type":"text","text":"in use."}]},{"type":"paragraph","inlineContent":[{"text":"SwiftGodot surfaces the Variant type in returns and as input parameters to its","type":"text"},{"text":" ","type":"text"},{"text":"API.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There is an advanced ","type":"text"},{"code":"FastVariant","type":"codeVoice"},{"text":" type that uses Swift’s ","type":"text"},{"code":"~Copyable","type":"codeVoice"},{"text":" support","type":"text"},{"text":" ","type":"text"},{"text":"that creates a lightweight Variant, and is essentially the same as the C++","type":"text"},{"text":" ","type":"text"},{"text":"counterpart in terms of performance.  This is used internally in SwiftGodot, and","type":"text"},{"text":" ","type":"text"},{"text":"you can convert back and forth from the Variant types, this means that there are","type":"text"},{"text":" ","type":"text"},{"text":"fewer heap allocations and you do not incur on the overhead of","type":"text"},{"text":" ","type":"text"},{"text":"automatic-reference counting, and instead use Swift’s built-in type ownership support.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The longer-term plan is to make it so that our APIs can take both Variant and"},{"type":"text","text":" "},{"type":"text","text":"FastVariant."}]}]}],"sections":[],"seeAlsoSections":[{"title":"Articles and Tutorials","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RemoteProcedureCalls","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Documentation"],"anchor":"Articles-and-Tutorials"}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/MemoryManagement":{"url":"\/documentation\/swiftgodot\/memorymanagement","kind":"article","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","abstract":[{"type":"text","text":"SwiftGodot surfaces various Godot types into the Swift universe in various ways:"}],"title":"Memory Management in SwiftGodot","type":"topic","role":"article"},"https://developer.apple.com/swift/blog/?id=17":{"titleInlineContent":[{"type":"text","text":"failable initializer"}],"url":"https:\/\/developer.apple.com\/swift\/blog\/?id=17","type":"link","identifier":"https:\/\/developer.apple.com\/swift\/blog\/?id=17","title":"failable initializer"},"doc://SwiftGodot/documentation/SwiftGodot/TypesTranslation":{"url":"\/documentation\/swiftgodot\/typestranslation","kind":"article","type":"topic","title":"Types Translation","role":"article","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","abstract":[{"type":"text","text":"This document contains information on how type translation happens between Swift and Godot."}]},"doc://SwiftGodot/documentation/SwiftGodot/Exports":{"kind":"article","abstract":[{"type":"text","text":"In Godot, class members can be exported. This means their value gets saved along"},{"type":"text","text":" "},{"type":"text","text":"with the resource (such as the scene) they’re attached to. They will also be"},{"type":"text","text":" "},{"type":"text","text":"available for editing in the property editor. Exporting is done by using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Export"},{"type":"text","text":" annotation."}],"url":"\/documentation\/swiftgodot\/exports","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","type":"topic","title":"Exports","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Area2D":{"kind":"symbol","url":"\/documentation\/swiftgodot\/area2d","abstract":[{"type":"text","text":"A region of 2D space that detects other "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CollisionObject2D"},{"type":"text","text":"s entering or exiting it."}],"type":"topic","title":"Area2D","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Area2D"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Area2D","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Area2D"}]},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/CollisionObject2D":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CollisionObject2D","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"CollisionObject2D","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CollisionObject2D","role":"symbol","url":"\/documentation\/swiftgodot\/collisionobject2d","title":"CollisionObject2D","abstract":[{"type":"text","text":"Abstract base class for 2D physics objects."}]},"doc://SwiftGodot/documentation/SwiftGodot/Documentation":{"type":"topic","url":"\/documentation\/swiftgodot\/documentation","kind":"article","title":"Documenting your Godot Extension","abstract":[{"type":"text","text":"If you are developing a Godot extension that is intended to be consumed from"},{"type":"text","text":" "},{"type":"text","text":"Godot you might want to provide documentation for it."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Documentation","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/RemoteProcedureCalls":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RemoteProcedureCalls","url":"\/documentation\/swiftgodot\/remoteprocedurecalls","title":"Remote Procedure Calls","kind":"article","role":"article","abstract":[{"text":"Use the ","type":"text"},{"code":"@Rpc","type":"codeVoice"},{"text":" macro to configure methods for Godot’s multiplayer RPC system.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/RunningInEditor":{"type":"topic","title":"Running Code in the Godot Editor","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","abstract":[{"text":"There are cases where you might want some of your Swift code for your extension","type":"text"},{"text":" ","type":"text"},{"text":"to run while it is being used in the Godot Editor.","type":"text"}],"kind":"article","url":"\/documentation\/swiftgodot\/runningineditor","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/BindingNodes":{"role":"article","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","kind":"article","title":"Referencing Nodes from your Scene","abstract":[{"text":"You will find yourself referencing nodes from a scene in your code. In","type":"text"},{"text":" ","type":"text"},{"text":"GDScript, that is usually achieved by using the dollar sign and the name of the","type":"text"},{"text":" ","type":"text"},{"text":"object you want to reference.","type":"text"}],"url":"\/documentation\/swiftgodot\/bindingnodes"},"doc://SwiftGodot/documentation/SwiftGodot/Node":{"kind":"symbol","abstract":[{"text":"Base class for all scene objects.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Node","kind":"identifier"}],"title":"Node","url":"\/documentation\/swiftgodot\/node","type":"topic","navigatorTitle":[{"text":"Node","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/Signals":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","url":"\/documentation\/swiftgodot\/signals","kind":"article","role":"article","type":"topic","title":"Signals","abstract":[{"text":"Signals in Godot are used by objects to post interesting events that are","type":"text"},{"text":" ","type":"text"},{"text":"taking place, and can be used by users to easily add behavior and react","type":"text"},{"text":" ","type":"text"},{"text":"to changes.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Differences":{"type":"topic","url":"\/documentation\/swiftgodot\/differences","kind":"article","title":"SwiftGodot API differences to GDScript","role":"article","abstract":[{"type":"text","text":"This document lists some common differences between GDSscript and SwiftGodot."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences"},"doc://SwiftGodot/documentation/SwiftGodot/CustomTypes":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","url":"\/documentation\/swiftgodot\/customtypes","title":"Using Custom Types","kind":"article","role":"article","abstract":[{"text":"You will typically extend the functionality of your Godot game by creating","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"classes that derive from one of the various Godot types and adjust the"},{"type":"text","text":" "},{"type":"text","text":"behavior accordingly."}],"type":"topic"}}}