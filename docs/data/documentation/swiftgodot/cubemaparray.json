{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray\/createPlaceholder()"],"anchor":"Instance-Methods","generated":true},{"title":"Type Properties","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray\/godotClassName"],"anchor":"Type-Properties","generated":true}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ImageTextureLayered"]},{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CubemapArray","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","type":"reference","isActive":true},{"type":"text","text":"s are made of an array of "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","type":"reference","isActive":true},{"type":"text","text":"s. Like "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","type":"reference","isActive":true},{"type":"text","text":"s, they are made of multiple textures, the amount of which must be divisible by 6 (one for each face of the cube)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The primary benefit of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"type":"text","text":"s is that they can be accessed in shader code using a single texture reference. In other words, you can pass multiple "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap"},{"type":"text","text":"s into a shader using a single "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap"},{"type":"text","text":"s are allocated in adjacent cache regions on the GPU, which makes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"type":"text","text":"s the most efficient way to store multiple "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap"},{"type":"text","text":"s."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Godot uses "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"type":"text","text":"s internally for many effects, including the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sky"},{"type":"text","text":" if you set "},{"type":"codeVoice","code":"ProjectSettings\/rendering\/reflections\/skyReflections\/textureArrayReflections"},{"type":"text","text":" to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"To create such a texture file yourself, reimport your image files using the Godot Editor import presets. To create a CubemapArray from code, use ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ImageTextureLayered\/createFromImages(_:)","isActive":true,"type":"reference"},{"text":" on an instance of the CubemapArray class.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The expected image order is X+, X-, Y+, Y-, Z+, Z- (in Godot’s coordinate system, so Y+ is “up” and Z- is “forward”). You can use one of the following templates as a base:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"2×3 cubemap template (default layout option)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"3×2 cubemap template"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"1×6 cubemap template","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"6×1 cubemap template"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Multiple layers are stacked on top of each other when using the default vertical import option (with the first layer at the top). Alternatively, you can choose an horizontal layout in the import options (with the first layer at the left).","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","type":"reference","isActive":true},{"text":" is not supported in the Compatibility renderer due to graphics API limitations.","type":"text"}]}],"type":"aside"}]}],"variants":[{"paths":["\/documentation\/swiftgodot\/cubemaparray"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"An array of "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","type":"reference","isActive":true},{"type":"text","text":"s, stored together and with a single reference."}],"metadata":{"modules":[{"name":"SwiftGodot"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CubemapArray"}],"symbol