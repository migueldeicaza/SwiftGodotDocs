{"kind":"symbol","abstract":[{"type":"text","text":"An array of "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","type":"reference"},{"text":"s, stored together and with a single reference.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"metadata":{"externalID":"s:10SwiftGodot12CubemapArrayC","modules":[{"name":"SwiftGodot"}],"symbolKind":"class","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CubemapArray"}],"title":"CubemapArray","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"CubemapArray"}],"roleHeading":"Class"},"relationshipsSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ImageTextureLayered"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"},{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible"]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CubemapArray"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"type":"text","text":"s are made of an array of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap"},{"text":"s. Like ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","type":"reference","isActive":true},{"type":"text","text":"s, they are made of multiple textures, the amount of which must be divisible by 6 (one for each face of the cube)."}],"type":"paragraph"},{"inlineContent":[{"text":"The primary benefit of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"type":"text","text":"s is that they can be accessed in shader code using a single texture reference. In other words, you can pass multiple "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","isActive":true},{"text":"s into a shader using a single ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"text":". ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","isActive":true},{"text":"s are allocated in adjacent cache regions on the GPU, which makes ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","isActive":true},{"type":"text","text":"s the most efficient way to store multiple "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","isActive":true},{"type":"text","text":"s."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Godot uses "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","isActive":true,"type":"reference"},{"type":"text","text":"s internally for many effects, including the "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sky","type":"reference"},{"text":" if you set ","type":"text"},{"code":"ProjectSettings\/rendering\/reflections\/skyReflections\/textureArrayReflections","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"To create such a texture file yourself, reimport your image files using the Godot Editor import presets. To create a CubemapArray from code, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ImageTextureLayered\/createFromImages(_:)"},{"text":" on an instance of the CubemapArray class.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The expected image order is X+, X-, Y+, Y-, Z+, Z- (in Godot’s coordinate system, so Y+ is “up” and Z- is “forward”). You can use one of the following templates as a base:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"2×3 cubemap template (default layout option)"}]}]},{"content":[{"inlineContent":[{"text":"3×2 cubemap template","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1×6 cubemap template"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"6×1 cubemap template"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiple layers are stacked on top of each other when using the default vertical import option (with the first layer at the top). Alternatively, you can choose an horizontal layout in the import options (with the first layer at the left)."}]},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray"},{"type":"text","text":" is not supported in the Compatibility renderer due to graphics API limitations."}],"type":"paragraph"}],"name":"Note","type":"aside"}]}],"topicSections":[{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray\/createPlaceholder()"],"anchor":"Instance-Methods"},{"anchor":"Type-Properties","generated":true,"ti