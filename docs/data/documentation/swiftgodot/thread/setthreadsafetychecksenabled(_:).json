{"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Thread\/setThreadSafetyChecksEnabled(_:)","interfaceLanguage":"swift"},"abstract":[{"text":"Sets whether the thread safety checks the engine normally performs in methods of certain classes (e.g., ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","type":"reference","isActive":true},{"text":") should happen ","type":"text"},{"inlineContent":[{"type":"text","text":"on the current thread"}],"type":"strong"},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setThreadSafetyChecksEnabled","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"enabled","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The default, for every thread, is that they are enabled (as if called with "},{"type":"codeVoice","code":"enabled"},{"type":"text","text":" being "},{"type":"codeVoice","code":"true"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"Those checks are conservative. That means that they will only succeed in considering a call thread-safe (and therefore allow it to happen) if the engine can guarantee such safety.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because of that, there may be cases where the user may want to disable them (","type":"text"},{"code":"enabled","type":"codeVoice"},{"text":" being ","type":"text"},{"code":"false","type":"codeVoice"},{"text":") to make certain operations allowed again. By doing so, it becomes the user’s responsibility to ensure thread safety (e.g., by using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mutex"},{"text":") for those objects that are otherwise protected by the engine.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"This is an advanced usage of the engine. You are advised to use it only if you know what you are doing and there is no safer way."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for scripts running on either arbitrary "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Thread"},{"type":"text","text":" objects or tasks submitted to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/WorkerThreadPool"},{"type":"text","text":". It doesn’t apply to code running during "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node"},{"type":"text","text":" group processing, where the checks will be always performed."}]}],"type":"aside","name":"Note"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Even in the case of having disabled the checks in a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/WorkerThreadPool","isActive":true},{"text":" task, there’s no need to re-enable them at the end. The engine will do so.","type":"text"}]}],"type":"aside","name":"Note"}]}],"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Thread"]]},"metadata":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setThreadSafetyChecksEnabled","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"setThreadSafetyChecksEnabled(_:)","roleHeading":"Type Method","externalID":"s:10SwiftGodot6ThreadC03setC19SafetyChecksEnabledyySbFZ","symbolKind":"method","modules":[{"name":"SwiftGodot"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/thread\/setthreadsafetychecksenabled(_:)"]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/Thread/setThreadSafetyChecksEnabled(_:)":{"role":"symbol","url":"\/documentation\/swiftgodot\/thread\/setthreadsafetychecksenabled(_:)","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Thread\/setThreadSafetyChecksEnabled(_:)","type":"topic","title":"setThreadSafetyChecksEnabled(_:)","abstract":[{"type":"text","text":"Sets whether the thread safety checks the engine normally performs in methods of certain classes (e.g., "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true},{"type":"text","text":") should happen "},{"type":"strong","inlineContent":[{"text":"on the current thread","type":"text"}]},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setThreadSafetyChecksEnabled","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Semaphore":{"url":"\/documentation\/swiftgodot\/semaphore","navigatorTitle":[{"text":"Semaphore","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Semaphore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Semaphore","kind":"