ocumentation\/SwiftGodot\/Semaphore","type":"reference"},{"type":"text","text":" for synchronization of multiple "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Thread","type":"reference"},{"type":"text","text":"s."}],"title":"Mutex","role":"symbol","url":"\/documentation\/swiftgodot\/mutex","navigatorTitle":[{"text":"Mutex","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mutex","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Mutex","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Node":{"kind":"symbol","abstract":[{"text":"Base class for all scene objects.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Node","kind":"identifier"}],"title":"Node","url":"\/documentation\/swiftgodot\/node","type":"topic","navigatorTitle":[{"text":"Node","kind":"identifier"}]}}}