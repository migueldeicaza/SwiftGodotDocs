{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ShaderGlobalsOverride"},"sections":[],"abstract":[{"type":"text","text":"A node used to override global shader parameters’ values in a scene."}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShaderGlobalsOverride"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar to how a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/WorldEnvironment"},{"type":"text","text":" node can be used to override the environment while a specific scene is loaded, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ShaderGlobalsOverride"},{"type":"text","text":" can be used to override global shader parameters temporarily. Once the node is removed, the project-wide values for the global shader parameters are restored. See the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer"},{"type":"text","text":" "},{"code":"global_shader_parameter_*","type":"codeVoice"},{"type":"text","text":" methods for more information."}]},{"content":[{"inlineContent":[{"type":"text","text":"Only one "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ShaderGlobalsOverride","type":"reference","isActive":true},{"type":"text","text":" can be used per scene. If there is more than one "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ShaderGlobalsOverride","type":"reference","isActive":true},{"type":"text","text":" node in the scene tree, only the first node (in tree order) will be ta