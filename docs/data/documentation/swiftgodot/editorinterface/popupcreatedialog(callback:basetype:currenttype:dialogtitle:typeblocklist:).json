{"abstract":[{"type":"text","text":"Pops up an editor dialog for creating an object."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInterface\/popupCreateDialog(callback:baseType:currentType:dialogTitle:typeBlocklist:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/swiftgodot\/editorinterface\/popupcreatedialog(callback:basetype:currenttype:dialogtitle:typeblocklist:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInterface"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"popupCreateDialog","kind":"identifier"},{"text":"(","kind":"text"},{"text":"callback","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Callable","kind":"typeIdentifier","preciseIdentifier":"s:17SwiftGodotRuntime8CallableC"},{"text":", ","kind":"text"},{"text":"baseType","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC","text":"StringName","kind":"typeIdentifier"},{"text":" = StringName (\"\"), ","kind":"text"},{"text":"currentType","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = \"\", ","kind":"text"},{"text":"dialogTitle","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" = \"\", ","kind":"text"},{"text":"typeBlocklist","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime10TypedArrayV","text":"TypedArray","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC","text":"StringName","kind":"typeIdentifier"},{"text":"> = TypedArray<StringName> ())","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"callback"},{"type":"text","text":" must take a single argument of type "},{"type":"codeVoice","code":"StringName"},{"type":"text","text":" which will contain the type name of the selected object or be empty if no item is selected."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"baseType"},{"text":" specifies the base type of objects to display. For example, if you set this to “Resource”, all types derived from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource"},{"text":" will display in the create dialog.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"currentType"},{"text":" will be passed in the search box of the create dialog, and the specified type can be immediately selected when the dialog pops up. If the ","type":"text"},{"type":"codeVoice","code":"currentType"},{"text":" is not derived from ","type":"text"},{"type":"codeVoice","code":"baseType"},{"text":", there will be no result of the type in the dialog.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"dialogTitle"},{"type":"text","text":" allows you to define a custom title for the dialog. This is useful if you want to accurately hint the usage of the dialog. If the "},{"type":"codeVoice","code":"dialogTitle"},{"type":"text","text":" is an empty string, the dialog will use “Create New ‘Base Type’” as the default title."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"typeBlocklist","type":"codeVoice"},{"text":" contains a list of type names, and the types in the blocklist will be hidden from the create dialog.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Trying to list the base type in the ","type":"text"},{"code":"typeBlocklist","type":"codeVoice"},{"text":" will hide all types derived from the base type from the create dialog.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}]}],"metadata":{"role":"symbol","title":"popupCreateDialog(callback:baseType:currentType:dialogTitle:typeBlocklist:)","externalID":"s:10SwiftGodot15EditorInterfaceC17popupCreateDialog8callback8baseType07currentJ011dialogTitle13typeBlocklisty0aB7Runtime8CallableC_AJ10StringNameCS2SAJ10TypedArrayVyANGtF","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"popupCreateDialog"},{"kind":"text","text":"("},{"kind":"externalParam","text":"callback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftGodotRuntime8CallableC","text":"Callable"},{"kind":"text","text":", "},{"kind":"externalParam","text":"baseType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC","text":"StringName"},{"kind":"text","text":", "},{"kind":"externalParam","text":"currentType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"dialogTitle"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"typeBlocklist"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftGodotRuntime10TypedArrayV","text":"TypedArray"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC","text":"StringName"},{"ki