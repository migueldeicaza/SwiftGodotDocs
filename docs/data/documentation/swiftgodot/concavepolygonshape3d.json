{"sections":[],"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D\/backfaceCollision","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D\/data"]},{"anchor":"Type-Properties","title":"Type Properties","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D\/godotClassName"]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"metadata":{"title":"ConcavePolygonShape3D","externalID":"s:10SwiftGodot21ConcavePolygonShape3DC","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConcavePolygonShape3D","kind":"identifier"}],"modules":[{"name":"SwiftGodot"}],"symbolKind":"class","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"ConcavePolygonShape3D"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConcavePolygonShape3D","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A 3D trimesh shape, intended for use in physics. Usually used to provide a shape for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CollisionShape3D"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Being just a collection of interconnected triangles, "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D","type":"reference","isActive":true},{"type":"text","text":" is the most freely configurable single 3D shape. It can be used to form polyhedra of any nature, or even shapes that don’t enclose a volume. However, "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D","type":"reference","isActive":true},{"type":"text","text":" is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"hollow"}]},{"type":"text","text":" even if the interconnected triangles do enclose a volume, which often makes it unsuitable for physics or detection."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"When used for collision, ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D","isActive":true},{"text":" is intended to work with static ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CollisionShape3D","isActive":true},{"text":" nodes like ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/StaticBody3D","isActive":true},{"text":" and will likely not behave well for ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CharacterBody3D","isActive":true},{"text":"s or ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RigidBody3D","isActive":true},{"text":"s in a mode other than Static.","type":"text"}]}],"type":"aside"},{"style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Physics bodies that are small have a chance to clip through this shape when moving fast. This happens because on one frame, the physics body may be on the “outside” of the shape, and on the next frame it may be “inside” it. "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D","isActive":true,"type":"reference"},{"type":"text","text":" is hollow, so it won’t detect a collision."}]}],"type":"aside"},{"inlineContent":[{"inlineContent":[{"text":"Performance:","type":"text"}],"type":"strong"},{"text":" Due to its complexity, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D"},{"text":" is the slowest 3D collision shape to check collisions against. Its use should generally be limited to level geometry. For convex geometry, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConvexPolygonShape3D"},{"text":" should be used. For dynamic physics bodies that need concave collision, several ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConvexPolygonShape3D"},{"text":"s can be used to represent its collision by using convex decomposition; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConvexPolygonShape3D"},{"text":"’s documentation for instructions.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"A 3D trimesh shape used for physics collision."}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Shape3D"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"},{"identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/concavepolygonshape3d"]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/CharacterBody3D":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CharacterBody3D","url":"\/documentation\/swiftgodot\/characterbody3d","abstract":[{"text":"A 3D physics body specialized for characters moved by script.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"CharacterBody3D"}],"type":"topic","title":"CharacterBody3D","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CharacterBody3D"}]},"doc://SwiftGodot/documentation/SwiftGodot/ConcavePolygonShape3D":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D","navigatorTitle":[{"kind":"identifier","text":"ConcavePolygonShape3D"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcavePolygonShape3D"}],"title":"ConcavePolygonShape3D","role":"symbol","abstract":[{"type":"text","text":"A 3D trimesh shape used for physics collision."}],"type":"topic","url":"\/documentation\/swiftgodot\/concavepolygonshape3d","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/StaticBody3D":{"type":"topic","role":"symbol","url":"\/documentation\/swiftgodot\/staticbody3d","abstract":[{"text":"A 3D physics body that can’t be moved by external forces. When moved manually, it doesn’t affect other bodies in its path.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StaticBody3D","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/StaticBody3D","navigatorTitle":[{"text":"StaticBody3D","kind":"identifier"}],"title":"StaticBody3D","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/ConcavePolygonShape3D/godotClassName":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ConcavePolygonShape3D\/godotClassName","url":"\/documentation\/swiftgodot\/concavepolygonshape3d\/godotclassname","role":"symbol","abstract":[],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"godotClassName","kind":"identifie