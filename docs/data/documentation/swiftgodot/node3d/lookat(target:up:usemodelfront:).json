{"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D\/lookAt(target:up:useModelFront:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Rotates the node so that the local forward axis (-Z, "},{"type":"codeVoice","code":"Vector3\/forward"},{"type":"text","text":") points toward the "},{"type":"codeVoice","code":"target"},{"type":"text","text":" position."}],"metadata":{"title":"lookAt(target:up:useModelFront:)","modules":[{"name":"SwiftGodot"}],"roleHeading":"Instance Method","externalID":"s:10SwiftGodot6Node3DC6lookAt6target2up13useModelFronty0aB7Runtime7Vector3V_AJSbtF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lookAt"},{"kind":"text","text":"("},{"kind":"externalParam","text":"target"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiftGodotRuntime7Vector3V","kind":"typeIdentifier","text":"Vector3"},{"kind":"text","text":", "},{"kind":"externalParam","text":"up"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiftGodotRuntime7Vector3V","kind":"typeIdentifier","text":"Vector3"},{"kind":"text","text":", "},{"kind":"externalParam","text":"useModelFront"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")"}],"symbolKind":"method","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookAt","kind":"identifier"},{"text":"(","kind":"text"},{"text":"target","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime7Vector3V","text":"Vector3","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"up","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime7Vector3V","text":"Vector3","kind":"typeIdentifier"},{"text":" = Vector3 (x: 0, y: 1, z: 0), ","kind":"text"},{"text":"useModelFront","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" = false)","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The local up axis (+Y) points as close to the ","type":"text"},{"type":"codeVoice","code":"up"},{"text":" vector as possible while staying perpendicular to the local forward axis. The resulting transform is orthogonal, and the scale is preserved. Non-uniform scaling may not work correctly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" position cannot be the same as the node’s position, the ","type":"text"},{"code":"up","type":"codeVoice"},{"text":" vector cannot be zero.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"target","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"up","type":"codeVoice"},{"text":" cannot be ","type":"text"},{"code":"Vector3\/zero","type":"codeVoice"},{"text":", and shouldn’t be colinear to avoid unintended rotation around local Z axis.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Operations take place in global space, which means that the node must be in the scene tree.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"useModelFront","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", the +Z axis (asset front) is treated as forward (implies +X is left) and points toward the "},{"code":"target","type":"codeVoice"},{"type":"text","text":" position. By de