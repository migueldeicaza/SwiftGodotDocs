doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector"},"abstract":[{"type":"text","text":"A control used to edit properties of an object."}],"variants":[{"paths":["\/documentation\/swiftgodot\/editorinspector"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ScrollContainer"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"},{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"EditorInspector","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"This is the control that implements property editing in the editor’s Settings dialogs, the Inspector dock, etc. To get the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector","type":"reference","isActive":true},{"text":" used in the editor’s Inspector dock, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInterface\/getInspector()","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector","type":"reference"},{"text":" will show properties in the same order as the array returned by ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/getPropertyList()","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If a property’s name is path-like (i.e. if it contains forward slashes), "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector","isActive":true,"type":"reference"},{"text":" will create nested sections for “directories” along the path. For example, if a property is named ","type":"text"},{"type":"codeVoice","code":"highlighting\/gdscript\/node_path_color"},{"type":"text","text":", it will be shown as “Node Path Color” inside the “GDScript” section nested inside the “Highlighting” section."}],"type":"paragraph"},{"inlineContent":[{"text":"If a property has ","type":"text"},{"type":"codeVoice","code":"PropertyUsageFlags\/propertyUsageGroup"},{"type":"text","text":" usage, it will group subsequent properties whose name starts with the property’s hint string. The group ends when a property does not start with that hint string or when a new group starts. An empty group name effectively ends the current group. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector"},{"text":" will create a top-level section for each group. For example, if a property with group usage is named ","type":"text"},{"code":"Collide With","type":"codeVoice"},{"text":" and its hint string is ","type":"text"},{"code":"collide_with_","type":"codeVoice"},{"text":", a subsequent ","type":"text"},{"code":"collide_with_area","type":"codeVoice"},{"type":"text","text":" property will be shown as “Area” inside the “Collide With” section. There is also a special case: when the hint string contains the name of a property, that property is grouped too. This is mainly to help grouping properties like "},{"code":"font","type":"codeVoice"},{"type":"text","text":", "},{"code":"font_color","type":"codeVoice"},{"type":"text","text":" and "},{"code":"font_size","type":"codeVoice"},{"text":" (using the hint string ","type":"text"},{"type":"codeVoice","code":"font_"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If a property has "},{"type":"codeVoice","code":"PropertyUsageFlags\/propertyUsageSubgroup"},{"text":" usage, a subgroup will be created in the same way as a group, and a second-level section will be created for each subgroup.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Unlike sections created from path-like property names, "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector","type":"reference","isActive":true},{"type":"text","text":" won’t capitalize the name for sections created from groups. So properties with group usage usually use capitalized names instead of snake_cased names."}],"type":"paragraph"}],"name":"Note","style":"note"},{"inlineContent":[{"type":"text","text":"This object emits the following signals:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector\/propertySelected","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector\/propertyKeyed"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector\/propertyDeleted","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector\/resourceSelected"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorInspector\/objectIdSelected","isActive":true}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/do