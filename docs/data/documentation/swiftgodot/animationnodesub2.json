{"abstract":[{"type":"text","text":"Blends two animations subtractively inside of an "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationNodeBlendTree","type":"reference"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationNodeSync"]},{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"]}],"kind":"symbol","topicSections":[{"anchor":"Type-Properties","generated":true,"title":"Type Properties","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationNodeSub2\/godotClassName"]}],"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"AnimationNodeSub2"}],"externalID":"s:10SwiftGodot17AnimationNodeSub2C","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnimationNodeSub2"}],"roleHeading":"Class","title":"AnimationNodeSub2","symbolKind":"class","modules":[{"name":"SwiftGodot"}],"role":"symbol"},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationNodeSub2","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnimationNodeSub2","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"A resource to add to an "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationNodeBlendTree","isActive":true},{"type":"