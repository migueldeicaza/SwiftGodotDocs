gDeviceC9DrawFlagsV","kind":"typeIdentifier"},{"text":" = [], ","kind":"text"},{"text":"clearColorValues","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PackedColorArray","preciseIdentifier":"s:17SwiftGodotRuntime16PackedColorArrayC","kind":"typeIdentifier"},{"text":" = PackedColorArray(), ","kind":"text"},{"text":"clearDepthValue","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":" = 1.0, ","kind":"text"},{"text":"clearStencilValue","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6UInt32V","text":"UInt32","kind":"typeIdentifier"},{"text":" = 0, ","kind":"text"},{"text":"region","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Rect2","preciseIdentifier":"s:17SwiftGodotRuntime5Rect2V"},{"kind":"text","text":" = Rect2 (x: 0, y: 0, width: 0, height: 0), "},{"kind":"externalParam","text":"breadcrumb"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt32","preciseIdentifier":"s:s6UInt32V"},{"kind":"text","text":" = 0) -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Multiple draw lists cannot be created at the same time; you must finish the previous draw list first using "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingDevice\/drawListEnd()","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"A simple drawing operation might look like this (code is not a complete example):","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"code":"drawFlags","type":"codeVoice"},{"type":"text","text":" indicates if the texture attachments of the framebuffer should be cleared or ignored. Only one of the two flags can be used for each individual attachment. Ignoring an attachment means that any contents that existed before the draw list will be completely discarded, reducing the memory bandwidth used by the render pass but producing garbage results if the pixels aren’t replaced. The default behavior allows the engine to figure out the right operation to use if the texture is discardable, which can result in increased performance. See "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RDTextureFormat","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingDevice\/textureSetDiscardable(texture:discardable:)","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"breadcrumb"},{"type":"text","text":" parameter can be an arbitrary 32-bit integer that is useful to diagnose GPU crashes. If Godot is built in dev or debug mode; when the GPU crashes Godot will dump all shaders that were being executed at the time of the crash and the breadcrumb is useful to diagnose what passes did those shaders belong to."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It does not affect rendering behavior and can be set to 0. It is recommended to use "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingDevice\/BreadcrumbMarker","isActive":true},{"type":"text","text":" enumerations for consistency but it’s not required. It is also possible to use bitwise operations to add extra data. e.g."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/RDTextureFormat":{"url":"\/documentation\/swiftgodot\/rdtextureformat","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RDTextureFormat"}],"kind":"symbol","type":"topic","role":"symbol","title":"RDTextureFormat"