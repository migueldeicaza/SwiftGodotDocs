{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/signals"]}],"abstract":[{"type":"text","text":"Signals in Godot are used by objects to post interesting events that are"},{"type":"text","text":" "},{"type":"text","text":"taking place, and can be used by users to easily add behavior and react"},{"type":"text","text":" "},{"type":"text","text":"to changes."}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Articles-and-Tutorials","title":"Articles and Tutorials","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RemoteProcedureCalls","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Documentation"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Objects in Godot can emit signals, these are notification about certain"},{"type":"text","text":" "},{"type":"text","text":"events taking place in the objects that can be observed externally."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In SwiftGodot, there is a convenient interface to connect to a signal, as well"},{"type":"text","text":" "},{"type":"text","text":"as a low-level framework to manually connect to signals and a mechanism to"},{"type":"text","text":" "},{"type":"text","text":"define your own signals."}],"type":"paragraph"},{"inlineContent":[{"text":"Objects that emit signals typically do so by using the ","type":"text"},{"type":"codeVoice","code":"Object\/emit(signal:)"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"method (or the lower-level ","type":"text"},{"type":"codeVoice","code":"Object\/emitSignal(signal:_:)"},{"text":" ","type":"text"},{"text":"function) which takes as a parameter the ","type":"text"},{"type":"codeVoice","code":"StringName"},{"text":" of the signal as well","type":"text"},{"text":" ","type":"text"},{"text":"as an optional list of additional arguments.   And users can connect to those","type":"text"},{"text":" ","type":"text"},{"text":"signals and direct a method to be invoked when they are raised.","type":"text"}],"type":"paragraph"},{"text":"Using Signals","anchor":"Using-Signals","level":2,"type":"heading"},{"inlineContent":[{"text":"To connect to a signal, find the signal that you want to connect to in your","type":"text"},{"text":" ","type":"text"},{"text":"type, and then call the connect method on it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, to connect to the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ready","isActive":true},{"type":"text","text":" signal, you call its connect"},{"type":"text","text":" "},{"type":"text","text":"method, like this:"}],"type":"paragraph"},{"syntax":"swift","code":["func setupBot(robot: Node) {","    robot.ready.connect {","        print(\"The robot's node is ready\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Since signals in Godot can include parameters, each signal in Godot"},{"type":"text","text":" "},{"type":"text","text":"surfaces a connect method that takes as an argument a function with the"},{"type":"text","text":" "},{"type":"text","text":"precise signature that it will be invoked with."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you want to stop receiving notifications, you can disconnect from the"},{"type":"text","text":" "},{"type":"text","text":"object, to do so, you must keep around the token returned by the connect"},{"type":"text","text":" "},{"type":"text","text":"method, like this:"}],"type":"paragraph"},{"syntax":"swift","code":["class Demo: Node {","    var readyToken: Callable","","    func setup() {","        readyToken = robot.ready.connect {","            print(\"Ready\")","        }","    }","","    func teardown() {","        robot.ready.disconnect(readyToken)","    }","}"],"type":"codeListing"},{"text":"Declaring your own Signals","anchor":"Declaring-your-own-Signals","level":2,"type":"heading"},{"inlineContent":[{"text":"It is also possible to define your own signals to broadcast them, both","type":"text"},{"text":" ","type":"text"},{"text":"to other Swift component as well as using them in Godot or from the","type":"text"},{"text":" ","type":"text"},{"text":"Godot Scripting language.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Signals belong to your class, so you need to declare those once per class,","type":"text"},{"text":" ","type":"text"},{"text":"and then every instance of your class can emit them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Signals can have zero or more parameters, and you will need to declare","type":"text"},{"text":" ","type":"text"},{"text":"the parameters that your signal consumes, any potential return values (these","type":"text"},{"text":" ","type":"text"},{"text":"are quite unusual, but the API supports it), and the name of your signal.","type":"text"}],"type":"paragraph"},{"text":"Signals with no parameters","anchor":"Signals-with-no-parameters","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The following example shows how to declare a a signal named "},{"type":"codeVoice","code":"burp"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"is emitted by your code:"}],"type":"paragraph"},{"syntax":"swift","code":["@Godot","class Demo: Node3D {","    @Signal var burp: SimpleSignal","}"],"type":"codeListing"},{"inlineContent":[{"text":"The free-standing macro ","type":"text"},{"code":"@Signal","type":"codeVoice"},{"text":" declares a signal named burp. This macro","type":"text"},{"text":" ","type":"text"},{"text":"will turn signal variable names using the camel-case naming convention into","type":"text"},{"text":" ","type":"text"},{"text":"Godot signals using snake-case.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"So for example if you were to declare a signal called ‘livesChanged’ it","type":"text"},{"text":" ","type":"text"},{"text":"would be exposed to Godot as ‘lives_changed’, and to your Swift code as","type":"text"},{"text":" ","type":"text"},{"text":"‘livesChanged’.","type":"text"}],"type":"paragraph"},{"text":"Signals with parameters","anchor":"Signals-with-parameters","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Signals can carry additional information when they are emitted, and"},{"type":"text","text":" "},{"type":"text","text":"you can pass any type that can be encoded as a Godot Variant to them"},{"type":"text","text":" "},{"type":"text","text":"(this includes Swift core types like integers, doubles, strings, but"},{"type":"text","text":" "},{"type":"text","text":"also Godot objects and the Godot core types;   See the documentation"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"codeVoice","code":"Variant"},{"type":"text","text":" for more information)."}],"type":"paragraph"},{"inlineContent":[{"text":"To use signals with parameters, you need to declare the parameter","type":"text"},{"text":" ","type":"text"},{"text":"types using the generic SignalWithArguments class, specifying the Swift","type":"text"},{"text":" ","type":"text"},{"text":"type of each parameter.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following example we create a signal exposed to godot called"},{"type":"text","text":" "},{"type":"codeVoice","code":"lives_changed"},{"type":"text","text":" that takes an integer value, and it is surfaced to"},{"type":"text","text":" "},{"type":"text","text":"Swift as the signal ‘livesChanged’."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The example below also shows how to emit the signal with the additional"},{"type":"text","text":" "},{"type":"text","text":"integer payload:"}],"type":"paragraph"},{"syntax":"swift","code":["@Godot ","class Player: Node2D {","    @Signal var livesChanged: SignalWithArguments<Int>","","    func startGame() {","        livesChanged.emit(5)","    }","}"],"type":"codeListing"},{"text":"Connecting Everything Together","anchor":"Connecting-Everything-Together","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This example shows how you can create a signal and connect to it:"}],"type":"paragraph"},{"syntax":"swift","code":["@Godot ","class Player: Node2D {","    @Signal var gameStarted: SimpleSignal","    @Signal var livesChanged: SignalWithArguments<Int>","","    func startGame() {","        \/\/ No arguments","        gameStarted.emit()","","        \/\/ One argument of type int","        livesChanged.emit(5)","    }","}","","class Level: Area2D {","    func _ready() { ","        player.gameStarted.connect {","            GD.print(\"got game started signal!\")","        }","","        player.livesChanged.connect { newLivesCount in","            print (\"New lives: \\(newLivesCount)\")","        }","    }","}"],"type":"codeListing"},{"text":"Low-Level Signal API","anchor":"Low-Level-Signal-API","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This section is here for explanation purposes, but you should not need"},{"type":"text","text":" "},{"type":"text","text":"to use this in your Godot code with Swift."}],"type":"paragraph"},{"text":"Using the low-level Signal framework","anchor":"Using-the-low-level-Signal-framework","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"While SwiftGodot provides a convenient way of connecting to objects,"},{"type":"text","text":" "},{"type":"text","text":"if you need to connect to objects that are not included in the binding"},{"type":"text","text":" "},{"type":"text","text":"or you want to implement additional semantics, you can always use the"},{"type":"text","text":" "},{"type":"text","text":"low-level API for connecting signals."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To connect a signal directly, you use the "},{"type":"codeVoice","code":"Object\/connect(signal:callable:flags:)"},{"type":"text","text":" "},{"type":"text","text":"method.   The first parameter is the "},{"type":"codeVoice","code":"StringName"},{"type":"text","text":" describing the signal"},{"type":"text","text":" "},{"type":"text","text":"and the second one is refenrece to the method to invoke.  The "},{"type":"codeVoice","code":"Callable"},{"type":"text","text":" "},{"type":"text","text":"is a pair of the object instance and the "},{"type":"codeVoice","code":"StringName"},{"type":"text","text":" of the method to invoke."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example:"}],"type":"paragraph"},{"syntax":"swift","code":["let callable = Callable(object: self, method: StringName (\"MyCallback\"))","object.connect(signal: \"some_signal\", callable)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This would call a method registered with Godot under the name "},{"type":"codeVoice","code":"MyCallback"},{"type":"text","text":" "},{"type":"text","text":"on the provided instance when the "},{"type":"codeVoice","code":"object"},{"type":"text","text":" raises the "},{"type":"codeVoice","code":"some_signal"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To surface a Swift method to Godot, and thus be able to reference it with"},{"type":"text","text":" "},{"type":"text","text":"a StringName, you would use a similar method to register a signal:"}],"type":"paragraph"},{"syntax":"swift","code":["func mySwiftCallback () {","   print (\"MyCallback has been invoked!\")","}","","func setup () {","    classInfo.registerMethod(","        name: \"MyCallback\", ","        flags: .default, ","        returnValue: nil, ","        arguments: [], ","        function: Demo.mySwiftCallback)","}"],"type":"codeListing"},{"text":"Emitting Signals","anchor":"Emitting-Signals","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"To emit a signal defined with the @Signal macro, you call ``SignalWithArguments\/emit()`"},{"type":"text","text":" "},{"type":"text","text":"on the signal’s property. If the signal takes arguments, the emit() method"},{"type":"text","text":" "},{"type":"text","text":"will accept arguments of the correct types."}],"type":"paragraph"},{"inlineContent":[{"text":"You can also use this method to emit built-in signals on a foreign object,","type":"text"},{"text":" ","type":"text"},{"text":"such as the ","type":"text"},{"type":"codeVoice","code":"ready"},{"text":" signal on a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true},{"text":" instance, to pretend the object","type":"text"},{"text":" ","type":"text"},{"text":"triggered that signal.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"I will not pass any judgement on this, I merely want to empower you to get the"},{"type":"text","text":" "},{"type":"text","text":"job done."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","sections":[],"metadata":{"modules":[{"name":"SwiftGodot"}],"role":"article","roleHeading":"Article","title":"Signals"},"references":{"doc://SwiftGodot/documentation/SwiftGodot/RunningInEditor":{"type":"topic","title":"Running Code in the Godot Editor","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","abstract":[{"text":"There are cases where you might want some of your Swift code for your extension","type":"text"},{"text":" ","type":"text"},{"text":"to run while it is being used in the Godot Editor.","type":"text"}],"kind":"article","url":"\/documentation\/swiftgodot\/runningineditor","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/CustomTypes":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","url":"\/documentation\/swiftgodot\/customtypes","title":"Using Custom Types","kind":"article","role":"article","abstract":[{"text":"You will typically extend the functionality of your Godot game by creating","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"classes that derive from one of the various Godot types and adjust the"},{"type":"text","text":" "},{"type":"text","text":"behavior accordingly."}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/RemoteProcedureCalls":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RemoteProcedureCalls","url":"\/documentation\/swiftgodot\/remoteprocedurecalls","title":"Remote Procedure Calls","kind":"article","role":"article","abstract":[{"text":"Use the ","type":"text"},{"code":"@Rpc","type":"codeVoice"},{"text":" macro to configure methods for Godot’s multiplayer RPC system.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/MemoryManagement":{"url":"\/documentation\/swiftgodot\/memorymanagement","kind":"article","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","abstract":[{"type":"text","text":"SwiftGodot surfaces various Godot types into the Swift universe in various ways:"}],"title":"Memory Management in SwiftGodot","type":"topic","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Differences":{"type":"topic","url":"\/documentation\/swiftgodot\/differences","kind":"article","title":"SwiftGodot API differences to GDScript","role":"article","abstract":[{"type":"text","text":"This document lists some common differences between GDSscript and SwiftGodot."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences"},"doc://SwiftGodot/documentation/SwiftGodot/Node/_ready()":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_ready()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"_ready"},{"kind":"text","text":"()"}],"title":"_ready()","kind":"symbol","type":"topic","url":"\/documentation\/swiftgodot\/node\/_ready()","abstract":[{"text":"Called when the node is “ready”, i.e. when both the node and its children have entered the scene tree. If the node has children, their ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_ready()","isActive":true},{"text":" callbacks get triggered first, and the parent node will receive the ready notification afterwards.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Documentation":{"type":"topic","url":"\/documentation\/swiftgodot\/documentation","kind":"article","title":"Documenting your Godot Extension","abstract":[{"type":"text","text":"If you are developing a Godot extension that is intended to be consumed from"},{"type":"text","text":" "},{"type":"text","text":"Godot you might want to provide documentation for it."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Documentation","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/TypesTranslation":{"url":"\/documentation\/swiftgodot\/typestranslation","kind":"article","type":"topic","title":"Types Translation","role":"article","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","abstract":[{"type":"text","text":"This document contains information on how type translation happens between Swift and Godot."}]},"doc://SwiftGodot/documentation/SwiftGodot/Node/ready":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ready","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SimpleSignal","preciseIdentifier":"s:17SwiftGodotRuntime12SimpleSignala","kind":"typeIdentifier"}],"abstract":[{"text":"Emitted when the node is considered ready, after ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_ready()","isActive":true},{"text":" is called.","type":"text"}],"url":"\/documentation\/swiftgodot\/node\/ready","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ready","title":"ready","kind":"symbol","type":"topic","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/BindingNodes":{"role":"article","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","kind":"article","title":"Referencing Nodes from your Scene","abstract":[{"text":"You will find yourself referencing nodes from a scene in your code. In","type":"text"},{"text":" ","type":"text"},{"text":"GDScript, that is usually achieved by using the dollar sign and the name of the","type":"text"},{"text":" ","type":"text"},{"text":"object you want to reference.","type":"text"}],"url":"\/documentation\/swiftgodot\/bindingnodes"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/Variants":{"url":"\/documentation\/swiftgodot\/variants","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","kind":"article","role":"article","type":"topic","title":"Variants","abstract":[{"text":"Follow up on the fundamental building block of Godot’s data types.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Node":{"kind":"symbol","abstract":[{"text":"Base class for all scene objects.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Node","kind":"identifier"}],"title":"Node","url":"\/documentation\/swiftgodot\/node","type":"topic","navigatorTitle":[{"text":"Node","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/Exports":{"kind":"article","abstract":[{"type":"text","text":"In Godot, class members can be exported. This means their value gets saved along"},{"type":"text","text":" "},{"type":"text","text":"with the resource (such as the scene) they’re attached to. They will also be"},{"type":"text","text":" "},{"type":"text","text":"available for editing in the property editor. Exporting is done by using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Export"},{"type":"text","text":" annotation."}],"url":"\/documentation\/swiftgodot\/exports","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","type":"topic","title":"Exports","role":"article"}}}