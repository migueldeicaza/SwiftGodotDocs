{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/signals"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation"],"anchor":"Articles-and-Tutorials","title":"Articles and Tutorials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals"},"sections":[],"metadata":{"modules":[{"name":"SwiftGodot"}],"role":"article","roleHeading":"Article","title":"Signals"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"abstract":[{"text":"Signals in Godot are used by objects to post interesting events that are","type":"text"},{"text":" ","type":"text"},{"text":"taking place, and can be used by users to easily add behavior and react","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to changes."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Objects in Godot can emit signals, these are notification about certain","type":"text"},{"type":"text","text":" "},{"type":"text","text":"events taking place in the objects that can be observed externally."}]},{"inlineContent":[{"text":"In SwiftGodot, there is a convenient interface to connect to a signal, as well","type":"text"},{"text":" ","type":"text"},{"text":"as a low-level framework to manually connect to signals and a mechanism to","type":"text"},{"type":"text","text":" "},{"text":"define your own signals.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Objects that emit signals typically do so by using the ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/emit(signal:)","type":"reference","isActive":true},{"text":"","type":"text"},{"type":"text","text":" "},{"type":"text","text":"method (or the lower-level "},{"type":"codeVoice","code":"Object\/emitSignal(signal:_:)"},{"type":"text","text":" "},{"text":"function) which takes as a parameter the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/StringName","isActive":true},{"text":" of the signal as well","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as an optional list of additional arguments.   And users can connect to those"},{"text":" ","type":"text"},{"type":"text","text":"signals and direct a method to be invoked when they are raised."}]},{"level":2,"text":"Using Signals","type":"heading","anchor":"Using-Signals"},{"inlineContent":[{"type":"text","text":"To connect to a signal, find the signal that you want to connect to in your"},{"text":" ","type":"text"},{"type":"text","text":"type, and then call the connect method on it."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, to connect to the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ready","type":"reference","isActive":true},{"text":" signal, you call its connect","type":"text"},{"type":"text","text":" "},{"text":"method, like this:","type":"text"}]},{"code":["func setupBot(robot: Node) {","    robot.ready.connect {","        print(\"The robot's node is ready\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Since signals in Godot can include parameters, each signal in Godot","type":"text"},{"type":"text","text":" "},{"text":"surfaces a connect method that takes as an argument a function with the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"precise signature that it will be invoked with."}]},{"type":"paragraph","inlineContent":[{"text":"If you want to stop receiving notifications, you can disconnect from the","type":"text"},{"type":"text","text":" "},{"text":"object, to do so, you must keep around the token returned by the connect","type":"text"},{"type":"text","text":" "},{"text":"method, like this:","type":"text"}]},{"syntax":"swift","code":["class Demo: Node {","    var readyToken: Callable","","    func setup() {","        readyToken = robot.ready.connect {","            print(\"Ready\")","        }","    }","","    func teardown() {","        robot.ready.disconnect(readyToken)","    }","}"],"type":"codeListing"},{"level":2,"text":"Declaring your own Signals","anchor":"Declaring-your-own-Signals","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"It is also possible to define your own signals to broadcast them, both","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to other Swift component as well as using them in Godot or from the"},{"text":" ","type":"text"},{"type":"text","text":"Godot Scripting language."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Signals belong to your class, so you need to declare those once per class,"},{"type":"text","text":" "},{"text":"and then every instance of your class can emit them.","type":"text"}]},{"inlineContent":[{"text":"Signals can have zero or more parameters, and you will need to declare","type":"text"},{"text":" ","type":"text"},{"text":"the parameters that your signal consumes, any potential return values (these","type":"text"},{"type":"text","text":" "},{"type":"text","text":"are quite unusual, but the API supports it), and the name of your signal."}],"type":"paragraph"},{"anchor":"Signals-with-no-parameters","text":"Signals with no parameters","level":3,"type":"heading"},{"inlineContent":[{"text":"The following example shows how to declare a a signal named ","type":"text"},{"code":"burp","type":"codeVoice"},{"text":" that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"is emitted by your code:"}],"type":"paragraph"},{"code":["@Godot","class Demo: Node3D {","    @Signal var burp: SimpleSignal","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The free-standing macro ","type":"text"},{"code":"@Signal","type":"codeVoice"},{"text":" declares a signal named burp. This macro","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will turn signal variable names using the camel-case naming convention into"},{"type":"text","text":" "},{"type":"text","text":"Godot signals using snake-case."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So for example if you were to declare a signal called ‘livesChanged’ it"},{"text":" ","type":"text"},{"type":"text","text":"would be exposed to Godot as ‘lives_changed’, and to your Swift code as"},{"type":"text","text":" "},{"text":"‘livesChanged’.","type":"text"}]},{"level":3,"text":"Signals with parameters","type":"heading","anchor":"Signals-with-parameters"},{"inlineContent":[{"type":"text","text":"Signals can carry additional information when they are emitted, and"},{"type":"text","text":" "},{"text":"you can pass any type that can be encoded as a Godot Variant to them","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(this includes Swift core types like integers, doubles, strings, but"},{"text":" ","type":"text"},{"text":"also Godot objects and the Godot core types;   See the documentation","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","isActive":true},{"type":"text","text":" for more information)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To use signals with parameters, you need to declare the parameter"},{"text":" ","type":"text"},{"type":"text","text":"types using the generic SignalWithArguments class, specifying the Swift"},{"type":"text","text":" "},{"text":"type of each parameter.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the following example we create a signal exposed to godot called"},{"type":"text","text":" "},{"code":"lives_changed","type":"codeVoice"},{"type":"text","text":" that takes an integer value, and it is surfaced to"},{"type":"text","text":" "},{"type":"text","text":"Swift as the signal ‘livesChanged’."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The example below also shows how to emit the signal with the additional"},{"text":" ","type":"text"},{"text":"integer payload:","type":"text"}]},{"type":"codeListing","code":["@Godot ","class Player: Node2D {","    @Signal var livesChanged: SignalWithArguments<Int>","","    func startGame() {","        livesChanged.emit(5)","    }","}"],"syntax":"swift"},{"type":"heading","text":"Connecting Everything Together","level":2,"anchor":"Connecting-Everything-Together"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example shows how you can create a signal and connect to it:"}]},{"syntax":"swift","type":"codeListing","code":["@Godot ","class Player: Node2D {","    @Signal var gameStarted: SimpleSignal","    @Signal var livesChanged: SignalWithArguments<Int>","","    func startGame() {","        \/\/ No arguments","        gameStarted.emit()","","        \/\/ One argument of type int","        livesChanged.emit(5)","    }","}","","class Level: Area2D {","    func _ready() { ","        player.gameStarted.connect {","            GD.print(\"got game started signal!\")","        }","","        player.livesChanged.connect { newLivesCount in","            print (\"New lives: \\(newLivesCount)\")","        }","    }","}"]},{"type":"heading","level":2,"text":"Low-Level Signal API","anchor":"Low-Level-Signal-API"},{"inlineContent":[{"text":"This section is here for explanation purposes, but you should not need","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to use this in your Godot code with Swift."}],"type":"paragraph"},{"text":"Using the low-level Signal framework","anchor":"Using-the-low-level-Signal-framework","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"While SwiftGodot provides a convenient way of connecting to objects,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"if you need to connect to objects that are not included in the binding"},{"type":"text","text":" "},{"type":"text","text":"or you want to implement additional semantics, you can always use the"},{"type":"text","text":" "},{"type":"text","text":"low-level API for connecting signals."}]},{"inlineContent":[{"text":"To connect a signal directly, you use the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/connect(signal:callable:flags:)"},{"type":"text","text":" "},{"type":"text","text":"method.   The first parameter is the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/StringName","isActive":true},{"text":" describing the signal","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and the second one is refenrece to the method to invoke.  The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Callable"},{"type":"text","text":" "},{"text":"is a pair of the object instance and the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/StringName","isActive":true},{"text":" of the method to invoke.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For example:","type":"text"}]},{"code":["let callable = Callable(object: self, method: StringName (\"MyCallback\"))","object.connect(signal: \"some_signal\", callable)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This would call a method registered with Godot under the name "},{"type":"codeVoice","code":"MyCallback"},{"type":"text","text":" "},{"text":"on the provided instance when the ","type":"text"},{"type":"codeVoice","code":"object"},{"type":"text","text":" raises the "},{"type":"codeVoice","code":"some_signal"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"To surface a Swift method to Godot, and thus be able to reference it with","type":"text"},{"type":"text","text":" "},{"text":"a StringName, you would use a similar method to register a signal:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func mySwiftCallback () {","   print (\"MyCallback has been invoked!\")","}","","func setup () {","    classInfo.registerMethod(","        name: \"MyCallback\", ","        flags: .default, ","        returnValue: nil, ","        arguments: [], ","        function: Demo.mySwiftCallback)","}"]},{"text":"Emitting Signals","anchor":"Emitting-Signals","type":"heading","level":2},{"inlineContent":[{"text":"To emit a signal defined with the @Signal macro, you call ``SignalWithArguments\/emit()`","type":"text"},{"text":" ","type":"text"},{"text":"on the signal’s property. If the signal takes arguments, the emit() method","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"will accept arguments of the correct types."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also use this method to emit built-in signals on a foreign object,"},{"type":"text","text":" "},{"type":"text","text":"such as the "},{"code":"ready","type":"codeVoice"},{"type":"text","text":" signal on a "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true,"type":"reference"},{"text":" instance, to pretend the object","type":"text"},{"type":"text","text":" "},{"type":"text","text":"triggered that signal."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"I will not pass any judgement on this, I merely want to empower you to get the","type":"text"},{"type":"text","text":" "},{"text":"job done.","type":"text"}]}],"kind":"content"}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/Exports":{"kind":"article","type":"topic","title":"Exports","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","url":"\/documentation\/swiftgodot\/exports","role":"article","abstract":[{"type":"text","text":"In Godot, class members can be exported. This means their value gets saved along"},{"type":"text","text":" "},{"text":"with the resource (such as the scene) they’re attached to. They will also be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"available for editing in the property editor. Exporting is done by using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Export"},{"text":" annotation.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Node":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Node","kind":"identifier"}],"kind":"symbol","title":"Node","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","navigatorTitle":[{"text":"Node","kind":"identifier"}],"abstract":[{"type":"text","text":"Base class for all scene objects."}],"role":"symbol","type":"topic","url":"\/documentation\/swiftgodot\/node"},"doc://SwiftGodot/documentation/SwiftGodot/Object/connect(signal:callable:flags:)":{"kind":"symbol","role":"symbol","title":"connect(signal:callable:flags:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"connect","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"signal"},{"text":": ","kind":"text"},{"text":"StringName","preciseIdentifier":"s:10SwiftGodot10StringNameC","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"callable"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot8CallableC","text":"Callable","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"flags","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V","text":"UInt32"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot0B5ErrorO","text":"GodotError","kind":"typeIdentifier"}],"abstract":[{"text":"Connects a ","type":"text"},{"type":"codeVoice","code":"signal"},{"text":" by name to a ","type":"text"},{"type":"codeVoice","code":"callable"},{"type":"text","text":". Optional "},{"code":"flags","type":"codeVoice"},{"type":"text","text":" can be also added to configure the connection’s behavior (see "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/ConnectFlags","isActive":true},{"type":"text","text":" constants)."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/connect(signal:callable:flags:)","url":"\/documentation\/swiftgodot\/object\/connect(signal:callable:flags:)","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/BindingNodes":{"abstract":[{"type":"text","text":"You will find yourself referencing nodes from a scene in your code. In"},{"type":"text","text":" "},{"text":"GDScript, that is usually achieved by using the dollar sign and the name of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"object you want to reference."}],"kind":"article","url":"\/documentation\/swiftgodot\/bindingnodes","type":"topic","title":"Referencing Nodes from your Scene","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Variants":{"abstract":[{"type":"text","text":"Follow up on the fundamental building block of Godot’s data types."}],"kind":"article","url":"\/documentation\/swiftgodot\/variants","type":"topic","title":"Variants","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Node/ready":{"title":"ready","role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/swiftgodot\/node\/ready","abstract":[{"type":"text","text":"Emitted when the node is considered ready, after "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_ready()","isActive":true},{"type":"text","text":" is called."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ready","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"SimpleSignal","preciseIdentifier":"s:10SwiftGodot12SimpleSignala"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ready"},"doc://SwiftGodot/documentation/SwiftGodot/TypesTranslation":{"url":"\/documentation\/swiftgodot\/typestranslation","title":"Types Translation","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","abstract":[{"text":"This document contains information on how type translation happens between Swift and Godot.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://SwiftGodot/documentation/SwiftGodot/RunningInEditor":{"kind":"article","type":"topic","title":"Running Code in the Godot Editor","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","url":"\/documentation\/swiftgodot\/runningineditor","role":"article","abstract":[{"type":"text","text":"There are cases where you might want some of your Swift code for your extension"},{"type":"text","text":" "},{"text":"to run while it is being used in the Godot Editor.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Object/ConnectFlags":{"title":"Object.ConnectFlags","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ConnectFlags"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/ConnectFlags","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ConnectFlags"}],"abstract":[],"url":"\/documentation\/swiftgodot\/object\/connectflags"},"doc://SwiftGodot/documentation/SwiftGodot/MemoryManagement":{"kind":"article","type":"topic","title":"Memory Management in SwiftGodot","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","url":"\/documentation\/swiftgodot\/memorymanagement","role":"article","abstract":[{"type":"text","text":"SwiftGodot surfaces various Godot types into the Swift universe in various ways:"}]},"doc://SwiftGodot/documentation/SwiftGodot/Differences":{"kind":"article","type":"topic","title":"SwiftGodot API differences to GDScript","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","url":"\/documentation\/swiftgodot\/differences","role":"article","abstract":[{"type":"text","text":"This document lists some common differences between GDSscript and SwiftGodot."}]},"doc://SwiftGodot/documentation/SwiftGodot/Node/_ready()":{"role":"symbol","url":"\/documentation\/swiftgodot\/node\/_ready()","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"_ready","kind":"identifier"},{"kind":"text","text":"()"}],"abstract":[{"type":"text","text":"Called when the node is “ready”, i.e. when both the node and its children have entered the scene tree. If the node has children, their "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_ready()","isActive":true},{"type":"text","text":" callbacks get triggered first, and the parent node will receive the ready notification afterwards."}],"title":"_ready()","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_ready()"},"doc://SwiftGodot/documentation/SwiftGodot/Variant":{"abstract":[{"type":"text","text":"Variant objects box various Godot Objects, you create them with one of the"},{"type":"text","text":" "},{"type":"text","text":"constructors, and you can retrieve the contents using the various extension"},{"type":"text","text":" "},{"type":"text","text":"constructors that are declared on the various types that are wrapped."}],"url":"\/documentation\/swiftgodot\/variant","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Variant"}],"navigatorTitle":[{"kind":"identifier","text":"Variant"}],"type":"topic","title":"Variant"},"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Callable":{"navigatorTitle":[{"text":"Callable","kind":"identifier"}],"role":"symbol","title":"Callable","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Callable","kind":"symbol","abstract":[{"text":"A built-in type representing a method or a standalone function.","type":"text"}],"url":"\/documentation\/swiftgodot\/callable","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Callable"}]},"doc://SwiftGodot/documentation/SwiftGodot/CustomTypes":{"kind":"article","type":"topic","title":"Using Custom Types","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","url":"\/documentation\/swiftgodot\/customtypes","role":"article","abstract":[{"type":"text","text":"You will typically extend the functionality of your Godot game by creating"},{"type":"text","text":" "},{"text":"classes that derive from one of the various Godot types and adjust the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"behavior accordingly."}]},"doc://SwiftGodot/documentation/SwiftGodot/Object/emit(signal:)":{"role":"symbol","url":"\/documentation\/swiftgodot\/object\/emit(signal:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"emit"},{"text":"(","kind":"text"},{"text":"signal","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10SwiftGodot21SignalWithNoArgumentsV","kind":"typeIdentifier","text":"SignalWithNoArguments"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot0B5ErrorO","kind":"typeIdentifier","text":"GodotError"}],"type":"topic","title":"emit(signal:)","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/emit(signal:)","abstract":[{"text":"Emits a signal that was previously defined with the #signal macro.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/StringName":{"type":"topic","navigatorTitle":[{"text":"StringName","kind":"identifier"}],"abstract":[{"type":"text","text":"A built-in type for unique strings."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"StringName","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/StringName","role":"symbol","url":"\/documentation\/swiftgodot\/stringname","title":"StringName","kind":"symbol"}}}