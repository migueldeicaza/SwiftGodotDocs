{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Returns the absolute directory path where user data is written (the "},{"code":"user:\/\/","type":"codeVoice"},{"type":"text","text":" directory in Godot). The path depends on the project name and "},{"code":"ProjectSettings\/application\/config\/useCustomUserDir","type":"codeVoice"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OS\/getUserDataDir()"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OS"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getUserDataDir"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"On Windows, this is ","type":"text"},{"code":"%AppData%\\Godot\\app_userdata\\[project_name]","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"%AppData%\\[custom_name]","type":"codeVoice"},{"text":" if ","type":"text"},{"code":"use_custom_user_dir","type":"codeVoice"},{"text":" is set. ","type":"text"},{"code":"%AppData%","type":"codeVoice"},{"text":" expands to ","type":"text"},{"code":"%UserProfile%\\AppData\\Roaming","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"On macOS, this is ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/Godot\/app_userdata\/[project_name]"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/[custom_name]"},{"text":" if ","type":"text"},{"t