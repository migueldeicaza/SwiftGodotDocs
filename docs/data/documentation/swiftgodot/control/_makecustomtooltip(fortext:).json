{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/control\/_makecustomtooltip(fortext:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"type":"text","text":"Virtual method to be implemented by the user. Returns a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control"},{"type":"text","text":" node that should be used as a tooltip instead of the default one. "},{"type":"codeVoice","code":"forText"},{"type":"text","text":" is the return value of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getTooltip(atPosition:)"},{"type":"text","text":"."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"_makeCustomTooltip"},{"kind":"text","text":"("},{"kind":"externalParam","text":"forText"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftGodotRuntime6ObjectC","text":"Object"},{"kind":"text","text":"?"}],"title":"_makeCustomTooltip(forText:)","symbolKind":"method","modules":[{"name":"SwiftGodot"}],"externalID":"s:10SwiftGodot7ControlC18_makeCustomTooltip7forText0aB7Runtime6ObjectCSgSS_tF","roleHeading":"Instance Method","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/_makeCustomTooltip(forText:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"_makeCustomTooltip"},{"kind":"text","text":"("},{"kind":"externalParam","text":"forText"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Object","preciseIdentifier":"s:17SwiftGodotRuntime6ObjectC"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The returned node must be of type ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control","type":"reference"},{"text":" or Control-derived. It can have child nodes of any type. It is freed when the tooltip disappears, so make sure you always provide a new instance (if you want to use a pre-existing node from your scene tree, you can duplicate it and pass the duplicated instance). When ","type":"text"},{"code":"null","type":"codeVoice"},{"text":" or a non-Control node is returned, the default tooltip will be used instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The returned node will be added as child to a ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PopupPanel","isActive":true,"type":"reference"},{"text":", so you should only provide the contents of that panel. That ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PopupPanel","isActive":true,"type":"reference"},{"text":" can be themed using ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Theme\/setStylebox(name:themeType:texture:)","isActive":true,"type":"reference"},{"text":" for the type ","type":"text"},{"code":"\"TooltipPanel\"","type":"codeVoice"},{"text":" (see ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/tooltipText","isActive":true,"type":"reference"},{"text":" for an example).","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The tooltip is shrunk to minimal size. If you want to ensure it’s fully visible, you might want to set its ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/customMinimumSize","type":"reference","isActive":true},{"text":" to some non-zero value.","type":"text"}]}],"name":"Note","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"The node (and any relevant children) should have their "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem\/visible"},{"type":"text","text":" set to "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when returned, otherwise, the viewport that instantiates it will not be able to calculate its minimum size reliably."}],"type":"paragraph"}],"name":"Note","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If overridden, this method is called even if "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getTooltip(atPosition:)","isActive":true,"type":"reference"},{"type":"text","text":" returns an empty string. When this happens with the default tooltip, it is not displayed. To copy this behavior, return "},{"code":"null","type":"codeVoice"},{"type":"text","text":" in this method when "},{"code":"forText","type":"codeVoice"},{"type":"text","text":" is empty."}]}],"name":"Note","style":"note"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example:","type":"text"}]},{"text":" Use a constructed node as a tooltip:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Example:","type":"text"}],"type":"strong"},{"text":" Usa a scene instance as a tooltip:","type":"text"}]}]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/CanvasItem/isVisibleInTree()":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem\/isVisibleInTree()","title":"isVis