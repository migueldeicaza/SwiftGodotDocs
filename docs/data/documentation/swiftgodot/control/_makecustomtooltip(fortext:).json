odot\/Control","isActive":true},{"type":"text","text":" nodes have their internal minimum size returned by "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getMinimumSize()","isActive":true},{"type":"text","text":". It depends on the control’s contents, like text, textures, or style boxes. The actual minimum size is the maximum value of this property and the internal minimum size (see "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getCombinedMinimumSize()","isActive":true},{"type":"text","text":")."}],"kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/control\/customminimumsize","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customMinimumSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Vector2","preciseIdentifier":"s:17SwiftGodotRuntime7Vector2V","kind":"typeIdentifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/Control/getCombinedMinimumSize()":{"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getCombinedMinimumSize()","role":"symbol","title":"getCombinedMinimumSize()","url":"\/documentation\/swiftgodot\/control\/getcombinedminimumsize()","abstract":[{"type":"text","text":"Returns combined minimum size from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/customMinimumSize"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getMinimumSize()"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getCombinedMinimumSize"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Vector2","preciseIdentifier":"s:17SwiftGodotRuntime7Vector2V"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Control/mouseFilter-swift.property":{"abstract":[{"type":"text","text":"Controls whether the control will be able to receive mouse button input events through "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/_guiInput(event:)","isActive":true,"type":"reference"},{"type":"text","text":" and how these events should be handled. Also controls whether the control can receive the [signal mouse_entered], and [signal mouse_exited] signals. See the constants to learn what each does."}],"title":"mouseFilter","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mouseFilter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Control","preciseIdentifier":"s:10SwiftGodot7ControlC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"MouseFilter","preciseIdentifier":"s:10SwiftGodot7ControlC11MouseFilterO"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/mouseFilter-swift.property","url":"\/documentation\/swiftgodot\/control\/mousefilter-swift.property","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/CanvasItem/visible":{"abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", this "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem","type":"reference","isActive":true},{"type":"text","text":" may be drawn. Whether this "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem","type":"reference","isActive":true},{"type":"text","text":" is actually drawn depends on the visibility of all of its "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem","type":"reference","isActive":true},{"type":"text","text":" ancestors. In other words: this "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem","type":"reference","isActive":true},{"type":"text","text":" will be drawn when "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem\/isVisibleInTree()","isActive":true},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":" and all "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem","isActive":true},{"type":"text","text":" ancestors share at least one "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem\/visibilityLayer","isActive":true},{"type":"text","text":" with this "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem\/visible","url":"\/documentation\/swiftgodot\/canvasitem\/visible","title":"visible","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"visible","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://SwiftGodot/documentation/SwiftGodot/Control/getMinimumSize()":{"title":"getMinimumSize()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getMinimumSize"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Vector2","preciseIdentifier":"s:17SwiftGodotRuntime7Vector2V"}],"url":"\/documentation\/swiftgodot\/control\/getminimumsize()","abstract":[{"type":"text","text":"Returns the minimum size for this control. See "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/customMinimumSize","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getMinimumSize()","kind":"symbol","role":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Control/MouseFilter-swift.enum/ignore":{"abstract":[{"type":"text","text":"The control will not receive any mouse movement input events nor mouse button input events through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/_guiInput(event:)"},{"type":"text","text":". The control will also not receive the [signal mouse_entered] nor [signal mouse_exited] signals. This will not block other controls from receiving these events or firing the signals. Ignored events will not be handled automatically. If a child has "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/MouseFilter-swift.enum\/pass"},{"type":"text","text":" and an event was passed to this control, the event will further propagate up to the control’s parent."}],"kind":"symbol","url":"\/documentation\/swiftgodot\/control\/mousefilter-swift.enum\/ignore","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/MouseFilter-swift.enum\/ignore","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"ignore"}],"title":"Control.MouseFilter.ignore","type":"topic"}}}