ntrol\/customMinimumSize","isActive":true,"type":"reference"},{"type":"text","text":" to some non-zero value."}],"type":"paragraph"}],"style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The node (and any relevant children) should have their "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasItem\/visible","isActive":true},{"type":"text","text":" set to "},{"type":"codeVoice","code":"true"},{"text":" when returned, otherwise, the viewport that instantiates it will not be able to calculate its minimum size reliably.","type":"text"}]}],"name":"Note","type":"aside","style":"note"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If overridden, this method is called even if "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Control\/getTooltip(atPosition:)","isActive":true,"type":"reference"},{"text":" returns an empty string. When this happens with the default tooltip, it is not displayed. To copy this behavior, return ","type":"text"},{"type":"codeVoice","code":"null"},{"type":"text","text":" in this method when "},{"type":"codeVoice","code":"forText"},{"text":" is empty.","type":"text"}]}],"name":"Note"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example:"}],"type":"strong"},{"text":" Use a constructed node as a tooltip:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Example:"}]},{"text":" Usa a scene instance as a tooltip:","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/control\/_makecustomtooltip(fortext:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://SwiftGodot/documentation/SwiftGodot/PopupPanel":{"navigatorTitle":[{"kind":"identifier","text":"PopupPanel"}],"title":"PopupPanel","role":"symbol","abstract":[{"type":"text",