{"sections":[],"abstract":[{"text":"Use the ","type":"text"},{"code":"@Rpc","type":"codeVoice"},{"text":" macro to configure methods for Godot’s multiplayer RPC system.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/rpcConfig(method:config:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MultiplayerAPI\/RPCMode","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MultiplayerPeer\/TransferMode-swift.enum"]},{"anchor":"Articles-and-Tutorials","title":"Articles and Tutorials","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Documentation"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Remote Procedure Calls (RPC) allow you to call methods on other peers in a","type":"text"},{"text":" ","type":"text"},{"text":"multiplayer game. In Godot, RPC methods need to be configured with settings","type":"text"},{"text":" ","type":"text"},{"text":"that control who can call them and how they are transmitted over the network.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"SwiftGodot provides the "},{"type":"codeVoice","code":"@Rpc"},{"type":"text","text":" macro to declaratively configure RPC methods,"},{"type":"text","text":" "},{"type":"text","text":"similar to GDScript’s "},{"type":"codeVoice","code":"@rpc"},{"type":"text","text":" annotation. The configuration is automatically"},{"type":"text","text":" "},{"type":"text","text":"applied when your node enters the scene tree."}],"type":"paragraph"},{"level":2,"text":"Basic Usage","type":"heading","anchor":"Basic-Usage"},{"inlineContent":[{"text":"To mark a method for RPC, apply both the ","type":"text"},{"code":"@Callable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Rpc","type":"codeVoice"},{"text":" macros:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Godot","class Player: Node {","    @Callable @Rpc","    func takeDamage(_ amount: Int) {","        health -= amount","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"@Callable","type":"codeVoice"},{"text":" macro exposes the method to Godot, and ","type":"text"},{"code":"@Rpc","type":"codeVoice"},{"text":" configures it","type":"text"},{"text":" ","type":"text"},{"text":"for remote calls. With default settings, only the multiplayer authority","type":"text"},{"text":" ","type":"text"},{"text":"(typically the server) can call this method on other peers.","type":"text"}],"type":"paragraph"},{"level":2,"text":"RPC Parameters","type":"heading","anchor":"RPC-Parameters"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"@Rpc"},{"type":"text","text":" macro accepts several parameters to customize the RPC behavior:"}],"type":"paragraph"},{"level":3,"text":"mode","type":"heading","anchor":"mode"},{"inlineContent":[{"text":"Controls who is allowed to call this RPC method. Uses ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MultiplayerAPI\/RPCMode","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".authority"},{"type":"text","text":" (default): Only the multiplayer authority can call this method"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".anyPeer","type":"codeVoice"},{"text":": Any connected peer can call this method","type":"text"}]}]}],"type":"unorderedList"},{"code":["@Callable @Rpc(mode: .anyPeer)","func sendChatMessage(_ message: String) {","    displayMessage(message)","}"],"syntax":"swift","type":"codeListing"},{"anchor":"callLocal","text":"callLocal","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", the method is also called locally when you invoke the RPC."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["@Callable @Rpc(mode: .authority, callLocal: true)","func startGame() {","    \/\/ Called on all peers AND locally when the authority calls rpc(\"start_game\")","    initializeGame()","}"],"syntax":"swift","type":"codeListing"},{"anchor":"transferMode","text":"transferMode","type":"heading","level":3},{"inlineContent":[{"text":"Controls how the RPC packets are sent over the network.","type":"text"},{"text":" ","type":"text"},{"text":"Uses ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MultiplayerPeer\/TransferMode-swift.enum","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".unreliable","type":"codeVoice"},{"text":" (default): Packets may be lost or arrive out of order (fastest)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".unreliableOrdered","type":"codeVoice"},{"type":"text","text":": Packets may be lost but arrive in order"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".reliable"},{"text":": Packets are guaranteed to arrive in order (slowest)","type":"text"}]}]}],"type":"unorderedList"},{"code":["\/\/ Position updates can tolerate some packet loss","@Callable @Rpc(mode: .authority, transferMode: .unreliable)","func syncPosition(_ position: Vector3) {","    self.position = position","}","","\/\/ Game state changes must be reliable","@Callable @Rpc(mode: .authority, transferMode: .reliable)","func playerDied(_ playerId: Int) {","    handlePlayerDeath(playerId)","}"],"syntax":"swift","type":"codeListing"},{"anchor":"transferChannel","text":"transferChannel","type":"heading","level":3},{"inlineContent":[{"text":"Specifies the network channel for the RPC. Defaults to ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Different channels can be used to separate different types of traffic.","type":"text"}],"type":"paragraph"},{"code":["@Callable @Rpc(transferMode: .reliable, transferChannel: 1)","func importantGameEvent(_ eventId: Int) {","    processEvent(eventId)","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Complete Example","type":"heading","anchor":"Complete-Example"},{"inlineContent":[{"text":"Here’s a complete example showing various RPC configurations for a multiplayer game:","type":"text"}],"type":"paragraph"},{"code":["@Godot","class NetworkPlayer: CharacterBody3D {","    var health: Int = 100","","    \/\/ Anyone can request to shoot, server validates","    @Callable @Rpc(mode: .anyPeer, transferMode: .reliable)","    func requestShoot(_ direction: Vector3) {","        \/\/ Server-side validation","        if multiplayer.isServer() {","            performShoot(direction)","        }","    }","","    \/\/ Only server can sync position, unreliable is fine for frequent updates","    @Callable @Rpc(mode: .authority, transferMode: .unreliable)","    func syncPosition(_ pos: Vector3, _ rot: Vector3) {","        position = pos","        rotation = rot","    }","","    \/\/ Only server can deal damage, must be reliable","    @Callable @Rpc(mode: .authority, transferMode: .reliable, callLocal: true)","    func takeDamage(_ amount: Int) {","        health -= amount","        if health <= 0 {","            die()","        }","    }","","    \/\/ Chat messages from any peer, reliable delivery","    @Callable @Rpc(mode: .anyPeer, transferMode: .reliable)","    func sendChat(_ message: String) {","        displayChatMessage(message)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"How-It-Works","text":"How It Works","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"When you use the ","type":"text"},{"type":"codeVoice","code":"@Rpc"},{"text":" macro, the ","type":"text"},{"type":"codeVoice","code":"@Godot"},{"text":" macro automatically generates","type":"text"},{"text":" ","type":"text"},{"text":"code that configures the RPC settings for your methods. This happens in","type":"text"},{"text":" ","type":"text"},{"text":"a special ","type":"text"},{"type":"codeVoice","code":"_before_ready()"},{"text":" method that is called automatically before","type":"text"},{"text":" ","type":"text"},{"text":"your node’s ","type":"text"},{"type":"codeVoice","code":"_ready()"},{"text":" method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated code calls "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/rpcConfig(method:config:)"},{"type":"text","text":" for each"},{"type":"text","text":" "},{"code":"@Rpc","type":"codeVoice"},{"type":"text","text":"-marked method with a configuration dictionary containing:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"rpc_mode"},{"type":"text","text":": The RPC mode value"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"call_local"},{"type":"text","text":": Whether to call locally"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"transfer_mode","type":"codeVoice"},{"text":": The transfer mode value","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"channel"},{"type":"text","text":": The transfer channel"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"You don’t need to call anything manually - the RPC configuration is","type":"text"},{"text":" ","type":"text"},{"text":"applied automatically when your node enters the scene tree.","type":"text"}]},{"anchor":"Calling-RPC-Methods","text":"Calling RPC Methods","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once configured, you can call RPC methods using Godot’s standard RPC API:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Call on all peers","rpc(StringName(\"sync_position\"), Variant(newPosition))","","\/\/ Call on a specific peer","rpcId(peerId, StringName(\"take_damage\"), Variant(10))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that method names are converted to snake_case when exposed to Godot,"},{"type":"text","text":" "},{"type":"text","text":"so "},{"code":"syncPosition","type":"codeVoice"},{"type":"text","text":" becomes "},{"code":"sync_position","type":"codeVoice"},{"type":"text","text":" in RPC calls."}]},{"anchor":"Requirements","text":"Requirements","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"@Rpc"},{"type":"text","text":" macro can only be applied to functions"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Methods must also have the ","type":"text"},{"code":"@Callable","type":"codeVoice"},{"text":" macro to be exposed to Godot","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your class must inherit from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","type":"reference"},{"text":" (directly or indirectly) since","type":"text"},{"text":" ","type":"text"},{"text":"RPC is a Node feature","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your class must use the "},{"code":"@Godot","type":"codeVoice"},{"type":"text","text":" macro"}]}]}]}]}],"variants":[{"paths":["\/documentation\/swiftgodot\/remoteprocedurecalls"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RemoteProcedureCalls","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Remote Procedure Calls","role":"article","modules":[{"name":"SwiftGodot"}]},"kind":"article","references":{"doc://SwiftGodot/documentation/SwiftGodot/RunningInEditor":{"type":"topic","title":"Running Code in the Godot Editor","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","abstract":[{"text":"There are cases where you might want some of your Swift code for your extension","type":"text"},{"text":" ","type":"text"},{"text":"to run while it is being used in the Godot Editor.","type":"text"}],"kind":"article","url":"\/documentation\/swiftgodot\/runningineditor","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/MultiplayerAPI/RPCMode":{"url":"\/documentation\/swiftgodot\/multiplayerapi\/rpcmode","type":"topic","title":"MultiplayerAPI.RPCMode","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RPCMode","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MultiplayerAPI\/RPCMode","navigatorTitle":[{"text":"RPCMode","kind":"identifier"}],"kind":"symbol","abstract":[]},"doc://SwiftGodot/documentation/SwiftGodot/Differences":{"type":"topic","url":"\/documentation\/swiftgodot\/differences","kind":"article","title":"SwiftGodot API differences to GDScript","role":"article","abstract":[{"type":"text","text":"This document lists some common differenc