tancing.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultiMesh","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/Environment/sdfgiEnabled":{"role":"symbol","title":"sdfgiEnabled","kind":"symbol","type":"topic","abstract":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", enables signed distance field global illumination for meshes that have their "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/giMode-swift.property","isActive":true},{"text":" set to ``GeometryInstance3D\/GIMode\/`static```. SDFGI is a real-time global illumination technique that works well with procedurally generated and user-built levels, including in situations where geometry is created during gameplay. The signed distance field is automatically generated around the camera as it moves. Dynamic lights are supported, but dynamic occluders and emissive surfaces are not.","type":"text"}],"url":"\/documentation\/swiftgodot\/environment\/sdfgienabled","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/sdfgiEnabled","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"sdfgiEnabled"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://SwiftGodot/documentation/SwiftGodot/CameraAttributes":{"role":"symbol","url":"\/documentation\/swiftgodot\/cameraattributes","abstract":[{"type":"text","text":"Parent class for camera settings."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributes","type":"topic","title":"CameraAttributes","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CameraAttributes"}],"kind":"symbol","navigatorTitle":[{"text":"CameraAttributes","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/VoxelGI/cameraAttributes":{"