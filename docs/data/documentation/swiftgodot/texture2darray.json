{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Texture2DArray","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"A Texture2DArray is different from a Texture3D: The Texture2DArray does not support trilinear interpolation between the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Image","type":"reference"},{"text":"s, i.e. no blending. See also ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","type":"reference"},{"text":", which are texture arrays with specialized cubemap functions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A Texture2DArray is also different from an ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AtlasTexture","isActive":true,"type":"reference"},{"text":": In a Texture2DArray, all images are treated separately. In an atlas, the regions (i.e. the single images) can be of different sizes. Furthermore, you usually need to add a padding around the regions, to prevent accidental UV mapping to more than one region. The same goes for mipmapping: Mipmap chains are handled separately for each layer. In an atlas, the slicing has to be done manually in the fragment shader.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To create such a texture file yourself, reimport your image files using the Godot Editor import presets. To create a Texture2DArray from code, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ImageTextureLayered\/createFromImages(_:)","type":"reference"},{"text":" on an instance of the Texture2DArray class.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"topicSections":[{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2DArray\/createPlaceholder()"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2DArray\/godotClassName"],"generated":true}],"variants":[{"paths":["\/documentation\/swiftgodot\/texture2darray"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2DArray","interfaceLanguage":"swift"},"metadata":{"symbolKind":"class","externalID":"s:10SwiftGodot14Texture2DArrayC","modules":[{"name":"SwiftGodot"}],"role":"symbol","title":"Texture2DArray","roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Texture2DArray","kind":"identifier"}],"navigatorTitle":[{"text":"Texture2DArray","kind":"identifier"}]},"abstract":[{"text":"A single texture resource which consists of multiple, separate images. Each image has the same dimensions and number of mipmap levels.","type":"text"}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ImageTextureLayered"],"title":"Inherits From"},{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"],"title":"Conforms To"}],"sections":[],"references":{"doc://SwiftGodot/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/SQ"},"doc://SwiftGodot/documentation/Swi