{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditorSceneFormatImporterBlend"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Imports Blender scenes in the ","type":"text"},{"code":".blend","type":"codeVoice"},{"text":" file format through the glTF 2.0 3D import pipeline. This importer requires Blender to be installed by the user, so that it can be used to export the scene as glTF 2.0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The location of the Blender binary is set via the "},{"code":"filesystem\/import\/blender\/blender_path","type":"codeVoice"},{"type":"text","text":" editor setting."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This importer is only used if "},{"type":"codeVoice","code":"ProjectSettings\/filesystem\/import\/blender\/enabled"},{"type":"text","text":" is enabled, otherwise "},{"type":"codeVoice","code":".blend"},{"type":"text","text":" files present in the project folder are not imported."}]},{"type":"paragraph","inlineContent":[{"text":"Blend import requires Blender 3.0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Internally, the EditorSceneFormatImporterBlend uses the Blender glTF “Use Original” mode to reference external textures.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"Importer for Blender’s ","type":"text"},{"code":".blend","type":"codeVoice"},{"text":" scene file format.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftgodot\/editorsceneformatimporterblend"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorSceneFormatImporterBlend"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"meta