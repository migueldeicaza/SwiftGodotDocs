mapgi\/texelscale","title":"texelScale","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/texelScale","kind":"symbol","abstract":[{"type":"text","text":"Scales the lightmap texel density of all meshes for the current bake. This is a multiplier that builds upon the existing lightmap texel size defined in each imported 3D scene, along with the per-mesh density multiplier (which is designed to be used when the same mesh is used at different scales). Lower values will result in faster bake times."}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/quality":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/quality","role":"symbol","abstract":[{"type":"text","text":"The quality preset to use when baking lightmaps. This affects bake times, but output file sizes remain mostly identical across quality levels."}],"url":"\/documentation\/swiftgodot\/lightmapgi\/quality","title":"quality","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"quality","kind":"identifier"},{"text":": ","kind":"text"},{"text":"LightmapGI","preciseIdentifier":"s:10SwiftGodot10LightmapGIC","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"BakeQuality","preciseIdentifier":"s:10SwiftGodot10LightmapGIC11BakeQualityO","kind":"typeIdentifier"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/useDenoiser":{"url":"\/documentation\/swiftgodot\/lightmapgi\/usedenoiser","kind":"symbol","abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", uses a GPU-based denoising algorithm on the generated lightmap. This eliminates most noise within the generated lightmap at the cost of longer bake times. File sizes are generally not impacted significantly by the use of a denoiser, although lossless compression may do a better job at compressing a denoised image."}],"role":"symbol","title":"useDenoiser","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/useDenoiser","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"useDenoiser","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/supersampling":{"abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", lightmaps are baked with the texel scale multiplied with "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersamplingFactor","isActive":true},{"type":"text","text":" and downsampled before saving the lightmap (so the effective texel density is identical to having supersampling disabled)."}],"type":"topic","role":"symbol","url":"\/documentation\/swiftgodot\/lightmapgi\/supersampling","kind":"symbol","title":"supersampling","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"supersampling","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersampling"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","role":"symbol","title":"LightmapGI","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LightmapGI"}],"navigatorTitle":[{"kind":"identifier","text":"LightmapGI"}],"abstract":[{"text":"Computes and stores baked lightmaps for fast global illumination.","type":"text"}],"url":"\/documentation\/swiftgodot\/lightmapgi","kind":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/bounces":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bounces","title":"bounces","role":"symbol","url":"\/documentation\/swiftgodot\/lightmapgi\/bounces","abstr