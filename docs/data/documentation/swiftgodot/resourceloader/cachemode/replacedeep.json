{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceDeep","kind":"identifier"}],"title":"ResourceLoader.CacheMode.replaceDeep","role":"symbol","roleHeading":"Case","modules":[{"name":"SwiftGodot"}],"externalID":"s:10SwiftGodot14ResourceLoaderC9CacheModeO11replaceDeepyA2EmF"},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceDeep","kind":"identifier"}]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/swiftgodot\/resourceloader\/cachemode\/replacedeep"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Like ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode\/replace","isActive":true,"type":"reference"},{"text":", but propagated recursively down the tree of dependencies (external resources).","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode\/replaceDeep"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode"]]},"references":{"doc://SwiftGodot/documentation/SwiftGodot/ResourceLoader":{"type":"topic","navigatorTitle":[{"text":"ResourceLoader","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/resourceloader","abstract":[{"text":"A singleton for loading resource files.","type":"text"}],"title":"ResourceLoader","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceLoader","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/ResourceLoader/CacheMode/reuse":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"reuse"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode\/reuse","role":"symbol","type":"topic","abstract":[{"text":"The main resource (the one requested to be loaded), its subresources, and its dependencies (external resources) are retrieved from cache if present, instead of loaded. Those not cached are loaded and then stored into the cache. The same rules are propagated recursively down the tree of dependencies (external resources).","type":"text"}],"url":"\/documentation\/swiftgodot\/resourceloader\/cachemode\/reuse","title":"ResourceLoader.CacheMode.reuse","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/ResourceLoader/CacheMode":{"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode","abstract":[],"url":"\/documentation\/swiftgodot\/resourceloader\/cachemode","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CacheMode"}],"role":"symbol","title":"ResourceLoader.CacheMode","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CacheMode"}]},"doc://SwiftGodot/documentation/SwiftGodot/ResourceLoader/CacheMode/replace":{"abstract":[{"type":"text","text":"Like "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode\/reuse","type":"reference","isActive":true},{"type":"text","text":", but the cache is checked for the main resource (the one requested to be loaded) as well as for each of its subresources. Those already in the cache, as long as the loaded and cached types match, have their data refreshed from storage into the already existing instances. Otherwise, they are recreated as completely new objects."}],"title":"ResourceLoader.CacheMode.replace","type":"topic","url":"\/documentation\/swiftgodot\/resourceloader\/cachemode\/replace","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"replace"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode\/replace"},"doc://SwiftGodot/documentation/SwiftGodot/ResourceLoader/CacheMode/replaceDeep":{"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceDeep","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode\/replaceDeep","type":"topic","abstract":[{"type":"text","text":"Like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode\/replace"},{"type":"text","text":", but propagated recursively down the tree of dependencies (external resources)."}],"title":"ResourceLoader.CacheMode.replaceDeep","role":"symbol","url":"\/documentation\/swiftgodot\/resourceloader\/cachemode\/replacedeep"}}}