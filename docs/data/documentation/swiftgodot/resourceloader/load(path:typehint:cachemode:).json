rst one which can handle the file’s extension, and then attempt loading. If loading fails, the remaining ResourceFormatLoaders are also attempted."}]},{"inlineContent":[{"text":"An optional ","type":"text"},{"type":"codeVoice","code":"typeHint"},{"type":"text","text":" can be used to further specify the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource","isActive":true},{"type":"text","text":" type that should be handled by the "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceFormatLoader","type":"reference"},{"text":". Anything that inherits from ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource","isActive":true},{"text":" can be used as a type hint, for example ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Image","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"cacheMode","type":"codeVoice"},{"text":" property defines whether and how the cache should be used or updated when loading the resource. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader\/CacheMode"},{"type":"text","text":" for details."}]},{"inlineContent":[{"text":"Returns an empty resource if no ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceFormatLoader","type":"reference"},{"type":"text","text":" could handle the file, and prints an error if no file is found at the specified path."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"GDScript has a simplified "},{"type":"codeVoice","code":"@GDScript.load"},{"type":"text","text":" built-in method which can be used in most situations, leaving the use of "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ResourceLoader","isActive":true},{"text":" for more advanced scenarios.","type":"text"}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"ProjectSettings\/editor\/export\/convertTextResourcesToBinary"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", "},{"type":"codeVoice","code":"@GDScript.load"},{"type":"text","text":" will not be able to read converted files in an exported project. If you rely on run-time loading of files present within the PCK, set "},{"type":"codeVoice","code":"ProjectSettings\/editor\/export\/convertTextResourcesToBinary"},{"text":" to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Relative paths will be prefixed with "},{"type":"codeVoice","code":"\"res:\/\/\""},{"text":" before loading, to avoid unexpected results make sure your paths are absolute.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"metadata":{"symbolKind":"method","roleHeading":"Type Method","title":"load(path:typeHint:cacheMode:)","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"load","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"path"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"typeHint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"text":"cacheMode","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"ResourceLoader","preciseIdentifier":"s:10SwiftGodot14ResourceLoaderC"},{"kind":"text","text":"."},{"text":"CacheMode