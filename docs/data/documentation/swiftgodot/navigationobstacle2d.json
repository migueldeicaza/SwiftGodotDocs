":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle2D/carveNavigationMesh":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle2D\/carveNavigationMesh","kind":"symbol","title":"carveNavigationMesh","url":"\/documentation\/swiftgodot\/navigationobstacle2d\/carvenavigationmesh","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"carveNavigationMesh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"If enabled the obstacle vertices will carve into the baked navigation mesh with the shape unaffected by additional offsets (e.g. agent radius).","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle2D/getRid()":{"abstract":[{"type":"text","text":"Returns the "},{"type":"codeVoice","code":"RID"},{"type":"text","text":" of this obstacle on the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationServer2D","isActive":true},{"type":"text","text":"."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getRid"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"RID","preciseIdentifier":"s:17SwiftGodotRuntime3RIDC"}],"title":"getRid()","url":"\/documentation\/swiftgodot\/navigationobstacle2d\/getrid()","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle2D\/getRid()","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Node2D":{"abstract":[{"text":"A 2D game object, inherited by all 2D-related nodes. Has a position, rotation, scale, and skew.","type":"text"}],"url":"\/documentation\/swiftgodot\/node2d","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Node2D"}],"role":"symbol","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node2D","title":"Node2D