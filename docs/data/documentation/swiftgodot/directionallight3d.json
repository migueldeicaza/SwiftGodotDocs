on/SwiftGodot/DirectionalLight3D/directionalShadowSplit2":{"abstract":[{"text":"The distance from shadow split 1 to split 2. Relative to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","type":"reference"},{"text":". Only used when ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMode","type":"reference"},{"text":" is ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/ShadowMode\/parallel4Splits","type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/swiftgodot\/directionallight3d\/directionalshadowsplit2","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directionalShadowSplit2","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowSplit2","title":"directionalShadowSplit2","type":"topic","kind":"symbol"},"doc://SwiftGodot/SQ":{"identifier":"doc:\/\/SwiftGodot\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D/ShadowMode/orthogonal":{"type":"topic","url":"\/documentation\/swiftgodot\/directionallight3d\/shadowmode\/orthogonal","role":"symbol","kind":"symbol","title":"DirectionalLight3D.ShadowMode.orthogonal","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"orthogonal","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/ShadowMode\/orthogonal","abstract":[{"text":"Renders the entire scene’s shadow map from an orthogonal point of view. This is the fastest directional shadow mode. May result in blurrier shadows on close objects.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D/ShadowMode":{"abstract":[],"title":"DirectionalLight3D.ShadowMode","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/ShadowMode","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ShadowMode","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftgodot\/directionallight3d\/shadowmode","navigatorTitle":[{"kind":"identifier","text":"ShadowMode"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D/directionalShadowFadeStart":{"abstract":[{"type":"text","text":"Proportion of "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","isActive":true},{"type":"text","text":" at which point the shadow starts to fade. At "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","isActive":true},{"type":"text","text":", the shadow will disappear. The default value is a balance between smooth fading and distant shadow visibility. If the camera moves fast and the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","isActive":true},{"type":"text","text":" is low, consider lowering "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowFadeStart","isActive":true},{"type":"text","text":" below "},{"type":"codeVoice","code":"0.8"},{"type":"text","text":" to make shadow transitions less noticeable. On the other hand, if you tuned "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","isActive":true},{"type":"text","text":" to cover the entire scene, you can set "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowFadeStart","isActive":true},{"type":"text","text":" to "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" to prevent the shadow from fading in the distance (it will suddenly cut off instead)."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowFadeStart","role":"symbol","title":"directionalShadowFadeStart","type":"topic","url":"\/documentation\/swiftgodot\/directionallight3d\/directionalshadowfadestart","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directionalShadowFadeStart","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D/directionalShadowMaxDistance":{"kind":"symbol","type":"topic","title":"directionalShadowMaxDistance","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"directionalShadowMaxDistance"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The maximum distance for shadow splits. Increasing this value will make directional shadows visible from further away, at the cost of lower overall shadow detail and performance (since more objects need to be included in the directional shadow rendering)."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","url":"\/documentation\/swiftgodot\/directionallight3d\/directionalshadowmaxdistance"},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D/directionalShadowSplit1":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"directionalShadowSplit1","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"identifier":"doc:\/\/SwiftGodot\/documenta