mbol"},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D/directionalShadowMode":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/directionallight3d\/directionalshadowmode","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"directionalShadowMode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DirectionalLight3D","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot18DirectionalLight3DC"},{"text":".","kind":"text"},{"text":"ShadowMode","preciseIdentifier":"s:10SwiftGodot18DirectionalLight3DC10ShadowModeO","kind":"typeIdentifier"}],"abstract":[{"text":"The light’s shadow rendering algorithm. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/ShadowMode","type":"reference"},{"text":".","type":"text"}],"title":"directionalShadowMode","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMode"},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D/directionalShadowFadeStart":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"directionalShadowFadeStart"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowFadeStart","title":"directionalShadowFadeStart","url":"\/documentation\/swiftgodot\/directionallight3d\/directionalshadowfadestart","abstract":[{"type":"text","text":"Proportion of "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","isActive":true,"type":"reference"},{"type":"text","text":" at which point the shadow starts to fade. At "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance","isActive":true,"type":"refere