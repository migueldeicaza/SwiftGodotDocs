{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"fogAerialPerspective"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This is useful to simulate ","type":"text"},{"text":"aerial perspective","type":"text"},{"text":" in large scenes with low density fog. However, it is not very useful for high-density fog, as the sky will shine through. When set to ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":", the fog color comes completely from the ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sky","isActive":true,"type":"reference"},{"text":". If set to ","type":"text"},{"type":"codeVoice","code":"0.0"},{"type":"text","text":", aerial perspective is disabled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Notice that this does not sample the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sky"},{"type":"text","text":" directly, but rather the radiance cubemap. The cubemap is sampled at a mipmap level depending on the depth of the rendered pixel; the farther away, the higher the resolution of the sampled mipmap. This results in the actual color being a blurred version of the sky, with more blur closer to the camera. The highest mipmap resolution is used at a depth of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D\/far"},{"type":"text","text":"."}]}]}],"kind":"symbol","abstract":[{"text":"If set above ","type":"text"},{"type":"codeVoice","code":"0.0"},{"text":" (exclusive), blends between the fog’s color and the color of the background ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sky"},{"text":", as read from the radiance cubemap. This has a small performance cost when set above ","type":"text"},{"type":"codeVoice","code":"0.0"},{"text":". Must have ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/backgroundMode"},{"text":" set to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/BGMode\/sky"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/environment\/fogaerialperspective"]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/fogAerialPerspective","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment"]]},"metadata":{"symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"fogAerialPerspective"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"externalID":"s:10SwiftGodot11EnvironmentC20fogAerialPerspectiveSdvp","title":"fogAerialPerspective","role":"symbol","modules":[{"name":"SwiftGodot"}],"roleHeading":"Instance Property"},"references":{"doc://SwiftGodot/documentation/SwiftGodot/Environment/fogAerialPerspective":{"abstract":[{"type":"text","text":"If set above "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" (exclusive), blends between the fog’s color and the color of the background "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sky","type":"reference","isActive":true},{"type":"text","text":", as read from the radiance cubemap. This has a small performance cost when set above "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":". Must have "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/backgroundMode","type":"reference","isActive":true},{"type":"text","text":" set to "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/BGMode\/sky","type":"reference","isActive":true},{"type":"text","text":"."}],"title":"fogAerialPerspective","kind":"symbol","url":"\/documentation\/swiftgodot\/environment\/fogaerialperspective","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fogAerialPerspective","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/fogAerialPerspective"},"doc://SwiftGodot/documentation/SwiftGodot/Sky":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sky","type":"topic","navigatorTitle":[{"text":"Sky","kind":"identifier"}],"kind":"symbol","title":"Sky","abstract":[{"text":"Defines a 3D environment’s background by using a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Material"},{"text":".","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sky","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/sky","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"d