iftGodot\/documentation\/SwiftGodot\/Environment\/BGMode\/sky","type":"reference"},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"fogAerialPerspective","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"url":"\/documentation\/swiftgodot\/environment\/fogaerialperspective","kind":"symbol","title":"fogAerialPerspective","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Environment":{"url":"\/documentation\/swiftgodot\/environment","type":"topic","title":"Environment","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Environment"}],"abstract":[{"text":"Resource for environment nodes (like ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/WorldEnvironment","isActive":true,"type":"reference"},{"text":") that define multiple rendering options.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Environment"}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Environment/BGMode/sky":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"sky"}],"title":"Environment.BGMode.sky","abstract":[{"text":"Displays a user-defined sky in the background.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/BGMode\/sky","url":"\/documentation\/swiftgodot\/environment\/bgmode\/sky"},"doc://SwiftGodot/documentation/SwiftGodot/Environment/backgroundMode":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/backgroundMode","abstract":[{"text":"The background mode. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/BGMode","isActive