{"kind":"symbol","abstract":[{"type":"text","text":"The origin point in AR\/VR."}],"variants":[{"paths":["\/documentation\/swiftgodot\/xrorigin3d"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XROrigin3D"},"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XROrigin3D\/current","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XROrigin3D\/worldScale"]},{"anchor":"Type-Properties","title":"Type Properties","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XROrigin3D\/godotClassName"]}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D"]},{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"]}],"metadata":{"modules":[{"name":"SwiftGodot"}],"roleHeading":"Class","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"XROrigin3D"}],"navigatorTitle":[{"text":"XROrigin3D","kind":"identifier"}],"externalID":"s:10SwiftGodot10XROrigin3DC","title":"XROrigin3D","role":"symbol"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"XROrigin3D"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This is a special node within the AR\/VR system that maps the physical location of the center of our tracking space to the virtual location within our game world."}],"type":"paragraph"},{"inlineContent":[{"text":"Multiple origin points can be added to the scene tree, but only one can used at a time. All the ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XRCamera3D","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XRController3D","type":"reference","isActive":true},{"text":", and ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XRAnchor3D","type":"reference","isActive":true},{"text":" nodes should be direct children of this node for spatial tracking to work correctly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is the position of this node that you update when your character needs to move through your game world while we’re not moving in the real world. Movement in the real world is always in relation to this origin point.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, if your character is driving a car, the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/XROrigin3D"},{"type":"text","text":" node should be a child node of this car. Or, if you’re implementing a teleport system to move your character, you should change the position of this node."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/s12IdentifiableP":{"type":"unresolvable","identifier":"doc:\/\/Swift