{"kind":"symbol","abstract":[{"type":"text","text":"Controls the distance attenuation function for omnilights."}],"metadata":{"externalID":"s:10SwiftGodot11OmniLight3DC15omniAttenuationSdvp","modules":[{"name":"SwiftGodot"}],"title":"omniAttenuation","symbolKind":"property","role":"symbol","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"omniAttenuation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}]},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"omniAttenuation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"A value of "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" will maintain a constant brightness through most of the range, but smoothly attenuate the light at the edge of the range. Use a value of "},{"type":"codeVoice","code":"2.0"},{"type":"text","text":" for physically accurate lights as it results in the proper inverse square attenutation."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Setting attenuation to "},{"code":"2.0","type":"codeVoice"},{"type":"text","text":" or higher may result in distant objects receiving minimal light, even within range. For example, with a range of "},{"code":"4096","type":"codeVoice"},{"type":"text","text":", an object at "},{"code":"100","type":"codeVoice"},{"type":"text","text":" units is attenuated by a factor of "},{"code":"0.0001","type":"codeVoice"},{"type":"text","text":". With a default brightness of "},{"code":"1","type":"codeVoice"},{"type":"text","text":", the light would not be visible at that distance."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Using negative or values higher than ","type":"text"},{"type":"codeVoice","code":"10.0"},{"text":" may lead to unexpected results.","type":"text"}]}],"type":"aside","style":"note","name":"Note"}]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D\/omniAttenuation","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/omnilight3d\/omniattenuation"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://SwiftGodot/documentation/SwiftGodot/OmniLight3D":{"title":"OmniLight3D","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Omnidirectional light, such as a light bulb or a candle."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OmniLight3D"}],"url":"\/documentation\/swiftgodot\/omnilight3d","navigatorTitle":[{"kind":"identifier","text":"OmniLight3D"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D"},"doc://SwiftGodot/documentation/SwiftGodot/OmniLight3D/omniAttenuation":{"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D\/omniAttenuation","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"omniAttenuation","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"title":"omniAttenuation","abstract":[{"text":"Controls the distance attenuation function for omnilights.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiftgodot\/omnilight3d\/omniattenuation"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"}}}