{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Formats the string by replacing all occurrences of "},{"code":"placeholder","type":"codeVoice"},{"type":"text","text":" with the elements of "},{"type":"codeVoice","code":"values"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/gstring\/format(values:placeholder:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"format"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"values"},{"kind":"text","text":": "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant","text":"Variant","preciseIdentifier":"s:10SwiftGodot7VariantC","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"kind":"externalParam","text":"placeholder"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot7GStringC","kind":"typeIdentifier","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GString","text":"GString"},{"kind":"text","text":" = \"{_}\") -> "},{"preciseIdentifier":"s:10SwiftGodot7GStringC","text":"GString","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GString","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"values"},{"text":" can be a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantDictionary","isActive":true},{"type":"text","text":", an "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","isActive":true},{"type":"text","text":", or an "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","type":"reference"},{"text":". Any underscores in ","type":"text"},{"type":"codeVoice","code":"placeholder"},{"text":" will be replaced with the corresponding keys in advance. Array elements use their index as keys.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some additional handling is performed when "},{"type":"codeVoice","code":"values"},{"type":"text","text":" is an "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","isActive":true},{"type":"text","text":". If "},{"code":"placeholder","type":"codeVoice"},{"type":"text","text":" does not contain an underscore, the elements of the "},{"code":"values","type":"codeVoice"},{"text":" array will be used to replace one occurrence of the placeholder in order; If an element of ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" is another 2-element array, it’ll be interpreted as a key-value pair.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When passing an ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","isActive":true,"type":"reference"},{"text":", the property names from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object\/getPropertyList()"},{"type":"text","text":" are used as keys."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See also the "},{"type":"text","text":"GDScript format string"},{"type":"text","text":" tutorial."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each replacement is done sequentially for each element of "},{"code":"values","type":"codeVoice"},{"type":"text","text":", "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" all at once. This means that if any element is inserted and it contains another placeholder, it may be changed by the next replacement. While this can be very usefu