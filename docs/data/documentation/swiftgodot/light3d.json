directEnergy"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/shadowNormalBias":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowNormalBias","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"shadowNormalBias"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"url":"\/documentation\/swiftgodot\/light3d\/shadownormalbias","abstract":[{"text":"Offsets the lookup into the shadow map by the object’s normal. This can be used to reduce self-shadowing artifacts without using ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBias","type":"reference","isActive":true},{"text":". In practice, this value should be tweaked along with ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBias","type":"reference","isActive":true},{"text":" to reduce artifacts as much as possible.","type":"text"}],"title":"shadowNormalBias","type":"topic","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/distanceFadeLength":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"distanceFadeLength","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"kind":"symbol","title":"distanceFadeLength","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/distanceFadeLength","abstract":[{"text":"Distance over which the light and its shadow fades. The light’s energy and shadow’s opacity is progressively reduced over this distance and is completely invisible at the end.","type":"text"}],"url":"\/documentation\/swiftgodot\/light3d\/distancefadelength","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/BakeMode":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BakeMode","kind":"identifier"}],"id