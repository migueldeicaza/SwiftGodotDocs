tGodot\/documentation\/SwiftGodot\/Light3D\/lightIntensityLux","title":"lightIntensityLux","url":"\/documentation\/swiftgodot\/light3d\/lightintensitylux","abstract":[{"type":"text","text":"Used by "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D","type":"reference","isActive":true},{"text":"s when ","type":"text"},{"code":"ProjectSettings\/rendering\/lightsAndShadows\/usePhysicalLightUnits","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". Sets the intensity of the light source measured in Lux. Lux is a measure of luminous flux per unit area, it is equal to one lumen per square meter. Lux is the measure of how much light hits a surface at a given time."}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightAngularDistance":{"role":"symbol","abstract":[{"type":"text","text":"The light’s angular size in degrees. Increasing this will make shadows softer at greater distances (also called percentage-closer soft shadows, or PCSS). Only available for "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D","type":"reference","isActive":true},{"type":"text","text":"s. For reference, the Sun from the Earth is approximately "},{"type":"codeVoice","code":"0.5"},{"text":". Increasing this value above ","type":"text"},{"type":"codeVoice","code":"0.0"},{"text":" for lights with shadows enabled will have a noticeable performance cost due to PCSS.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightAngularDistance","title":"lightAngularDistance","url":"\/documentation\/swiftgodot\/light3d\/lightangulardistance","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"lightAngularDistance"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}]},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightSize":{"kind":"symbol","type":"topic","title":"lightSize","url":"\/documentation\/swiftgodot\/light3d\/lightsize","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"lightSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightSize","role":"symbol","abstract":[{"type":"text","text":"The size of the light in Godot units. Only available for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D"},{"type":"text","text":"s and "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D","isActive":true},{"text":"s. Increasing this value will make the light fade out slower and shadows appear blurrier (also called percentage-closer soft shadows, or PCSS). This can be used to simulate area lights to an extent. Increasing this value above ","type":"text"},{"type":"codeVoice","code":"0.0"},{"text":" for lights with shadows enabled will have a noticeable performance cost due to PCSS.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/shadowOpacity":{"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowOpacity","url":"\/documentation\/swiftgodot\/light3d\/shadowopacity","abstract":[{"type":"text","text":"The opacity to use when rendering the light’s shadow map. Values lower than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" make the light appear through shadows. This can be used to fake global illumination at a low performance cost."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"shadowOpacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"title":"shadowOpacity","kind":"symbol"},"doc://SwiftGodot/documentat