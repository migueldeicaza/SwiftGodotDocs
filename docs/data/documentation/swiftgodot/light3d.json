2D"}],"url":"\/documentation\/swiftgodot\/texture2d","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2D","type":"topic","kind":"symbol","title":"Texture2D","role":"symbol"},"doc://SwiftGodot/s12IdentifiableP":{"type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/s12IdentifiableP","title":"Swift.Identifiable"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/distanceFadeEnabled":{"role":"symbol","title":"distanceFadeEnabled","url":"\/documentation\/swiftgodot\/light3d\/distancefadeenabled","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"distanceFadeEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":", the light will smoothly fade away when far from the active "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D","isActive":true},{"text":" starting at ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/distanceFadeBegin","isActive":true,"type":"reference"},{"type":"text","text":". This acts as a form of level of detail (LOD). The light will fade out over "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/distanceFadeBegin"},{"text":" + ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/distanceFadeLength","type":"reference"},{"type":"text","text":", after which it will be culled and not sent to the shader at all. Use this to reduce the number of active lights in a scene and thus improve performance."}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/distanceFadeEnabled"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightEnergy":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/li