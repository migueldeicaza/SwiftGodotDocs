ght3D/shadowBlur":{"kind":"symbol","abstract":[{"type":"text","text":"Blurs the edges of the shadow. Can be used to hide pixel artifacts in low-resolution shadow maps. A high value can impact performance, make shadows appear grainy and can cause other unwanted artifacts. Try to keep as near default as possible."}],"url":"\/documentation\/swiftgodot\/light3d\/shadowblur","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"shadowBlur","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"role":"symbol","title":"shadowBlur","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBlur"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightNegative":{"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"lightNegative"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", the light’s effect is reversed, darkening areas and casting bright shadows."}],"type":"topic","url":"\/documentation\/swiftgodot\/light3d\/lightnegative","title":"lightNegative","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightNegative","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/getCorrelatedColor()":{"url":"\/documentation\/swiftgodot\/light3d\/getcorrelatedcolor()","kind":"symbol","abstract":[{"text":"Returns the ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Color","type":"reference","isActive":true},{"text":" of an idealized blackbody at the given ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightTemperature","isActive":true,"type":"reference"},{"text":". This value is calculated internally based on the ","type":"text"},{"type":"reference","id