{"text":")","kind":"text"}],"symbolKind":"method"},"abstract":[{"type":"text","text":"Creates a new surface. "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/getSurfaceCount()","isActive":true},{"type":"text","text":" will become the "},{"code":"surf_idx","type":"codeVoice"},{"text":" for this new surface.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/arraymesh\/addsurfacefromarrays(primitive:arrays:blendshapes:lods:flags:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addSurfaceFromArrays"},{"text":"(","kind":"text"},{"text":"primitive","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Mesh","kind":"typeIdentifier","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh","preciseIdentifier":"s:10SwiftGodot4MeshC"},{"kind":"text","text":"."},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/PrimitiveType","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot4MeshC13PrimitiveTypeO","text":"PrimitiveType"},{"text":", ","kind":"text"},{"text":"arrays","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10SwiftGodot12VariantArrayC","kind":"typeIdentifier","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","text":"VariantArray"},{"kind":"text","text":", "},{"kind":"externalParam","text":"blendShapes"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypedArray","text":"TypedArray","preciseIdentifier":"s:10SwiftGodot10TypedArrayV"},{"text":"<","kind":"text"},{"text":"VariantArray","preciseIdentifier":"s:10SwiftGodot12VariantArrayC","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","kind":"typeIdentifier"},{"text":"> = TypedArray<VariantArray> (), ","kind":"text"},{"kind":"externalParam","text":"lods"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot17VariantDictionaryC","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantDictionary","text":"VariantDictionary"},{"text":" = VariantDictionary (), ","kind":"text"},{"kind":"externalParam","text":"flags"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot4MeshC","text":"Mesh","kind":"typeIdentifier","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh"},{"kind":"text","text":"."},{"text":"ArrayFormat","kind":"typeIdentifier","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayFormat","preciseIdentifier":"s:10SwiftGodot4MeshC11ArrayFormatV"},{"text":" = [])","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Surfaces are created to be rendered using a "},{"type":"codeVoice","code":"primitive"},{"text":", which may be any of the values defined in ","type":"text"},{"code":"Mesh.PrimitiveType","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"code":"arrays","type":"codeVoice"},{"type":"text","text":" argument is an array of arrays. Each of the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayType\/max","isActive":true},{"type":"text","text":" elements contains an array with some of the mesh data for this surface as described by the corresponding member of "},{"type":"codeVoice","code":"Mesh.ArrayType"},{"type":"text","text":" or "},{"code":"null","type":"codeVoice"},{"text":" if it is not used by the surface. For example, ","type":"text"},{"code":"arrays[0]","type":"codeVoice"},{"text":" is the array of vertices. That first vertex sub-array is always required; the others are optional. Adding an index array puts this surface into “index mode” where the vertex and other arrays become the sources of data and the index array defines the vertex order. All sub-arrays must have the same length as the vertex array (or be an exact multiple of the vertex array’s length, when multiple elements of a sub-array correspond to a single vertex) or be empty, except for ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayType\/index"},{"text":" if it is used.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"blendShapes","type":"codeVoice"},{"type":"text","text":" argument is an array of vertex data for each blend shape. Each element is an array of the same structure as "},{"type":"codeVoice","code":"arrays"},{"type":"text","text":", but "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayType\/vertex","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayType\/normal","type":"reference","isActive":true},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayType\/tangent","type":"reference"},{"text":" are set if and only if they are set in ","type":"text"},{"code":"arrays","type":"codeVoice"},{"type":"text","text":" and all other entries are "},{"type":"codeVoice","code":"null"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"lods"},{"type":"text","text":" argument is a dictionary with float keys and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PackedInt32Array"},{"type":"text","text":" values. Each entry in the dictionary represents an LOD level of the surface, where the value is the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayType\/index","type":"reference","isActive":true},{"type":"text","text":" array to use for the LOD level and the key is roughly proportional to the distance at which the LOD stats being used. I.e., increasing the key of an LOD also increases the distance that the objects has to be from the camera before the LOD is used."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"flags"},{"type":"text","text":" argument is the bitwise OR of, as required: One value of "},{"code":"Mesh.ArrayCustomFormat","type":"codeVoice"},{"type":"text","text":" left shifted by "},{"type":"codeVoice","code":"ARRAY_FORMAT_CUSTOMn_SHIFT"},{"type":"text","text":" for each custom channel in use, "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayFormat\/flagUseDynamicUpdate","isActive":true,"type":"reference"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayFormat\/flagUse8BoneWeights","isActive":true},{"type":"text","text":", or "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Mesh\/ArrayFormat\/flagUsesEmptyVertexArray","isActive":true},{"type":"text","text":"."}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"When using indices, it is recommended to only use points, lines, or triangles."}],"type":"paragraph"}]}]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ArrayMesh\/addSurfaceFromArrays(primitive:arrays:blendShapes:lods:flags:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftGodot/documentation/SwiftGodot/PackedInt32Array":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PackedInt32Array","navigatorTitle":[{"text":"PackedInt32Array","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/packedint32array","type":"topic","role"