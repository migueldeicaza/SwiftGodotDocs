{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"sections":[],"metadata":{"title":"UndoRedo","modules":[{"name":"SwiftGodot"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"UndoRedo","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndoRedo"}],"symbolKind":"class","externalID":"s:10SwiftGodot8UndoRedoC","roleHeading":"Class"},"abstract":[{"text":"Provides a high-level interface for implementing undo and redo operations.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"UndoRedo"}],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"UndoRedo works by registering methods and property changes inside “actions”. You can create an action, then provide ways to do and undo this action using function calls and property changes, then commit the action."}]},{"inlineContent":[{"type":"text","text":"When an action is committed, all of the "},{"type":"codeVoice","code":"do_*"},{"text":" methods will run. If the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/undo()","isActive":true},{"text":" method is used, the ","type":"text"},{"code":"undo_*","type":"codeVoice"},{"text":" methods will run. If the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/redo()","type":"reference"},{"type":"text","text":" method is used, once again, all of the "},{"code":"do_*","type":"codeVoice"},{"text":" methods will run.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Here’s an example on how to add an action:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before calling any of the "},{"type":"codeVoice","code":"add_(un)do_*"},{"type":"text","text":" methods, you need to first call "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/createAction(name:mergeMode:backwardUndoOps:)","type":"reference"},{"type":"text","text":". Afterwards you need to call "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/commitAction(execute:)","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you don’t need to register a method, you can leave ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addDoMethod(callable:)","type":"reference","isActive":true},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addUndoMethod(callable:)","type":"reference"},{"text":" out; the same goes for properties. You can also register more than one method\/property.","type":"text"}]},{"inlineContent":[{"type":"text","text":"If you are making an "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorPlugin","type":"reference"},{"type":"text","text":" and want to integrate into the editor’s undo history, use "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/EditorUndoRedoManager","type":"reference"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you are registering multiple properties\/method which depend on one another, be aware that by default undo operation are called in the same order they have been added. Therefore instead of grouping do operation with their undo operations it is better to group do on one side and undo on the other as shown below.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This object emits the following signals:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/versionChanged","isActive":true,"type":"reference"}],"type":"paragraph"}]}]}],"kind":"content"}],"kind":"symbol","relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object"],"kind":"relationships"},{"title":"Conforms To","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/undoredo"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo"},"topicSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/maxSteps","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/versionChanged"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addDoMethod(callable:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addDoProperty(object:property:value:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addDoReference(object:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addUndoMethod(callable:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addUndoProperty(object:property:value:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/addUndoReference(object:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/clearHistory(increaseVersion:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/commitAction(execute:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/UndoRedo\/createAction(name:me