{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SkeletonModification2DTwoBoneIK","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SkeletonModification2D","type":"reference","isActive":true},{"text":" uses an algorithm typically called TwoBoneIK. This algorithm works by leveraging the law of cosines and the lengths of the bones to figure out what rotation the bones currently have, and what rotation they need to make a complete triangle, where the first bone, the second bone, and the target form the three vertices of the triangle. Because the algorithm works by making a triangle, it can only operate on two bones.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TwoBoneIK is great for arms, legs, and really any joints that can be represented by just two bones that bend to reach a target. This solver is more lightweight than "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SkeletonModification2DFABRIK","isActive":true},{"type":"text","text":", but gives similar, natural looking results."}]}]}],"metadata":{"title":"SkeletonModification2DTwoBoneIK","role":"symbol","roleHeading":"Class","navigatorTitle":[{"text":"SkeletonModification2DTwoBoneIK","kind":"identifier"}],"symbolKind":"class","externalID":"s:10SwiftGodot31SkeletonModification2DTwoBoneIKC","modules":[{"name":"SwiftGodot"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SkeletonModification2DTwoBoneIK"}]},"abstract":[{"text":"A modificat