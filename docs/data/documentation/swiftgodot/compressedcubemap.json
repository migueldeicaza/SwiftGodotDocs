{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CompressedCubemap","kind":"identifier"}],"modules":[{"name":"SwiftGodot"}],"symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"CompressedCubemap"}],"title":"CompressedCubemap","externalID":"s:10SwiftGodot17CompressedCubemapC","roleHeading":"Class","role":"symbol"},"sections":[],"abstract":[{"text":"An optionally compressed ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","isActive":true,"type":"reference"},{"text":".","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemap\/godotClassName"],"anchor":"Type-Properties","title":"Type Properties","generated":true}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedTextureLayered"],"title":"Inherits From","type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"],"title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CompressedCubemap"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"A cubemap that is loaded from a ","type":"text"},{"code":".ccube","type":"codeVoice"},{"type":"text","text":" file. This file format is internal to Godot; it is created by importing other image formats with the import system. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemap"},{"type":"text","text":" can use one of 4 compression methods:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Lossless (WebP or PNG, uncompressed on the GPU)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Lossy (WebP, uncompressed on the GPU)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"VRAM Compressed (compressed on the GPU)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"VRAM Uncompressed (uncompressed on the GPU)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Basis Universal (compressed on the GPU. Lower file sizes than VRAM Compressed, but slower to compress and lower quality than VRAM Compressed)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Only ","type":"text"},{"inlineContent":[{"text":"VRAM Compressed","type":"text"}],"type":"strong"},{"text":" actually reduces the memory usage on the GPU. The ","type":"text"},{"inlineContent":[{"text":"Lossless","type":"text"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"Lossy"}],"type":"strong"},{"text":" compression methods will reduce the required storage on disk, but they will not reduce memory usage on the GPU as the texture is sent to the GPU uncompressed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Using "},{"inlineContent":[{"type":"text","text":"VRAM Compressed"}],"type":"strong"},{"type":"text","text":" also improves loading times, as VRAM-compressed textures are faster to load compared to textures using lossless or lossy compression. VRAM compression can exhibit noticeable artifacts and is intended to be used for 3D rendering, not 2D."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap"},{"type":"text","text":" for a general description of cubemaps."}],"type":"paragraph"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/swiftgodot\/compressedcubemap"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemap","interfaceLanguage":"swift"},"references":{"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/Cubemap":{"url":"\/documentation\/swiftgodot\/cubemap","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cubemap"}],"abstract":[{"type":"text","text":"Six square textures representing the faces of a cube. Commonly used as a skybox."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap","kind":"symbol","title":"Cubemap","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Cubemap"}]},"doc://SwiftGodot/documentation/SwiftGodot/CompressedCubemap/godotClassName":{"url":"\/documentation\/swiftgodot\/compressedcubemap\/godotclassname","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemap\/godotClassName","kind":"symbol","role":"symbol","abstract":[],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"godotClassName","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC","text":"StringName","kind":"typeIdentifier"}],"type":"topic","title":"godotClassName"},"doc://SwiftGodot/documentation/SwiftGodot/CompressedCubemap":{"fragments":[{"text":"class","kind":"keyword"},