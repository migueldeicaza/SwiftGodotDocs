 property and the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D\/keepAspect-swift.property"},{"type":"text","text":" property."}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysical\/frustumFocalLength","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"frustumFocalLength"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/swiftgodot\/cameraattributesphysical\/frustumfocallength","title":"frustumFocalLength","kind":"symbol","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Camera3D/KeepAspect-swift.enum/height":{"url":"\/documentation\/swiftgodot\/camera3d\/keepaspect-swift.enum\/height","type":"topic","abstract":[{"text":"Preserves the vertical aspect ratio; also known as Hor+ scaling. This is usually the best option for projects running in landscape mode, as wider aspect ratios will automatically benefit from a wider horizontal FOV.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D\/KeepAspect-swift.enum\/height","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"height"}],"title":"Camera3D.KeepAspect.height"},"doc://SwiftGodot/17SwiftGodotRuntime18VariantConvertibleP":{"type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP","title":"SwiftGodotRuntime.VariantConvertible"},"doc://SwiftGodot/documentation/SwiftGodot/VoxelGI":{"navigatorTitle":[{"kind":"identifier","text":"VoxelGI"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VoxelGI","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VoxelGI"}],"type":"topic","abstract":[{"text":"Real-time global illumination (GI) pro