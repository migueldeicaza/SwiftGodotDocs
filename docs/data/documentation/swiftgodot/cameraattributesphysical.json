text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D\/near"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D\/fov"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D\/keepAspect-swift.property"},{"type":"text","text":" properties. When used in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VoxelGI"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI"},{"type":"text","text":", only the exposure settings will be used."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default settings are intended for use in an outdoor environment, tips for settings for use in an indoor environment can be found in each setting’s documentation."}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"Depth of field blur is only supported in the Forward+ and Mobile rendering methods, not Compatibility.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysical\/autoExposureMaxExposureValue","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysical\/autoExposureMinExposureValue","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysical\/exposureAperture","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysical\/exposureShutterSpeed","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysical\/frustumFar","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysical\/frustumFocalLength","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributesPhysi