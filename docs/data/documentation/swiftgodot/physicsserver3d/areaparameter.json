n/SwiftGodot/PhysicsServer3D/AreaParameter/angularDamp":{"title":"PhysicsServer3D.AreaParameter.angularDamp","abstract":[{"text":"Constant to set\/get the angular damping factor of an area.","type":"text"}],"url":"\/documentation\/swiftgodot\/physicsserver3d\/areaparameter\/angulardamp","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"angularDamp","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsServer3D\/AreaParameter\/angularDamp","kind":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/PhysicsServer3D/AreaParameter/gravityIsPoint":{"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsServer3D\/AreaParameter\/gravityIsPoint","title":"PhysicsServer3D.AreaParameter.gravityIsPoint","type":"topic","role":"symbol","url":"\/documentation\/swiftgodot\/physicsserver3d\/areaparameter\/gravityispoint","abstract":[{"type":"text","text":"Constant to set\/get whether the gravity vector of an area is a direction, or a center point."}],"fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"gravityIsPoint","kind":"identifier"}]},"doc://SwiftGodot/SH":{"identifier":"doc:\/\/SwiftGodot\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/PhysicsServer3D":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"PhysicsServer3D","kind":"identifier"}],"abstract":[{"type":"text","text":"A server interface for low-level 3D physics access."}],"url":"\/documentation\/swiftgodot\/physicsserver3d","role":"symbol","kind":"symbol","title":"PhysicsServer3D","type":"topic","navigatorTitle":[{"text":"PhysicsServer3D","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsServer3D"},"doc://SwiftGodot/documentation/SwiftGodot/PhysicsServer3D/AreaParameter/windForceMagnitude":{"title":"PhysicsServer3D.AreaParameter.windForceMagnitude","abstract":[{"text":"Constant to set\/get the magnitude of area-specific wind force. This wind force only applies to ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SoftBody3D","isActive":true,"type":"reference"},{"type":"text","text":" nodes. Other physics bodies are currently not affected by wind."}],"url":"\/documentation\/swiftgodot\/physicsserver3d\/areaparameter\/windforcemagnitude","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"windForceMagnitude","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsServer3D\/AreaParameter\/windForceMagnitude","kind":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/PhysicsServer3D/AreaParameter/gravityPointUnitDistance":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsServer3D\/AreaParameter\/gravityPointUnitDistance","kind":"symbol","url":"\/documentation\/swiftgodot\/physicsserver3d\/areaparameter\/gravitypointunitdistance","title":"PhysicsServer3D.AreaParameter.gravityPointUnitDistance","role":"symbol","abstract":[{"type":"text","text":"Constant to set\/get the distance at which the gravity strength is equal to the gravity controlled by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsServer3D\/AreaParameter\/gravity"},{"text":". For example, on a planet 100 meters in radius with a surface gravity of 4.0 m\/s², set the gravity to 4.0 and the unit distance to 100.0. The gravity will have falloff according to the inverse square law, so in the example, at 200 meters from the center the gravity will be 1.0 m\/s² (twice the distance, 1\/4th the gravity), at 50 meters it will be 16.0 m\/s² (half the distance, 4x the gravity), and so on.","type":"text"}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"gravityPointUnitDistance","kind":"identifier"}]}}}