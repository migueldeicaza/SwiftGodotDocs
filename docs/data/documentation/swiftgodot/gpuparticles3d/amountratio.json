Godot\/GPUParticles3D\/amount"},{"text":" to your liking instead.","type":"text"}]}],"name":"Note","type":"aside","style":"note"}]}],"abstract":[{"text":"The ratio of particles that should actually be emitted. If set to a value lower than ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":", this will set the amount of emitted particles throughout the lifetime to ","type":"text"},{"code":"amount * amount_ratio","type":"codeVoice"},{"type":"text","text":". Unlike changing "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles3D\/amount","isActive":true,"type":"reference"},{"type":"text","text":", changing "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles3D\/amountRatio","isActive":true,"type":"reference"},{"type":"text","text":" while emitting does not affect already-emitted particles and doesn’t cause the particle system to restart. "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles3D\/amountRatio","isActive":true,"type":"reference"},{"type":"text","text":" can be used to create effects that make the number of emitted particles vary over time."}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles3D"]]},"metadata":{"modules":[{"name":"SwiftGodot"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"amountRatio","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"role":"symbol","roleHeading":"Instance Property","externalID":"s:10SwiftGodot14GPUParticles3DC11amountRatioSdvp","symbolKind":"property","title":"amountRatio"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text