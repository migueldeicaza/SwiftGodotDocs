ue lower than ","type":"text"},{"code":"1.0","type":"codeVoice"},{"type":"text","text":", this will set the amount of emitted particles throughout the lifetime to "},{"code":"amount * amount_ratio","type":"codeVoice"},{"text":". Unlike changing ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles3D\/amount","isActive":true},{"type":"text","text":", changing "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles3D\/amountRatio","type":"reference","isActive":true},{"text":" while emitting does not affect already-emitted particles and doesn’t cause the particle system to restart. ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles3D\/amountRatio","isActive":true},{"type":"text","text":" can be used to create effects that make the number of emitted particles vary over time."}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"amountRatio","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}]}}}