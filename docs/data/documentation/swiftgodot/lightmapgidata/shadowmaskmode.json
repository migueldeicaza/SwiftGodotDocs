":"topic","abstract":[],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGIData\/ShadowmaskMode\/init(rawValue:)","fragments":[{"text":"init","kind":"identifier"},{"text":"?(","kind":"text"},{"text":"rawValue","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s5Int64V","text":"Int64","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/swiftgodot\/lightmapgidata\/shadowmaskmode\/init(rawvalue:)","kind":"symbol","title":"init(rawValue:)"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","role":"symbol","title":"LightmapGI","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LightmapGI"}],"navigatorTitle":[{"kind":"identifier","text":"LightmapGI"}],"abstract":[{"text":"Computes and stores baked lightmaps for fast global illumination.","type":"text"}],"url":"\/documentation\/swiftgodot\/lightmapgi","kind":"symbol","type":"topic"},"doc://SwiftGodot/SY":{"title":"Swift.RawRepresentable","type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/SY"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGIData":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"LightmapGIData","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGIData","title":"LightmapGIData","abstract":[{"text":"Contains baked lightmap and dynamic object probe data for ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/swiftgodot\/lightmapgidata","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LightmapGIData","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGIData/ShadowmaskMode/overlay":{"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGIData\/ShadowmaskMode\/overlay","abstract":[{"text":"Shadowmasking is enabled. Directional shadows will be rendered with real-time shadows overlaid on top of the shadowmask texture. This mode makes for smoother shadow transitions when the camera moves fast, at the cost of a potential smearing effect for directional shadows that are up close (due to the real-time shadow being mixed with a low-resolution shadowmask). Objects that only have shadows baked in the shadowmask (and no real-time shadows) will keep their shadows up close.","type":"text"}],"title":"LightmapGIData.ShadowmaskMode.overlay","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"overlay","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/lightmapgidata\/shadowmaskmode\/overlay","type":"topic"},"doc://SwiftGodot/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/SQ"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGIData/ShadowmaskMode/replace":{"abstract":[{"text":"Shadowmasking is enabled. Directional shadows that are outside the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D\/directionalShadowMaxDistance"},{"text":" will be rendered using the shadowmask texture. Shadows that are inside the range will be rendered using real-time shadows exclusively. This mode allows for more precise real-time shadows up close, without the potential “smearing” effect that can occur when using lightmaps with a high texel size. The downside is that when the camera moves fast, the transition between the real-time light and shadowmask can be obvious. Also, objects that only have shadows baked in the shadowmask (and no real-time shadows) won’t display any shadows up close.","type":"text"}],"title":"LightmapGIData.ShadowmaskMode.replace","url":"\/documentation\/swiftgodot\/lightmapgidata\/shadowmaskmode\/replace","role":"symb