{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/node\/processthreadgroup-swift.property"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/processThreadGroup-swift.property"},"sections":[],"metadata":{"title":"processThreadGroup","roleHeading":"Instance Property","symbolKind":"property","modules":[{"name":"SwiftGodot"}],"externalID":"s:10SwiftGodot4NodeC18processThreadGroupAC07ProcesseF0Ovp","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"processThreadGroup"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10SwiftGodot4NodeC","kind":"typeIdentifier","text":"Node"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10SwiftGodot4NodeC18ProcessThreadGroupO","kind":"typeIdentifier","text":"ProcessThreadGroup"}]},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Set the process thread group for this node (basically, whether it receives ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/notificationProcess","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/notificationPhysicsProcess","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_process(delta:)","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_physicsProcess(delta:)","isActive":true,"type":"reference"},{"text":" (and the internal versions) on the main thread or in a sub-thread.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"processThreadGroup","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot4NodeC","text":"Node","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot4NodeC18ProcessThreadGroupO","text":"ProcessThreadGroup","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ProcessThreadGroup-swift.enum","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"By default, the thread group is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ProcessThreadGroup-swift.enum\/inherit"},{"text":", which means that this node belongs to the same thread group as the parent node. The thread groups means that nodes in a specific thread group will process together, separate to other thread groups (depending on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/processThreadGroupOrder"},{"text":"). If the value is set is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ProcessThreadGroup-swift.enum\/subThread"},{"text":", this thread group will occur on a sub thread (not the main thread), otherwise if set to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ProcessThreadGroup-swift.enum\/mainThread"},{"text":" it will process on the main thread. If there is not a parent or grandparent node set to something other than inherit, the node will belong to the ","type":"text"},{"inlineContent":[{"type":"text","text":"default thread group"}],"type":"emphasis"},{"text":". This default group will process on the main thread and its group order is 0.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"During processing in a sub-thread, accessing most functions in nodes outside the thread group is forbidden (and it will result in an error in debug mode). Use "},{"code":"Object\/callDeferred(method:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"callThreadSafe(method:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"callDeferredThreadGroup(method:)","type":"codeVoice"},{"type":"text","text":" and the likes in order to communicate from the thread groups to the main thread (or to other thread groups)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To better understand process thread groups, the idea is that any node set to any other value than "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ProcessThreadGroup-swift.enum\/inherit"},{"type":"text","text":" will include any child (and grandchild) nodes set to inherit into its process thread group. This means that the processing of all the nodes in the group will happen together, at the same time as the node including them."}],"type":"paragraph"}]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/Node/ProcessThreadGroup-swift.enum/subThread":{"type":"topic","url":"\/documentation\/swiftgodot\/node\/processthreadgroup-swift.enum\/subthread","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/ProcessThreadGroup-swift.enum\/subThread","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subThread","kind":"identifier"}],"abstract":[{"text":"Process this node (and child nodes set to inherit) on a sub-thread. See ","type":"text"},{"identifier":"doc:\