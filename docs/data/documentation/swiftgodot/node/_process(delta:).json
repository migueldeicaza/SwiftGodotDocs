{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_process(delta:)"},"variants":[{"paths":["\/documentation\/swiftgodot\/node\/_process(delta:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node"]]},"metadata":{"externalID":"s:10SwiftGodot4NodeC8_process5deltaySd_tF","roleHeading":"Instance Method","modules":[{"name":"SwiftGodot"}],"role":"symbol","symbolKind":"method","title":"_process(delta:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"_process","kind":"identifier"},{"kind":"text","text":"("},{"text":"delta","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"text":")","kind":"text"}]},"abstract":[{"text":"Called during the processing step of the main loop. Processing happens at every frame and as fast as possible, so the ","type":"text"},{"type":"codeVoice","code":"delta"},{"text":" time since the previous frame is not constant. ","type":"text"},{"code":"delta","type":"codeVoice"},{"type":"text","text":" is in seconds."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"_process","kind":"identifier"},{"kind":"text","text":"("},{"text":"delta","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"kind":"text","text":")"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"It is only called if processing is enabled, which is done automatically if this method is overridden, and can be toggled with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/setProcess(enable:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Processing happens in order of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/processPriority"},{"type":"text","text":", lower priority values are called first. Nodes with the same priority are processed in tree order, or top to bottom as seen in the editor (also known as pre-order traversal)."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Corresponds to the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/notificationProcess","isActive":true,"type":"reference"},{"type":"text","text":" notification in "},{"type":"codeVoice","code":"Wrapper._notification(code:reverse)"},{"text":".","type":"text"}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"This method is only called if the node is present in the scene tree (i.e. if it’s not an orphan).","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"delta","type":"codeVoice"},{"type":"text","text":" will be larger than expected if running at a framerate lower than "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Engine\/physicsTicksPerSecond","isActive":true,"type":"reference"},{"type":"text","text":" \/ "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Engine\/maxPhysicsStepsPerFrame"},{"type":"text","text":" FPS. This is done to avoid “spiral of death” scenarios where performance would plummet due to an ever-increasing number of physics steps per frame. This behavior affects both "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_process(delta:)","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_physicsProcess(delta:)","type":"reference","isActive":true},{"type":"text","text":". As a result, avoid using "},{"type":"codeVoice","code":"delta"},{"type":"text","text":" for time measurements in real-world seconds. Use the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Time","isActive":true},{"text":" singleton’s methods for this purpose instead, such as ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Time\/getTicksUsec()","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://SwiftGodot/documentation/SwiftGodot/Node/notificationProcess":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Notification received from the tree every rendered frame when "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/isProcessing()","type":"reference","isActive":true},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"text":". See ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_process(delta:)","isActive":true},{"type":"text","text":"."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"notificationProcess","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"kind":"symbol","title":"notificationProcess","url":"\/documentation\/swiftgodot\/node\/notificationprocess","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/notificationProcess"},"doc://SwiftGodot/documentation/SwiftGodot/Node/_physicsProcess(delta:)":{"abstract":[{"type":"text","text":"Called during the physics processing step of the main loop. Physics processing means that the frame rate is synced to the physics, i.e. the "},{"type":"codeV