,"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParallaxLayer","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/parallaxlayer","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxLayer","title":"ParallaxLayer"},"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/ParallaxBackground":{"abstract":[{"type":"text","text":"A node used to create a parallax scrolling background."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ParallaxBackground","kind":"identifier"}],"navigatorTitle":[{"text":"ParallaxBackground","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/swiftgodot\/parallaxbackground","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxBackground","title":"ParallaxBackground","kind":"symbol"}}}