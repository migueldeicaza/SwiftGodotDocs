{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxLayer\/motionMirroring","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The interval, in pixels, at which the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxLayer"},{"type":"text","text":" is drawn repeatedly. Useful for creating an infinitely scrolling background. If an axis is set to "},{"code":"0","type":"codeVoice"},{"text":", the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxLayer"},{"type":"text","text":" will be drawn only once along that direction."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/parallaxlayer\/motionmirroring"]}],"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"motionMirroring","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Vector2","preciseIdentifier":"s:10SwiftGodot7Vector2V"}],"roleHeading":"Instance Property","role":"symbol","title":"motionMirroring","modules":[{"name":"SwiftGodot"}],"symbolKind":"property","externalID":"s:10SwiftGodot13ParallaxLayerC15motionMirroringAA7Vector2Vvp"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"motionMirroring","kind":"identifier"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Vector2","text":"Vector2","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot7Vector2V"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"kind":"text","text":" "},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want the repetition to pixel-perfect match a "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2D","isActive":true},{"text":" displayed by a child node, you should account for any scale applied to the texture when defining this interval. For example, if you use a child ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sprite2D","type":"reference","isActive":true},{"type":"text","text":" scaled to "},{"type":"codeVoice","code":"0.5"},{"text":" to display a 600x600 texture, and want this sprite to be repeated continuously horizontally, you should set the mirroring to ","type":"text"},{"code":"Vector2(300, 0)","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"Note","style":"note","type":"aside"},{"content":[{"inlineContent":[{"text":"If the length of the viewport axis is bigger than twice the repeated axis size, it will not repeat infinitely, as the parallax layer only draws 2 instances of the layer at any given time. The visibility window is calculated from the parent ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxBackground","type":"reference"},{"type":"text","text":"‘s position, not the layer’s own position. So, if you use mirroring, "},{"type":"strong","inlineContent":[{"type":"text","text":"do not"}]},{"text":" change the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxLayer"},{"type":"text","text":" position relative to its parent. Instead, if you need to adjust the background’s position, set the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CanvasLayer\/offset"},{"type":"text","text":" property in the parent "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxBackground"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"type":"aside","content":[{"inlineContent":[{"text":"Despite the name, the layer will not be mirrored, it will only be repeated.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ParallaxLayer"]]},"references":{"doc://SwiftGodot/documentation/SwiftGodot/Texture2D":{"abstract":[{"type":"text","text":"Texture for 2D and 3D."}],"navigatorTitle":[{"text":"Texture2D","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Texture2D"}],"url":"\/documentation\/swiftgodot\/texture2d","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2D","type":"topic","kind":"symbol","title":"Texture2D","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Vector2":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Vector2","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Vector2"}],"navigatorTitle":[{"text":"Vector2","kind":"identifier"}],"type":"topic","kind":"symbol","title":"Vector2","url":"\/documentation\/swiftgodot\/vector2","abstract":[{"type":"text","text":"A 2D vector using floating-point coordinates."}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Sprite2D":{"kind":"symbol","title":"Sprite2D","type":"topic","url":"\/documentation\/swiftgodot\/sprite2d","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Sprite2D","navigatorTitle":[{"text":"Sprite2D","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Sprite2D","kind":"identifier"}],"role":"symbol","abstract":[{"text":"General-purpose sprite node.","type":"text"}]},"doc://SwiftGodot/d