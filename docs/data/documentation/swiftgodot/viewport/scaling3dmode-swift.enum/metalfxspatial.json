{"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum"]]},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum\/metalfxSpatial","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum\/metalfxspatial"]}],"abstract":[{"text":"Use the ","type":"text"},{"type":"text","text":"MetalFX spatial upscaler"},{"text":" for the viewport’s 3D buffer.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"metalfxSpatial","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The amount of scaling can be set using "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Values less than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" will be result in the viewport being upscaled using MetalFX. Values greater than "},{"code":"1.0","type":"codeVoice"},{"text":" are not supported and bilinear downsampling will be used instead. A value of ","type":"text"},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" disables scaling."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"More information: "},{"type":"text","text":"MetalFX"},{"text":".","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only supported when the Metal rendering driver is in use, which limits this scaling mode to macOS and iOS.","type":"text"}]}],"type":"aside","style":"note","name":"Note"}],"kind":"content"}],"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"metalfxSpatial","kind":"identifier"}],"role":"symbol","title":"Viewport.Scaling3DMode.metalfxSpatial","externalID":"s:10SwiftGodot8ViewportC13Scaling3DModeO14metalfxSpatialyA2EmF","roleHeading":"Case","symbolKind":"case","modules":[{"name":"SwiftGodot"}]},"references":{"doc://SwiftGodot/documentation/SwiftGodot/Viewport":{"title":"Viewport","navigatorTitle":[{"kind":"identifier","text":"Viewport"}],"abstract":[{"text":"Abstract base class for viewports. Encapsulates drawing and interaction with a game world.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Viewport"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/viewport","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/Scaling3DMode-swift.enum":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"Scaling3DMode","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum","title":"Viewport.Scaling3DMode","abstract":[],"url":"\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum","navigatorTitle":[{"kind":"identifier","text":"Scaling3DMode"}]},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/scaling3dScale":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling3dScale"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","title":"scaling3dScale","abstract":[{"text":"Scales the 3D render buffer based on the viewport size uses an image filter specified in ","type":"text"},{"type":"codeVoice","code":"ProjectSettings\/rendering\/scaling3d\/mode"},{"type":"text","text":" to scale the output image to the full viewport size. Values lower than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" can be used to speed up 3D rendering at the cost of quality (undersampling). Values greater than "},{"type":"codeVoice","code":"1.0"},{"text":" are only valid for bilinear mode and can be used to improve 3D rendering quality at a high performance cost (supersampling). See also ","type":"text"},{"type":"codeVoice","code":"ProjectSettings\/rendering\/antiAliasing\/quality\/msaa3d"},{"type":"text","text":" for multi-sample antialiasing, which is significantly cheaper but only smooths the edges of polygons."}],"url":"\/documentation\/swiftgodot\/viewport\/scaling3dscale"},"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/Scaling3DMode-swift.enum/metalfxSpatial":{"role":"symbol","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"metalfxSpatial","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum\/metalfxSpatial","title":"Viewport.Scaling3DMode.metalfxSpatial","abstract":[{"type":"text","text":"Use the "},{"type":"text","text":"MetalFX spatial upscaler"},{"type":"text","text":" for the viewport’s 3D buffer."}],"url":"\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum\/metalfxspatial"}}}