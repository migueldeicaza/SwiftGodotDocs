{"abstract":[{"type":"text","text":"Use the "},{"type":"text","text":"MetalFX spatial upscaler"},{"type":"text","text":" for the viewport’s 3D buffer."}],"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum\/metalfxspatial"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"metalfxSpatial"}],"roleHeading":"Case","role":"symbol","title":"Viewport.Scaling3DMode.metalfxSpatial","modules":[{"name":"SwiftGodot"}],"externalID":"s:10SwiftGodot8ViewportC13Scaling3DModeO14metalfxSpatialyA2EmF","symbolKind":"case"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum\/metalfxSpatial"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"metalfxSpatial","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The amount of scaling can be set using ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Values less than ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" will be result in the viewport being upscaled using MetalFX. Values greater than ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" are not supported and bilinear downsampling will be used instead. A value of ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" disables scaling.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"More information: ","type":"text"},{"text":"MetalFX","type":"text"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only supported when the Metal rendering driver is in use, which limits this scaling mode to macOS and iOS."}]}],"type":"aside"}]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/Viewport/Scaling3DMode-swift.enum":{"navigatorTitle":[{"text":"Scaling3DMode","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scaling3DMode","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum","title":"Viewport.Scaling3DMode","kind":"symbol","url":"\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum","role":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport":{"title":"Viewport","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Viewport","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"Viewport","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/viewport","abstract":[{"type":"text","text":"Abstract base class for viewports. Encapsulates drawing and interaction with a game world."}]},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/Scaling3DMode-swift.enum/metalfxSpatial":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"metalfxSpatial"}],"title":"Viewport.Scaling3DMode.metalfxSpatial","type":"topic","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum\/metalfxSpatial","kind":"symbol","url":"\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum\/metalfxspatial","abstract":[{"type":"text","text":"Use the "},{"type":"text","text":"MetalFX spatial upscaler"},{"type":"text","text":" for the viewport’s 3D buffer."}]},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/scaling3dScale":{"abstract":[{"type":"text","text":"Scales the 3D render buffer based on the viewport size uses an image filter specified in "},{"code":"ProjectSettings\/rendering\/scaling3d\/mode","type":"codeVoice"},{"type":"text","text":" to scale the output image to the full viewport size. Values lower than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" can be used to speed up 3D rendering at the cost of quality (undersampling). Values greater than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" are only valid for bilinear mode and can be used to improve 3D rendering quality at a high performance cost (supersampling). See also "},{"type":"codeVoice","code":"ProjectSettings\/rendering\/antiAliasing\/quality\/msaa3d"},{"type":"text","text":" for multi-sample antialiasing, which is significantly cheaper but only smooths the edges of polygons."}],"type":"topic","title":"scaling3dScale","url":"\/documentation\/swiftgodot\/viewport\/scaling3dscale","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling3dScale"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale"}}}