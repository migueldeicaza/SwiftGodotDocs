{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Use AMD FidelityFX Super Resolution 2.2 upscaling for the viewport’s 3D buffer. The amount of scaling can be set using "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","type":"reference","isActive":true},{"type":"text","text":". Values less than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" will be result in the viewport being upscaled using FSR2. Values greater than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" are not supported and bilinear downsampling will be used instead. A value of "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" will use FSR2 at native resolution as a TAA solution."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fsr2","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"}],"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fsr2","kind":"identifier"}],"externalID":"s:10SwiftGodot8ViewportC13Scaling3DModeO4fsr2yA2EmF","roleHeading":"Case","role":"symbol","symbolKind":"case","modules":[{"name":"SwiftGodot"}],"title":"Viewport.Scaling3DMode.fsr2"},"sections":[],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum\/fsr2","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum\/fsr2"]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum"]]},"references":{"doc://SwiftGodot/documentation/SwiftGodot/Viewport/Scaling3DMode-swift.enum/fsr2":{"title":"Viewport.Scaling3DMode.fsr2","abstract":[{"type":"text","text":"Use AMD FidelityFX Super Resolution 2.2 upscaling for the viewport’s 3D buffer. The amount of scaling can be set using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale"},{"type":"text","text":". Values less than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" will be result in the viewport being upscaled using FSR2. Values greater than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" are not supported and bilinear downsampling will be used instead. A value of "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" will use FSR2 at native resolution as a TAA solution."}],"role":"symbol","url":"\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum\/fsr2","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum\/fsr2","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fsr2","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/Scaling3DMode-swift.enum":{"navigatorTitle":[{"text":"Scaling3DMode","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scaling3DMode","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/Scaling3DMode-swift.enum","title":"Viewport.Scaling3DMode","kind":"symbol","url":"\/documentation\/swiftgodot\/viewport\/scaling3dmode-swift.enum","role":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport":{"title":"Viewport","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Viewport","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"Viewport","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/viewport","abstract":[{"type":"text","text":"Abstract base class for viewports. Encapsulates drawing and interaction with a game world."}]},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/scaling3dScale":{"abstract":[{"type":"text","text":"Scales the 3D render buffer based on the viewport size uses an image filter specified in "},{"code":"ProjectSettings\/rendering\/scaling3d\/mode","type":"codeVoice"},{"type":"text","text":" to scale the output image to the full viewport size. Values lower than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" can be used to speed up 3D rendering at the cost of quality (undersampling). Values greater than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" are only valid for bilinear mode and can be used to improve 3D rendering quality at a high performance cost (supersampling). See also "},{"type":"codeVoice","code":"ProjectSettings\/rendering\/antiAliasing\/quality\/msaa3d"},{"type":"text","text":" for multi-sample antialiasing, which is significantly cheaper but only smooths the edges of polygons."}],"type":"topic","title":"scaling3dScale","url":"\/documentation\/swiftgodot\/viewport\/scaling3dscale","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling3dScale"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale"}}}