{"sections":[],"abstract":[{"type":"text","text":"Returns the viewport’s texture."}],"variants":[{"paths":["\/documentation\/swiftgodot\/viewport\/gettexture()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"getTexture"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot15ViewportTextureC","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ViewportTexture","text":"ViewportTexture"},{"kind":"text","text":"?"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"When trying to store the current texture (e.g. in a file), it might be completely black or outdated if used too early, especially when used in e.g. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/_ready()","type":"reference"},{"text":". To make sure the texture you get is correct, you can await [signal RenderingServer.frame_post_draw] signal.","type":"text"}]}],"name":"Note","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/useHdr2d"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" the returned texture will be an HDR image encoded in linear space."}]}],"name":"Note","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport"]]},"metadata":{"roleHeading":"Instance Method","externalID":"s:10SwiftGodot8ViewportC10getTextureAA0cE0CSgyF","modules":[{"name":"SwiftGodot"}],"title":"getTexture()","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getTexture","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ViewportTexture","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot15ViewportTextureC"},{"text":"?","kind":"text"}],"role":"symbol"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/getTexture()"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://SwiftGodot/documentation/SwiftGodot/Viewport":{"title":"Viewport","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Viewport","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"Viewport","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/viewport","abstract":[{"type":"text","text":"Abstract base class for viewports. Encapsulates drawing and interaction with a game world."}]},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/useHdr2d":{"abstract":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", 2D rendering will use an high dynamic range (HDR) format framebuffer matching the bit depth of the 3D framebuffer. When using the Forward+ renderer this will be an ","type":"text"},{"code":"RGBA16","type":"codeVoice"},{"text":" framebuffer, while when using the Mobile renderer it will be an ","type":"text"},{"code":"RGB10_A2","type":"codeVoice"},{"text":" framebuffer. Additionally, 2D rendering will take place in linear color space and will be converted to sRGB space immediately before blitting to the screen (if the Viewport is attached to the screen). Practically speaking, this means that the end result of the Viewport will not be clamped into the ","type":"text"},{"code":"0-1","type":"codeVoice"},{"text":" range and can be used in 3D rendering without color space adjustments. This allows 2D rendering to take advantage of effects requiring high dynamic range (e.g. 2D glow) as well as substantially improves the appearance of effects requiring highly detailed gradients.","type":"text"}],"url":"\/documentation\/swiftgodot\/viewport\/usehdr2d","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"useHdr2d","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/useHdr2d","title":"useHdr2d","role":"symbol","kind":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/ViewportTexture":{"role":"symbol","url":"\/documentation\/swiftgodot\/viewporttexture","title":"ViewportTexture","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ViewportTexture"}],"abstract":[{"type":"text","text":"Provides the content of a "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport","type":"reference","isActive":true},{"text":" as a dynamic texture.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ViewportTexture"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ViewportTexture","type":"topic","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/getTexture()":{"role":"symbol","type":"topic","title":"getTexture()","kind":"symbol","url":"\/documentation\/swiftgodot\/viewport\/gettexture()","abstract":[{"text":"Returns the viewport’s texture.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/getTexture()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getTexture","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ViewportTexture","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot15ViewportTextureC"},{"text":"?","kind":"text"}]},"doc://Swi