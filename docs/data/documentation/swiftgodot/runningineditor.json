{"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"abstract":[{"type":"text","text":"There are cases where you might want some of your Swift code for your extension"},{"text":" ","type":"text"},{"type":"text","text":"to run while it is being used in the Godot Editor."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"To achieve this, you can include the ","type":"text"},{"code":".tool","type":"codeVoice"},{"type":"text","text":" parameter to the "},{"type":"codeVoice","code":"@Godot"},{"type":"text","text":" macro,"},{"text":" ","type":"text"},{"type":"text","text":"like this:"}],"type":"paragraph"},{"code":["@Godot(.tool)","class Line3D: MeshInstance3D {","","    \/\/ This will be called in the editor","    override func _ready() {","\t\/\/ Run some code here","    }","","    \/\/ And so will this one","    override func _process(delta _: Double) {","\t\/\/ Check if we are running in the editor, or in the game","        if Engine.isEditorHint() {","            doEditorWork ()","        } else {","\t    doGameWork ()","\t}","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use it for doing many things, but it is mostly useful in level design"},{"text":" ","type":"text"},{"type":"text","text":"for visually presenting things that are hard to predict ourselves. Here are some"},{"type":"text","text":" "},{"type":"text","text":"use cases:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"If you have a cannon that shoots cannonballs affected by physics (gravity),"},{"type":"text","text":" "},{"type":"text","text":"you  can draw the cannonball’s trajectory in the editor, making level design a"},{"type":"text","text":" "},{"text":"lot easier.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If you have jumppads with varying jump heights, you can draw the maximum jump","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"height a player would reach if it jumped on one, also making level design"},{"type":"text","text":" "},{"text":"easier.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If your player doesn’t use a sprite, but draws itself using code, you can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"make that drawing code execute in the editor to see your player."}],"type":"paragraph"}]}]},{"style":"warning","name":"Warning","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":".tool","type":"codeVoice"},{"type":"text","text":" extensions run inside the editor, and let you access the"},{"type":"text","text":" "},{"type":"text","text":"scene tree of the currently edited scene. This is a powerful feature which"},{"text":" ","type":"text"},{"type":"text","text":"also comes with caveats, as the editor does not include protections for"},{"text":" ","type":"text"},{"text":"potential misuse of ","type":"text"},{"type":"codeVoice","code":"@Godot(.tool)"},{"type":"text","text":" scripts. Be extremely cautious when"},{"type":"text","text":" "},{"type":"text","text":"manipulating the scene tree, especially via "},{"type":"codeVoice","code":"Node\/queueFree"},{"text":", as it can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cause crashes if you free a node while the editor runs logic involving it."}],"type":"paragraph"}]},{"type":"heading","level":1,"text":"Detecting the Editor","anchor":"Detecting-the-Editor"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In your code, you can call the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Engine\/isEditorHint()"},{"text":" to determine whether","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the code is running inside the editor or in the game, and adjust your various"},{"type":"text","text":" "},{"type":"text","text":"methods accordingly."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/runningineditor"]}],"kind":"article","metadata":{"roleHeading":"Article","title":"Running Code in the Godot Editor","modules":[{"name":"SwiftGodot"}],"role":"article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Articles-and-Tutorials","generated":true,"title":"Articles and Tutorials","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation"]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/MemoryManagement":{"kind":"article","type":"topic","title":"Memory Management in SwiftGodot","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","url":"\/documentation\/swiftgodot\/memorymanagement","role":"article","abstract":[{"type":"text","text":"SwiftGodot surfaces various Godot types into the Swift universe in various ways:"}]},"doc://SwiftGodot/documentation/SwiftGodot/Exports":{"kind":"article","type":"topic","title":"Exports","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","url":"\/documentation\/swiftgodot\/exports","role":"article","abstract":[{"type":"text","text":"In Godot, class members can be exported. This means their value gets saved along"},{"type":"text","text":" "},{"text":"with the resource (such as the scene) they’re attached to. They will also be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"available for editing in the property editor. Exporting is done by using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Export"},{"text":" annotation.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/CustomTypes":{"kind":"article","type":"topic","title":"Using Custom Types","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","url":"\/documentation\/swiftgodot\/customtypes","role":"article","abstract":[{"type":"text","text":"You will typically extend the functionality of your Godot game by creating"},{"type":"text","text":" "},{"text":"classes that derive from one of the various Godot types and adjust the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"behavior accordingly."}]},"doc://SwiftGodot/documentation/SwiftGodot/Signals":{"abstract":[{"type":"text","text":"Signals in Godot are used by objects to post interesting events that are"},{"type":"text","text":" "},{"text":"taking place, and can be used by users to easily add behavior and react","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to changes."}],"kind":"article","url":"\/documentation\/swiftgodot\/signals","type":"topic","title":"Signals","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Engine/isEditorHint()":{"type":"topic","kind":"symbol","abstract":[{"text":"Returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if the script is currently running inside the editor, otherwise returns ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":". This is useful for "},{"type":"codeVoice","code":"@tool"},{"text":" scripts to conditionally draw editor helpers, or prevent accidentally running “game” code that would affect the scene state while in the editor:","type":"text"}],"url":"\/documentation\/swiftgodot\/engine\/iseditorhint()","title":"isEditorHint()","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"isEditorHint","kind":"identifier"},{"text":"() -> ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Engine\/isEditorHint()","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Differences":{"kind":"article","type":"topic","title":"SwiftGodot API differences to GDScript","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","url":"\/documentation\/swiftgodot\/differences","role":"article","abstract":[{"type":"text","text":"This document lists some common differences between GDSscript and SwiftGodot."}]},"doc://SwiftGodot/documentation/SwiftGodot/BindingNodes":{"abstract":[{"type":"text","text":"You will find yourself referencing nodes from a scene in your code. In"},{"type":"text","text":" "},{"text":"GDScript, that is usually achieved by using the dollar sign and the name of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"object you want to reference."}],"kind":"article","url":"\/documentation\/swiftgodot\/bindingnodes","type":"topic","title":"Referencing Nodes from your Scene","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/TypesTranslation":{"url":"\/documentation\/swiftgodot\/typestranslation","title":"Types Translation","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","abstract":[{"text":"This document contains information on how type translation happens between Swift and Godot.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Variants":{"abstract":[{"type":"text","text":"Follow up on the fundamental building block of Godot’s data types."}],"kind":"article","url":"\/documentation\/swiftgodot\/variants","type":"topic","title":"Variants","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","role":"article"}}}