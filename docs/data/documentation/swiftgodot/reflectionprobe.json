e. Every "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VisualInstance3D","type":"reference"},{"type":"text","text":" with a layer included in this cull mask will be rendered by the probe. It is best to only include large objects which are likely to take up a lot of space in the reflection in order to save on rendering cost."}],"role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cullMask","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s6UInt32V","text":"UInt32","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/reflectionprobe\/cullmask","title":"cullMask"},"doc://SwiftGodot/documentation/SwiftGodot/GeometryInstance3D/giMode-swift.property":{"role":"symbol","title":"giMode","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The global illumination mode to use for the whole geometry. To avoid inconsistent results, use a mode that matches the purpose of the mesh during gameplay (static\/dynamic)."}],"url":"\/documentation\/swiftgodot\/geometryinstance3d\/gimode-swift.property","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/giMode-swift.property","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"giMode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"GeometryInstance3D","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot18GeometryInstance3DC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot18GeometryInstance3DC6GIModeO","text":"GIMode"}]},"doc://SwiftGodot/documentation/SwiftGodot/VisualInstance3D":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VisualInstance3D"}],"navigatorTitle":[{"kind":"identifier","text":"VisualInstance3D"}],"role":"symbol","title":"VisualInstance3D","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VisualInstance3D