{"abstract":[{"text":"An optionally compressed ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","isActive":true},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemapArray","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"kind":"symbol","relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedTextureLayered"]},{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible"],"title":"Conforms To"}],"metadata":{"modules":[{"name":"SwiftGodot"}],"role":"symbol","externalID":"s:10SwiftGodot22CompressedCubemapArrayC","roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CompressedCubemapArray"}],"title":"CompressedCubemapArray","symbolKind":"class","navigatorTitle":[{"text":"CompressedCubemapArray","kind":"identifier"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"CompressedCubemapArray","kind":"identifier"}],"platforms":["macOS"]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A cubemap array that is loaded from a "},{"code":".ccubearray","type":"codeVoice"},{"type":"text","text":" file. This file format is internal to Godot; it is created by importing other image formats with the import system. "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemapArray","type":"reference","isActive":true},{"text":" can use one of 4 compression methods:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Lossless (WebP or PNG, uncompressed on the GPU)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Lossy (WebP, uncompressed on the GPU)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"VRAM Compressed (compressed on the GPU)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"VRAM Uncompressed (uncompressed on the GPU)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Basis Universal (compressed on the GPU. Lower file sizes than VRAM Compressed, but slower to compress and lower quality than VRAM Compressed)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Only "},{"type":"strong","inlineContent":[{"text":"VRAM Compressed","type":"text"}]},{"text":" actually reduces the memory usage on the GPU. The ","type":"text"},{"inlineContent":[{"text":"Lossless","type":"text"}],"type":"strong"},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"Lossy"}]},{"type":"text","text":" compression methods will reduce the required storage on disk, but they will not reduce memory usage on the GPU as the texture is sent to the GPU uncompressed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Using "},{"inlineContent":[{"type":"text","text":"VRAM Compressed"}],"type":"strong"},{"type":"text","text":" also improves loading times, as VRAM-compressed textures are faster to load compared to textures using lossless or lossy compression. VRAM compression can exhibit noticeable artifacts and is intended to be used for 3D rendering, not 2D."}],"type":"paragraph"},{"inlineContent":[{"text":"See ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","isActive":true},{"text":" for a general description of cubemap arrays.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/compressedcubemaparray"]}],"topicSections":[{"anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemapArray\/godotClassName"],"title":"Type Properties"}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/CubemapArray":{"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CubemapArray","abstract":[{"type":"text","text":"An array of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Cubemap"},{"text":"s, stored together and with a single reference.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"CubemapArray"}],"role":"symbol","kind":"symbol","title":"CubemapArray","navigatorTitle":[{"text":"CubemapArray","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/cubemaparray"},"doc://SwiftGodot/documentation/SwiftGodot/CompressedTextureLayered":{"role":"symbol","abstract":[{"text":"Base class for texture arrays that can optionally be compressed.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedTextureLayered","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CompressedTextureLayered"}],"url":"\/documentation\/swiftgodot\/compressedtexturelayered","navigatorTitle":[{"text":"CompressedTextureLayered","kind":"identifier"}],"title":"CompressedTextureLayered"},"doc://SwiftGodot/documentation/SwiftGodot/CompressedCubemapArray":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CompressedCubemapArray","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Comp