{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Debugging your SwiftGodot-based extensions using Xcode can either be done with a","type":"text"},{"text":" ","type":"text"},{"text":"binary Godot executable that you got directly from the Godot project, or using","type":"text"},{"text":" ","type":"text"},{"text":"your own build of Godot.","type":"text"}],"type":"paragraph"},{"anchor":"Make-an-Official-Godot-Engine-debuggable","level":3,"type":"heading","text":"Make an Official Godot Engine debuggable"},{"inlineContent":[{"text":"These steps are only required if you are using an official Godot built.  If you","type":"text"},{"text":" ","type":"text"},{"text":"compiled your own Godot locally, you do not need to do folow any of these steps.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Download Godot Engine without .Net support version in the "},{"type":"reference","identifier":"https:\/\/godotengine.org\/download\/macos\/","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"com.apple.security.get-task-allow"},{"type":"text","text":" entitlement and resign it."}],"type":"paragraph"}]}]},{"code":["mkdir -p \/tmp\/Godot","cp -R ~\/Downloads\/Godot.app \/tmp\/Godot\/","cd \/tmp\/Godot\/","codesign --display --xml --entitlements Godot.entitlements Godot.app","open Godot.entitlements ","# By default Finder will choose Xcode to open .entitlements file.","# You can open and edit it through any other application which can handle xml.","# Add <key>com.apple.security.get-task-allow<\/key><true\/> in the opened Editor Application","codesign -s - --deep --force --options=runtime --entitlements Godot.entitlements Godot.app","cp -Rf .\/Godot.app ~\/Downloads\/Godot.app"],"syntax":"shell","type":"codeListing"},{"name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"Alternatively you can also "},{"identifier":"https:\/\/developer.apple.com\/documentation\/security\/disabling_and_enabling_system_integrity_protection","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"to allow debugging anything. Use at your risk."}]}],"style":"warning","type":"aside"},{"anchor":"Debug-Swift-code","level":3,"type":"heading","text":"Debug Swift code"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Launch the re-signed Godot app, choose our target project and open it in","type":"text"},{"text":" ","type":"text"},{"text":"Godot.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open our Swift Package via Xcode and add breakpoints."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose Debug -> Attach to Process in the menu bar of Xcode and locate the"},{"type":"text","text":" "},{"type":"text","text":"existing Godot process here (Remember the pids of the existing Godot"},{"type":"text","text":" "},{"type":"text","text":"process)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to Godot Editor and launch the game."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose Debug -> Attach to Process in the menu bar of Xcode again and choose"},{"type":"text","text":" "},{"type":"text","text":"the new Godot process whose pid is not in the pids list we get in Step 3."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Trigger some event if needed and we’ll hit the breakpoints we have added in"},{"type":"text","text":" "},{"type":"text","text":"Step 2."}],"type":"paragraph