{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"useGlobalPose","kind":"identifier"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"text":"set","kind":"keyword"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Instead, it is possible to retarget between models with different body shapes, and position, rotation, and scale can be retargeted separately."}]},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":", retargeting is performed taking into account global pose."}]},{"inlineContent":[{"text":"In case the target skeleton has fewer bones than the source skeleton, the source bone parent’s transform is taken into account. However, bone length between skeletons must match exactly, if not, the bones will be forced to expand or shrink.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is useful for using dummy bone with length "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to match postures when retargeting between models with different number of bones."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"externalID":"s:10SwiftGodot18RetargetModifier3DC13useGlobalPoseSbvp","title":"useGlobalPose","roleHeading":"Instance Property","modules":[{"name":"SwiftGodot"}],"symbolKind":"property","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"useGlobalPose"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RetargetModifier3D\/useGlobalPose","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RetargetModifier3D"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"false"},{"type":"text","text":", in case the target skeleton has fewer bones than the source skeleton, the source bone parent’s transform will be ignored."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/retargetmodifier3d\/useglobalpose"]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/RetargetModifier3D":{"kind":"symbol","title":"RetargetModifier3D","url":"\/documentation\/swiftgodot\/retargetmodifier3d","abstract":[{"type":"text","text":"A modifier to transfer parent skeleton poses (or global poses) to child skeletons in model space with different rests."}],"navigatorTitle":[{"text":"RetargetModifier3D","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RetargetModifier3D","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RetargetModifier3D"}],"role":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/RetargetModifier3D/useGlobalPose":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RetargetModifier3D\/useGlobalPose","type":"topic","title":"useGlobalPose","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"useG