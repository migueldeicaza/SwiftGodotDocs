tion\/swiftgodot\/vehiclebody3d\/steering","title":"steering","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D\/steering"},"doc://SwiftGodot/s12IdentifiableP":{"type":"unresolvable","title":"Swift.Identifiable","identifier":"doc:\/\/SwiftGodot\/s12IdentifiableP"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/engineForce":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"engineForce","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/engineforce","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/engineForce","abstract":[{"type":"text","text":"Accelerates the wheel by applying an engine force. The wheel is only sped up if it is in contact with a surface. The "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RigidBody3D\/mass","type":"reference"},{"type":"text","text":" of the vehicle has an effect on the acceleration of the vehicle. For a vehicle with a mass set to 1000, try a value in the 25 - 50 range for acceleration."}],"type":"topic","kind":"symbol","title":"engineForce"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/godotClassName":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/godotClassName","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"godotClassName"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot10StringNameC","text":"StringName"}],"title":"godotClassName","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/godotclassname","abstract":[]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/getSkidinfo()":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"getSkidinfo","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/getskidinfo()","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getSkidinfo()","abstract":[{"type":"text","text":"Returns a value between 0.0 and 1.0 that indicates whether this wheel is skidding. 0.0 is skidding (the wheel has lost grip, e.g. icy terrain), 1.0 means not skidding (the wheel has full grip, e.g. dry asphalt road)."}],"type":"topic","kind":"symbol","title":"getSkidinfo()"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/getContactNormal()":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactNormal()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getContactNormal","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:10SwiftGodot7Vector3V","text":"Vector3","kind":"typeIdentifier"}],"title":"getContactNormal()","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/getcontactnormal()","abstract":[{"type":"text","text":"Returns the normal of the suspension’s collision in world space if the wheel is in contact. If the wheel isn’t in contact with anything, returns a vector pointing directly along the suspension axis toward the vehicle in world space."}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleBody3D":{"url":"\/documentation\/swiftgodot\/vehiclebody3d","type":"topic","title":"VehicleBody3D","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","kind":"symbol","navigatorTitle":[{"text":"VehicleBody3D","kind":"identifier"}],"abstract":[{"text":"A 3D physics body that simulates the behavior of a car.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"VehicleBody3D","kind":"identifier"}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/steering":{"kind":"symbol","abstract":[{"text":"The steering angle for the wheel, in radians. Setting this to a non-zero value will result in the vehicle turning when it’s moving.","type":"text"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/steering","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"steering","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/steering","title":"steering"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/wheelRestLength":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelRestLength","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"wheelRestLength","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/wheelrestlength","title":"wheelRestLength","abstract":[{"text":"This is the distance in meters the wheel is lowered from its origin point. Don’t set this to 0.0 and move the wheel into position, instead move the origin point of your wheel (the gizmo in Godot) to the position the wheel will take when bottoming out, then use the rest length to move the wheel down to the position it should be in when the car is in rest.","type":"text"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/useAsSteering":{"kind":"symbol","abstract":[{"type":"text","text":"If "},{"code":"true","type":"codeVoice"},{"text":", this wheel will be turned when the car steers. This value is used in conjunction with ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D\/steering","isActive":true},{"text":" and ignored if you are using the per-wheel ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/steering"},{"type":"text","text":" value instead."}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/useassteering","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"useAsSteering"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/useAsSteering","title":"useAsSteering"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/dampingRelaxation":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"dampingRelaxation"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"title":"dampingRelaxation","abstract":[{"type":"text","text":"The damping applied to the suspension spring when rebounding or extending, meaning when the wheel is moving down relative to the vehicle. It is measured in Newton-seconds per millimeter (N⋅s\/mm), or megagrams per second (Mg\/s). This value should be between 0.0 (no damping) and 1.0, but may be more. This value should always be slightly higher than the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression","isActive":true},{"text":" property. For a ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression","isActive":true,"type":"reference"},{"text":" value of 0.3, try a relaxation value of 0.5.","type":"text"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/dampingrelaxation","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingRelaxation","role":"symbol"},"doc://SwiftGodot/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/SwiftGodot\/SQ"},"doc://SwiftGodot/documentation/SwiftGodot/VariantConvertible":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"VariantConvertible"}],"role":"symbol","title":"VariantConvertible","url":"\/documentation\/swiftgodot\/variantconvertible","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantConvertible"}],"type":"topic","abstract":[{"text":"Protocol for types that can be converted to and from ","type":"text"},{"type":"codeVoice","code":"Variant?"},{"text":" aka ","type":"text"},{"type":"codeVoice","code":"Godot Variant"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"Default implementations are provided for most of the functions.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Example of implementation:"}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/getContactPoint()":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactPoint()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getContactPoint","kind":"identifier"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot7Vector3V","text":"Vector3"}],"title":"getContactPoint()","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/getcontactpoint()","abstract":[{"type":"text","text":"Returns the point of the suspension’s collision in world space if the wheel is in contact. If the wheel isn’t in contact with anything, returns the maximum point of the wheel’s ray cast in world space, which is defined by "},{"code":"wheel_rest_length + wheel_radius","type":"codeVoice"},{"text":".","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleBody3D/engineForce":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"engineForce","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"url":"\/documentation\/swiftgodot\/vehiclebody3d\/engineforce","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D\/engineForce","abstract":[{"text":"Accelerates the vehicle by applying an engine force. The vehicle is only sped up if the wheels that have ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/useAsTraction"},{"type":"text","text":" set to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" and are in contact with a surface. The "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RigidBody3D\/mass","type":"reference"},{"type":"text","text":" of the vehicle has an effect on the acceleration of the vehicle. For a vehicle with a mass set to 1000, try a value in the 25 - 50 range for acceleration."}],"type":"topic","kind":"symbol","title":"engineForce"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/getRpm()":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getRpm()","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"getRpm"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"title":"getRpm()","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/getrpm()","abstract":[{"type":"text","text":"Returns the rotational speed of the wheel in revolutions per minute."}]},"doc://SwiftGodot/s23CustomStringConvertibleP":{"type":"unresolvable","title":"Swift.CustomStringConvertible","identifier":"doc:\/\/SwiftGodot\/s23CustomStringConvertibleP"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/suspensionMaxForce":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/suspensionMaxForce","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"suspensionMaxForce"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"title":"suspensionMaxForce","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/suspensionmaxforce","abstract":[{"type":"text","text":"The maximum force the spring can resist. This value should be higher than a quarter of the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RigidBody3D\/mass"},{"type":"text","text":" of the "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","type":"reference"},{"type":"text","text":" or the spring will not carry the weight of the vehicle. Good results are often obtained by a value that is about 3× to 4× this number."}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/useAsTraction":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"useAsTraction","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/useastraction","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/useAsTraction","abstract":[{"type":"text","text":"If "},{"code":"true","type":"codeVoice"},{"type":"text","text":", this wheel transfers engine force to the ground to propel the vehicle forward. This value is used in conjunction with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D\/engineForce"},{"type":"text","text":" and ignored if you are using the per-wheel "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/engineForce","isActive":true},{"type":"text","text":" value instead."}],"type":"topic","kind":"symbol","title":"useAsTraction"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/wheelRadius":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelRadius","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wheelRadius","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"title":"wheelRadius","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/wheelradius","abstract":[{"type":"text","text":"The radius of the wheel in meters."}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/isInContact()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isInContact","kind":"identifier"},{"kind":"text","text":"() -> "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/isincontact()","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/isInContact()","abstract":[{"type":"text","text":"Returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if this wheel is in contact with a surface."}],"type":"topic","kind":"symbol","title":"isInContact()"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/suspensionTravel":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/suspensionTravel","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"suspensionTravel"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"abstract":[{"text":"This is the distance the suspension can travel. As Godot units are equivalent to meters, keep this setting relatively low. Try a value between 0.1 and 0.3 depending on the type of car.","type":"text"}],"title":"suspensionTravel","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/suspensiontravel"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/wheelRollInfluence":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelRollInfluence","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"wheelRollInfluence","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"title":"wheelRollInfluence","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/wheelrollinfluence","abstract":[{"type":"text","text":"This value affects the roll of your vehicle. If set to 1.0 for all wheels, your vehicle will resist body roll, while a value of 0.0 will be prone to rolling over."}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/getContactBody()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getContactBody","kind":"identifier"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:10SwiftGodot6Node3DC","kind":"typeIdentifier","text":"Node3D"},{"text":"?","kind":"text"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/getcontactbody()","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactBody()","abstract":[{"type":"text","text":"Returns the contacting body node if valid in the tree, as "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D","isActive":true},{"type":"text","text":". At the moment, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GridMap"},{"type":"text","text":" is not supported so the node will be always of type "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsBody3D","type":"reference"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","title":"getContactBody()"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/suspensionStiffness":{"abstract":[{"type":"text","text":"The stiffness of the suspension, measured in Newtons per millimeter (N\/mm), or megagrams per second squared (Mg\/s²). Use a value lower than 50 for an off-road car, a value between 50 and 100 for a race car and try something around 200 for something like a Formula 1 car."}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/suspensionstiffness","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/suspensionStiffness","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"suspensionStiffness"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"role":"symbol","type":"topic","title":"suspensionStiffness","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/brake":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/brake","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"brake","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"title":"brake","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/brake","abstract":[{"type":"text","text":"Slows down the wheel by applying a braking force. The wheel is only slowed down if it is in contact with a surface. The force you need to apply to adequately slow down your vehicle depends on the "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RigidBody3D\/mass","type":"reference"},{"type":"text","text":" of the vehicle. For a vehicle with a mass set to 1000, try a value in the 25 - 30 range for hard braking."}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/dampingCompression":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"dampingCompression"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/dampingcompression","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression","title":"dampingCompression","abstract":[{"type":"text","text":"The damping applied to the suspension spring when being compressed, meaning when the wheel is moving up relative to the vehicle. It is measured in Newton-seconds per millimeter (N⋅s\/mm), or megagrams per second (Mg\/s). This value should be between 0.0 (no damping) and 1.0, but may be more. A value of 0.0 means the car will keep bouncing as the spring keeps its energy. A good value for this is around 0.3 for a normal car, 0.5 for a race car."}],"kind":"symbol","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Node3D":{"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D","abstract":[{"text":"Most basic 3D game object, parent of all 3D-related nodes.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Node3D"}],"navigatorTitle":[{"text":"Node3D","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swiftgodot\/node3d","title":"Node3D","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/GridMap":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GridMap","abstract":[{"text":"Node for 3D tile-based maps.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"GridMap"}],"title":"GridMap","url":"\/documentation\/swiftgodot\/gridmap","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"GridMap"}]},"doc://SwiftGodot/documentation/SwiftGodot/RigidBody3D/mass":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"mass","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/rigidbody3d\/mass","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RigidBody3D\/mass","abstract":[{"type":"text","text":"The body’s mass."}],"type":"topic","kind":"symbol","title":"mass"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VehicleWheel3D","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d","navigatorTitle":[{"text":"VehicleWheel3D","kind":"identifier"}],"title":"VehicleWheel3D","abstract":[{"text":"A 3D physics body for a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D"},{"text":" that simulates the behavior of a wheel.","type":"text"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/wheelFrictionSlip":{"title":"wheelFrictionSlip","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/wheelfrictionslip","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"This determines how much grip this wheel has. It is combined with the friction setting of the surface the wheel is in contact with. 0.0 means no grip, 1.0 is normal grip. For a drift car setup, try setting the grip of the rear wheels slightly lower than the front wheels, or use a lower value to simulate tire wear."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelFrictionSlip","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"wheelFrictionSlip","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"type":"topic"}}}