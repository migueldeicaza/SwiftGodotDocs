{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VehicleWheel3D","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"A node used as a child of a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","isActive":true},{"text":" parent to simulate the behavior of one of its wheels. This node also acts as a collider to detect if the wheel is touching a surface.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"This class has known issues and isn’t designed to provide realistic 3D vehicle physics. If you want advanced vehicle physics, you may need to write your own physics integration using another "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsBody3D","isActive":true},{"type":"text","text":" class."}],"type":"paragraph"}],"type":"aside","style":"note"}],"kind":"content"}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/brake","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingRelaxation","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/engineForce","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/steering","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/suspensionMaxForce","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/suspensionStiffness","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/suspensionTravel","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/useAsSteering","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/useAsTraction","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelFrictionSlip","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelRadius","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelRestLength","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/wheelRollInfluence"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactBody()","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactNormal()","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactPoint()","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getRpm()","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getSkidinfo()","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/isInContact()"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/godotClassName"],"title":"Type Properties","anchor":"Type-Properties","generated":true}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"metadata":{"modules":[{"name":"SwiftGodot"}],"roleHeading":"Class","symbolKind":"class","title":"VehicleWheel3D","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VehicleWheel3D"}],"navigatorTitle":[{"kind":"identifier","text":"VehicleWheel3D"}],"role":"symbol","externalID":"s:10SwiftGodot14VehicleWheel3DC"},"sections":[],"abstract":[{"type":"text","text":"A 3D physics body for a "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","type":"reference","isActive":true},{"type":"text","text":" that simulates the behavior of a wheel."}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"},{"identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/swiftgodot\/vehiclewheel3d"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D","interfaceLanguage":"swift"},"references":{"doc://SwiftGodot/SH":{"identifier":"doc:\/\/SwiftGodot\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/dampingRelaxation":{"title":"dampingRelaxation","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dampingRelaxation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"abstract":[{"type":"text","text":"The damping applied to the suspension spring when rebounding or extending, meaning when the wheel is moving down relative to the vehicle. It is measured in Newton-seconds per millimeter (N⋅s\/mm), or megagrams per second (Mg\/s). This value should be between 0.0 (no damping) and 1.0, but may be more. This value should always be slightly higher than the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},{"type":"text","text":" property. For a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},{"type":"text","text":" value of 0.3, try a relaxation value of 0.5."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingRelaxation","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/dampingrelaxation"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/getContactPoint()":{"title":"getContactPoint()","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/getcontactpoint()","abstract":[{"text":"Returns the point of the suspension’s collision in world space if the wheel is in contact. If the wheel isn’t in contact with anything, returns the maximum point of the wheel’s ray cast in world space, which is defined by ","type":"text"},{"code":"wheel_rest_length + wheel_radius","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactPoint()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getContactPoint","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime7Vector3V","text":"Vector3","kind":"typeIdentifier"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleBody3D/engineForce":{"abstract":[{"type":"text","text":"Accelerates the vehicle by applying an engine force. The vehicle is only sped up if the wheels that have "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/useAsTraction","type":"reference","isActive":true},{"type":"text","text":" set to "},{"code":"true","type":"codeVoice"},{"type":"text","text":" and are in contact with a surface. The "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RigidBody3D\/mass","type":"reference","isActive":true},{"type":"text","text":" of the vehicle has an effect on the acceleration of the vehicle. For a vehicle with a mass set to 1000, try a value in the 25 - 50 range for acceleration."}],"title":"engineForce","url":"\/documentation\/swiftgodot\/vehiclebody3d\/engineforce","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D\/engineForce","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"engineForce","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D":{"navigatorTitle":[{"text":"VehicleWheel3D","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftgodot\/vehiclewheel3d","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D","role":"symbol","abstract":[{"text":"A 3D physics body for a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","type":"reference"},{"text":" that simulates the behavior of a wheel.","type":"text"}],"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VehicleWheel3D","kind":"identifier"}],"title":"VehicleWheel3D"},"doc://SwiftGodot/SQ":{"identifier":"doc:\/\/SwiftGodot\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/suspensionStiffness":{"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/suspensionstiffness","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/suspensionStiffness","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"suspensionStiffness"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"kind":"symbol","title":"suspensionStiffness","abstract":[{"type":"text","text":"The stiffness of the suspension, measured in Newtons per millimeter (N\/mm), or megagrams per second squared (Mg\/s²). Use a value lower than 50 for an off-road car, a value between 50 and 100 for a race car and try something around 200 for something like a Formula 1 car."}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/dampingCompression":{"title":"dampingCompression","type":"topic","abstract":[{"text":"The damping applied to the suspension spring when being compressed, meaning when the wheel is moving up relative to the vehicle. It is measured in Newton-seconds per millimeter (N⋅s\/mm), or megagrams per second (Mg\/s). This value should be between 0.0 (no damping) and 1.0, but may be more. A value of 0.0 means the car will keep bouncing as the spring keeps its energy. A good value for this is around 0.3 for a normal car, 0.5 for a race car.","type":"text"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/dampingcompression","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dampingCompression"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/getContactBody()":{"title":"getContactBody()","kind":"symbol","abstract":[{"text":"Returns the contacting body node if valid in the tree, as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D","type":"reference"},{"text":". At the moment, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GridMap","type":"reference"},{"text":" is not supported so the node will be always of type ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsBody3D","type":"reference"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/getContactBody()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getContactBody"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:10SwiftGodot6Node3DC","kind":"typeIdentifier","text":"Node3D"},{"kind":"text","text":"?"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/getcontactbody()"},"doc://Swif