{"abstract":[{"type":"text","text":"A 3D physics body for a "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","type":"reference","isActive":true},{"text":" that simulates the behavior of a wheel.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"SwiftGodot"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"VehicleWheel3D","kind":"identifier"}],"title":"VehicleWheel3D","roleHeading":"Class","symbolKind":"class","role":"symbol","externalID":"s:10SwiftGodot14VehicleWheel3DC","navigatorTitle":[{"text":"VehicleWheel3D","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"VehicleWheel3D","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A node used as a child of a "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","isActive":true},{"text":" parent to simulate the behavior of one of its wheels. This node also acts as a collider to detect if the wheel is touching a surface.","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This class has known issues and isn’t designed to provide realistic 3D vehicle physics. If you want advanced vehicle physics, you may need to write your own physics integration using another "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PhysicsBody3D"},{"text":" class.","type":"te