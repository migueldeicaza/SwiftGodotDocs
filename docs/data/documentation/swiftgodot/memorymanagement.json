{"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Structures: things like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Rect2","type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Plane","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Simple classes that have their lifecyle managed in a way similar to Swift","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Callable","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantDictionary","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants"},{"type":"text","text":": these are objects that can wrap every other Godot type and are"},{"text":" ","type":"text"},{"text":"used to pass values around in Godot.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object"},{"text":"-derived classes: this is what makes up the bulk of Godot classes, things like ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource"},{"type":"text","text":", "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Image","type":"reference","isActive":true},{"type":"text","text":" and so on."}]}]}]},{"type":"heading","text":"Object-derived Classes","level":2,"anchor":"Object-derived-Classes"},{"inlineContent":[{"type":"text","text":"In SwiftGodot, the base type that bridges Godot objects and the Swift world"},{"text":" ","type":"text"},{"type":"text","text":"happens in the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","type":"reference","isActive":true},{"type":"text","text":" class (technically, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Wrapped"},{"type":"text","text":", but that is"},{"type":"text","text":" "},{"text":"historical detail that is not very important).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Object-derived classes expose the functionality of the type in Godot and they"},{"type":"text","text":" "},{"type":"text","text":"themselves only contain one value, a pointer to the native Godot object (we call"},{"text":" ","type":"text"},{"type":"text","text":"this the "},{"type":"codeVoice","code":"handle"},{"type":"text","text":")."}]},{"inlineContent":[{"type":"text","text":"SwiftGodot ensures that for every Godot object instance, a single object is"},{"text":" ","type":"text"},{"type":"text","text":"surfaced in the Swift world.   This means that if two SwiftGodot objects have"},{"type":"text","text":" "},{"type":"text","text":"different addresses, they are also different Godot objects.   This did not use"},{"text":" ","type":"text"},{"type":"text","text":"to be the case in the early days of SwiftGodot."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Godot has a few different rules for how memory must be managed for subclasses of"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","type":"reference","isActive":true},{"type":"text","text":", depending on which type of object you are dealing with.   The"},{"type":"text","text":" "},{"text":"hierarchy of types, based on the rules that are used are as follows:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","isActive":true,"type":"reference"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RefCounted","isActive":true,"type":"reference"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource","isActive":true,"type":"reference"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true}]}]}],"type":"unorderedList"}]}]},{"level":3,"text":"Object Classes","anchor":"Object-Classes","type":"heading"},{"inlineContent":[{"text":"Subclasses of ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","isActive":true},{"type":"text","text":" that are not "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RefCounted"},{"type":"text","text":" or "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true,"type":"reference"},{"type":"text","text":" must be"},{"text":" ","type":"text"},{"text":"manually released by calling ","type":"text"},{"code":"Object\/free()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Node Classes","level":3,"anchor":"Node-Classes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subclasses of "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true},{"text":" are a bit different.   They are not reference counted,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and they are expected to be added to a "},{"type":"codeVoice","code":"Scene"},{"text":".   When the scene is destroyed,","type":"text"},{"type":"text","text":" "},{"text":"so are all the objects in it.   If you create ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true},{"type":"text","text":" objects that you do not"},{"type":"text","text":" "},{"type":"text","text":"add to a "},{"type":"codeVoice","code":"Scene"},{"text":", you are responsible for releasing them, and you do so by","type":"text"},{"type":"text","text":" "},{"type":"text","text":"calling the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/queueFree()"},{"type":"text","text":" method.   This is similar to how you would do"},{"type":"text","text":" "},{"text":"it in Godot.","type":"text"}]},{"text":"RefCounted Classes","anchor":"RefCounted-Classes","type":"heading","level":3},{"inlineContent":[{"text":"Subclasses of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RefCounted"},{"type":"text","text":" include popular base classes like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource"},{"text":", and","type":"text"},{"type":"text","text":" "},{"text":"thus a large number of interesting classes like ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture"},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AudioStream","isActive":true},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"others.   SwiftGodot is able to manage the lifecycle of every "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RefCounted","isActive":true,"type":"reference"},{"type":"text","text":" in"},{"text":" ","type":"text"},{"type":"text","text":"a way similar to Swift - that is, when the last reference to the object goes"},{"type":"text","text":" "},{"text":"away, the object is deallocated.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Invalidated-Objects","text":"Invalidated Objects","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Unlike RefCounted objects, everything else that derives from ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","isActive":true,"type":"reference"},{"type":"text","text":" can"},{"text":" ","type":"text"},{"type":"text","text":"still have a Swift-level object that points to an object that has been released."}]},{"inlineContent":[{"text":"If you keep a reference to these objects, you need to ensure that they remain","type":"text"},{"type":"text","text":" "},{"type":"text","text":"valid when Godot calls you back, as the objects might have been freed behind"},{"type":"text","text":" "},{"type":"text","text":"your back - so you must call "},{"code":"Object\/isValid","type":"codeVoice"},{"type":"text","text":" to ensure that the object"},{"text":" ","type":"text"},{"text":"remains valid.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/memorymanagement"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/docume