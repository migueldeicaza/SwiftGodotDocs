{"variants":[{"paths":["\/documentation\/swiftgodot\/memorymanagement"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Articles-and-Tutorials","title":"Articles and Tutorials","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RemoteProcedureCalls","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Documentation"],"generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement"},"abstract":[{"text":"SwiftGodot surfaces various Godot types into the Swift universe in various ways:","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Structures: things like "},{"code":"Rect2","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Plane","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple classes that have their lifecyle managed in a way similar to Swift"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Callable"},{"type":"text","text":", "},{"type":"codeVoice","code":"VariantArray"},{"type":"text","text":", "},{"type":"codeVoice","code":"VariantDictionary"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","type":"reference","isActive":true},{"text":": these are objects that can wrap every other Godot type and are","type":"text"},{"text":" ","type":"text"},{"text":"used to pass values around in Godot.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Object","type":"codeVoice"},{"text":"-derived classes: this is what makes up the bulk of Godot classes, things like ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Image"},{"text":" and so on.","type":"text"}]}]}]},{"anchor":"Object-derived-Classes","text":"Object-derived Classes","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In SwiftGodot, the base type that bridges Godot objects and the Swift world","type":"text"},{"text":" ","type":"text"},{"text":"happens in the ","type":"text"},{"code":"Object","type":"codeVoice"},{"text":" class (technically, ","type":"text"},{"code":"Wrapped","type":"codeVoice"},{"text":", but that is","type":"text"},{"text":" ","type":"text"},{"text":"historical detail that is not very important).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Object-derived classes expose the functionality of the type in Godot and they"},{"type":"text","text":" "},{"type":"text","text":"themselves only contain one value, a pointer to the native Godot object (we call"},{"type":"text","text":" "},{"type":"text","text":"this the "},{"code":"handle","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"SwiftGodot ensures that for every Godot object instance, a single object is","type":"text"},{"text":" ","type":"text"},{"text":"surfaced in the Swift world.   This means that if two SwiftGodot objects have","type":"text"},{"text":" ","type":"text"},{"text":"different addresses, they are also different Godot objects.   This did not use","type":"text"},{"text":" ","type":"text"},{"text":"to be the case in the early days of SwiftGodot.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Godot has a few different rules for how memory must be managed for subclasses of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Object"},{"text":", depending on which type of object you are dealing with.   The","type":"text"},{"text":" ","type":"text"},{"text":"hierarchy of types, based on the rules that are used are as follows:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Object"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RefCounted","type":"codeVoice"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","type":"reference"}]}]}]}]}]},{"anchor":"Object-Classes","text":"Object Classes","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subclasses of "},{"type":"codeVoice","code":"Object"},{"type":"text","text":" that are not "},{"type":"codeVoice","code":"RefCounted"},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","isActive":true},{"type":"text","text":" must be"},{"type":"text","text":" "},{"type":"text","text":"manually released by calling "},{"type":"codeVoice","code":"Object\/free()"},{"type":"text","text":"."}]},{"anchor":"Node-Classes","text":"Node Classes","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subclasses of "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","type":"reference"},{"type":"text","text":" are a bit different.   They are not reference counted,"},{"type":"text","text":" "},{"type":"text","text":"and they are expected to be added to a "},{"code":"Scene","type":"codeVoice"},{"type":"text","text":".   When the scene is destroyed,"},{"type":"text","text":" "},{"type":"text","text":"so are all the objects in it.   If you create "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","type":"reference"},{"type":"text","text":" objects that you do not"},{"type":"text","text":" "},{"type":"text","text":"add to a "},{"code":"Scene","type":"codeVoice"},{"type":"text","text":", you are responsible for releasing them, and you do so by"},{"type":"text","text":" "},{"type":"text","text":"calling the "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/queueFree()","type":"reference"},{"type":"text","text":" method.   This is similar to how you would do"},{"type":"text","text":" "},{"type":"text","text":"it in Godot."}]},{"anchor":"RefCounted-Classes","text":"RefCounted Classes","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subclasses of "},{"type":"codeVoice","code":"RefCounted"},{"type":"text","text":" include popular base classes like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"thus a large number of interesting classes like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AudioStream"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"others.   SwiftGodot is able to manage the lifecycle of every "},{"type":"codeVoice","code":"RefCounted"},{"type":"text","text":" in"},{"type":"text","text":" "},{"type":"text","text":"a way similar to Swift - that is, when the last reference to the object goes"},{"type":"text","text":" "},{"type":"text","text":"away, the object is deallocated."}]},{"anchor":"Invalidated-Objects","text":"Invalidated Objects","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike RefCounted objects, everything else that derives from "},{"type":"codeVoice","code":"Object"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"still have a Swift-level object that points to an object that has been released."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you keep a reference to these objects, you need to ensure that they remain"},{"type":"text","text":" "},{"type":"text","text":"valid when Godot calls you back, as the objects might have been freed behind"},{"type":"text","text":" "},{"type":"text","text":"your back - so you must call "},{"code":"Object\/isValid","type":"codeVoice"},{"type":"text","text":" to ensure that the object"},{"type":"text","text":" "},{"type":"text","text":"remains valid."}]}]}],"metadata":{"title":"Memory Management in SwiftGodot","modules":[{"name":"SwiftGodot"}],"roleHeading":"Article","role":"article"},"references":{"doc://SwiftGodot/documentation/SwiftGodot/CustomTypes":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","url":"\/documentation\/swiftgodot\/customtypes","title":"Using Custom Types","kind":"article","role":"article","abstract":[{"text":"You will typically extend the functionality of your Godot game by creating","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"classes that derive from one of the various Godot types and adjust the"},{"type":"text","text":" "},{"type":"text","text":"behavior accordingly."}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Signals":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","url":"\/documentation\/swiftgodot\/signals","kind":"article","role":"article","type":"topic","title":"Signals","abstract":[{"text":"Signals in Godot are used by objects to post interesting events that are","type":"text"},{"text":" ","type":"text"},{"text":"taking place, and can be used by users to easily add behavior and react","type":"text"},{"text":" ","type":"text"},{"text":"to changes.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Differences":{"type":"topic","url":"\/documentation\/swiftgodot\/differences","kind":"article","title":"SwiftGodot API differences to GDScript","role":"article","abstract":[{"type":"text","text":"This document lists some common differences between GDSscript and SwiftGodot."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences"},"doc://SwiftGodot/documentation/SwiftGodot/TypesTranslation":{"url":"\/documentation\/swiftgodot\/typestranslation","kind":"article","type":"topic","title":"Types Translation","role":"article","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation","abstract":[{"type":"text","text":"This document contains information on how type translation happens between Swift and Godot."}]},"doc://SwiftGodot/documentation/SwiftGodot/Node":{"kind":"symbol","abstract":[{"text":"Base class for all scene objects.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Node","kind":"identifier"}],"title":"Node","url":"\/documentation\/swiftgodot\/node","type":"topic","navigatorTitle":[{"text":"Node","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/Resource":{"abstract":[{"text":"Base class for serializable objects.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiftgodot\/resource","type":"topic","title":"Resource","navigatorTitle":[{"kind":"identifier","text":"Resource"}],"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Resource","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/AudioStream":{"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AudioStream","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AudioStream","kind":"identifier"}],"title":"AudioStream","url":"\/documentation\/swiftgodot\/audiostream","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"AudioStream","kind":"identifier"}],"abstract":[{"type":"text","text":"Base class for audio streams."}]},"doc://SwiftGodot/documentation/SwiftGodot/RunningInEditor":{"type":"topic","title":"Running Code in the Godot Editor","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","abstract":[{"text":"There are cases where you might want some of your Swift code for your extension","type":"text"},{"text":" ","type":"text"},{"text":"to run while it is being used in the Godot Editor.","type":"text"}],"kind":"article","url":"\/documentation\/swiftgodot\/runningineditor","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Exports":{"kind":"article","abstract":[{"type":"text","text":"In Godot, class members can be exported. This means their value gets saved along"},{"type":"text","text":" "},{"type":"text","text":"with the resource (such as the scene) they’re attached to. They will also be"},{"type":"text","text":" "},{"type":"text","text":"available for editing in the property editor. Exporting is done by using the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Export"},{"type":"text","text":" annotation."}],"url":"\/documentation\/swiftgodot\/exports","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports","type":"topic","title":"Exports","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Node/queueFree()":{"title":"queueFree()","type":"topic","url":"\/documentation\/swiftgodot\/node\/queuefree()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queueFree","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Queues this node to be deleted at the end of the current frame. When deleted, all of its children are deleted as well, and all references to the node and its children become invalid."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node\/queueFree()"},"doc://SwiftGodot/documentation/SwiftGodot/RemoteProcedureCalls":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RemoteProcedureCalls","url":"\/documentation\/swiftgodot\/remoteprocedurecalls","title":"Remote Procedure Calls","kind":"article","role":"article","abstract":[{"text":"Use the ","type":"text"},{"code":"@Rpc","type":"codeVoice"},{"text":" macro to configure methods for Godot’s multiplayer RPC system.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Documentation":{"type":"topic","url":"\/documentation\/swiftgodot\/documentation","kind":"article","title":"Documenting your Godot Extension","abstract":[{"type":"text","text":"If you are developing a Godot extension that is intended to be consumed from"},{"type":"text","text":" "},{"type":"text","text":"Godot you might want to provide documentation for it."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Documentation","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Image":{"title":"Image","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Image","url":"\/documentation\/swiftgodot\/image","kind":"symbol","role":"symbol",