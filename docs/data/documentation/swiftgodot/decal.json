distanceFadeLength"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/distanceFadeLength","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The distance over which the Decal fades (in 3D units). The Decal becomes slowly more transparent over this distance and is completely invisible at the end. Higher values result in a smoother fade-out transition, which is more suited when the camera moves fast."}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Color":{"type":"topic","url":"\/documentation\/swiftgodot\/color","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Color","kind":"identifier"}],"navigatorTitle":[{"text":"Color","kind":"identifier"}],"abstract":[{"type":"text","text":"A color represented in RGBA format."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Color","title":"Color"},"doc://SwiftGodot/documentation/SwiftGodot/Decal/normalFade":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalFade"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"kind":"symbol","url":"\/documentation\/swiftgodot\/decal\/normalfade","abstract":[{"text":"Fades the Decal if the angle between the Decal’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AABB"},{"text":" and the target surface becomes too large. A value of ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":" projects the Decal regardless of angle, a value of "},{"type":"codeVoice","code":"1"},{"type":"text","text":" limits the Decal to surfaces that are nearly perpendicular."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/normalFade","type":"topic","title":"normalFade"},"doc://SwiftGodot/documentation/SwiftGodot/AABB":{"navigatorTitle":[{"text":"AABB","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/aabb","title":"AABB","kind":"symbol","abstract":[{"type":"text","text":"A 3D axis-aligned bounding box."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AABB","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"AABB","kind":"identifier"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Decal/albedoMix":{"title":"albedoMix","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"albedoMix","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/albedoMix","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/decal\/albedomix","abstract":[{"text":"Blends the albedo ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Color","isActive":true},{"type":"text","text":" of the decal with albedo "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Color","type":"reference"},{"type":"text","text":" of the underlying mesh. This can be set to "},{"code":"0.0","type":"codeVoice"},{"type":"text","text":" to create a decal that only affects normal or ORM. In this case, an albedo texture is still required as its alpha channel will determine where the normal and ORM will be overridden. See also "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/modulate"},{"type":"text","text":"."}]},"doc://SwiftGodot/documentation/SwiftGodot/Decal/upperFade":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"upperFade"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Sets the curve over which the decal will fade as the surface gets further from the center of the "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AABB","type":"reference"},{"type":"text","text":". Only positive values are valid (negative values will be clamped to "},{"type":"codeVoice","code":"0.0"},{"text":"). See also ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/lowerFade"},{"type":"text","text":"."}],"title":"upperFade","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/upperFade","type":"topic","kind":"symbol","url":"\/documentation\/swiftgodot\/decal\/upperfade"},"doc://SwiftGodot/documentation/SwiftGodot/Decal/size":{"url":"\/documentation\/swiftgodot\/decal\/size","role":"symbol","kind":"symbol","title":"size","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"size","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot7Vector3V","text":"Vector3"}],"abstract":[{"type":"text","text":"Sets the size of the "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AABB","type":"reference"},{"type":"text","text":" used by the decal. All dimensions must be set to a value greater than zero (they will be clamped to "},{"type":"codeVoice","code":"0.001"},{"type":"text","text":" if this is not the case). The AABB goes from "},{"type":"codeVoice","code":"-size\/2"},{"type":"text","text":" to "},{"code":"size\/2","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/size"},"doc://SwiftGodot/documentation/SwiftGodot/Decal/godotClassName":{"title":"godotClassName","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/godotClassName","type":"topic","abstract":[],"kind":"symbol","url":"\/documentation\/swiftgodot\/deca