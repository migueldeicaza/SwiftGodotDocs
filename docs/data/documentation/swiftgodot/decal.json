/textureAlbedo","type":"topic","role":"symbol","abstract":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2D"},{"type":"text","text":" with the base "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Color"},{"type":"text","text":" of the Decal. Either this or the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/textureEmission"},{"type":"text","text":" must be set for the Decal to be visible. Use the alpha channel like a mask to smoothly blend the edges of the decal with the underlying object."}],"url":"\/documentation\/swiftgodot\/decal\/texturealbedo"},"doc://SwiftGodot/documentation/SwiftGodot/Decal/textureNormal":{"type":"topic","title":"textureNormal","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"textureNormal"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Texture2D","preciseIdentifier":"s:10SwiftGodot9Texture2DC"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/swiftgodot\/decal\/texturenormal","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/textureNormal","abstract":[{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Texture2D","type":"reference"},{"text":" with the per-pixel normal map for the decal. Use this to add extra detail to decals.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Camera3D":{"abstract":[{"type":"text","text":"Camera node, displays from a point of view."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Camera3D"}],"title":"Camera3D","kind":"symbol","url":"\/documentation\/swiftgodot\/camera3d","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D","navigatorTitle":[{"text":"Camera3D","kind":"identifier"}],"role":"symbol"},"do