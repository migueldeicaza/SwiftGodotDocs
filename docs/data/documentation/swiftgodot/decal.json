the decal. Use this to add extra detail to decals."}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/textureOrm"},"doc://SwiftGodot/documentation/SwiftGodot/Decal/cullMask":{"role":"symbol","title":"cullMask","url":"\/documentation\/swiftgodot\/decal\/cullmask","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"cullMask"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt32V","text":"UInt32","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Specifies which "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VisualInstance3D\/layers","type":"reference","isActive":true},{"text":" this decal will project on. By default, Decals affect all layers. This is used so you can specify which types of objects receive the Decal and which do not. This is especially useful so you can ensure that dynamic objects don’t accidentally receive a Decal intended for the terrain under them.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/cullMask"},"doc://SwiftGodot/s23CustomStringConvertibleP":{"title":"Swift.CustomStringConvertible","type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/s23CustomStringConvertibleP"},"doc://SwiftGodot/documentation/SwiftGodot/Decal/modulate":{"title":"modulate","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"modulate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Color","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot5ColorV"}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/modulate","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/decal\/modulate","abstract":[{"type":"text","text":"Changes the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Color"},{"type":"text","text":" of the Decal by multiplying the albedo and emission colors with this value. The alpha component is only taken into account when multiplying the albedo color, not the emission color. See also "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/emissionEnergy"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/albedoMix"},{"text":" to change the emission and albedo intensity independently of each other.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/Decal/emissionEnergy":{"title":"emissionEnergy","url":"\/documentation\/swiftgodot\/decal\/emissionenergy","abstract":[{"type":"text","text":"Energy multiplier for the emission texture. This will make the decal emit light at a higher or lower intensity, independently of the albedo color. See also "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/modulate","isActive":true,"type":"reference"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Decal\/emissionEnergy","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"emissionEnergy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Resource":{"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Resource"}],"role":"symbol","url":"\/documentation\/swiftgodot\/resource","abstract":[{"type":"text","text":"Base class for serializable objects."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource","title":"Resource","navigatorTitle":[{"kind":"identifier","text":"Resource"}]},"doc://SwiftGodot/documentation/SwiftGodot/GeometryInstance3D/extraCullMargin":{"role":"symbol","url":"\/documentation\/swiftgodot\/geometryinstance3d\/ex