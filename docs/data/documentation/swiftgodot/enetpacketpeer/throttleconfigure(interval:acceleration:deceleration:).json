{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/enetpacketpeer\/throttleconfigure(interval:acceleration:deceleration:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/throttleConfigure(interval:acceleration:deceleration:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Configures throttle parameter for a peer."}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throttleConfigure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"interval","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int32","kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V"},{"text":", ","kind":"text"},{"text":"acceleration","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int32","preciseIdentifier":"s:s5Int32V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"deceleration","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int32","preciseIdentifier":"s:s5Int32V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Unreliable packets are dropped by ENet in response to the varying conditions of the Internet connection to the peer. The throttle represents a probability that an unreliable packet should not be dropped and thus sent by ENet to the peer. By measuring fluctuations in round trip times of reliable packets over the specified "},{"code":"interval","type":"codeVoice"},{"type":"text","text":", ENet will either increase the probability by the amount specified in the "},{"code":"acceleration","type":"codeVoice"},{"type":"text","text":" parameter, or decrease it by the amount specified in the "},{"code":"deceleration","type":"codeVoice"},{"type":"text","text":" parameter (both are ratios to "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/packetThrottleScale","type":"reference"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"When the throttle has a value of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/packetThrottleScale","type":"reference"},{"text":", no unreliable packets are dropped by ENet, and so 100% of all unreliable packets will be sent.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the throttle has a value of "},{"type":"codeVoice","code":"0"},{"type":"text","text":", all unreliable packets are dropped by ENet, and so 0% of all unreliable packets will be sent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Intermediate values for the throttle represent intermediate probabilities between 0% and 100% of unreliable packets being sent. The bandwidth limits of the local and foreign hosts are taken into account to determine a sensible limit for the throttle probability above which it should not raise even in the best of conditions."}],"type":"paragraph"}]}],"metadata":{"symbolKind":"method","externalID":"s:10SwiftGodot14ENetPacketPeerC17throttleConfigure8interval12acceleration12decelerationys5Int32V_A2ItF","title":"throttleConfigure(interval:acceleration:deceleration:)","modules":[{"name":"SwiftGodot"}],"roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"throttleConfigure"},{"kind":"text","text":"("},{"kind":"externalParam","text":"interval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"kind":"text","text":", "},{"kind":"externalParam","text":"acceleration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deceleration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"kind":"text","text":")"}]},"references":{"doc://SwiftGodot/documentation/SwiftGodot/ENetPacketPeer/throttleConfigure(interval:acceleration:deceleration:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"throttleConfigure"},{"kind":"text","text":"("},{"kind":"externalParam","text":"interval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int32","preciseIdentifier":"s:s5Int32V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"acceleration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int32","preciseIdentifier":"s:s5Int32V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deceleration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int32","preciseIdentifier":"s:s5Int32V"},{"kind":"text","text":")"}],"role":"symbol","abstract":[{"type":"text","text":"Configures throttle parameter for a peer."}],"url":"\/documentation\/swiftgodot\/enetpacketpeer\/throttleconfigure(interval:acceleration:deceleration:)","title":"throttleConfigure(interval:acceleration:deceleration:)","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/throttleConfigure(interval:acceleration:deceleration:)"},"doc://SwiftGodot/documentation/SwiftGodot/ENetPacketPeer/packetThrottleScale":{"title":"packetThrottleScale","type":"topic","url":"\/documentation\/swiftgodot\/enetpacketpeer\/packetthrottlescale","abstract":[{"text":"The reference value for throttle configuration. The default value is ","type":"text"},{"type":"codeVoice","code":"32"},{"text":". See ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/throttleConfigure(interval:acceleration:deceleration:)","isActive":true},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/packetThrottleScale","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"packetThrottleScale","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"}]},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/ENetPacketPeer":{"type":"topic","title":"ENetPacketPeer","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ENetPacketPeer","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/enetpacketpeer","role":"symbol","navigatorTitle":[{"text":"ENetPacketPeer","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer","abstract":[{"text":"A wrapper class for an ","type":"text"},{"text":"ENetPeer","type":"text"},{"text":".","type":"text"}],"kind":"symbol"}}}