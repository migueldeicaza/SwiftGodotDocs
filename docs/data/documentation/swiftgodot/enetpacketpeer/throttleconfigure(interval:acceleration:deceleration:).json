{"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/throttleConfigure(interval:acceleration:deceleration:)","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftGodot"}],"title":"throttleConfigure(interval:acceleration:deceleration:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"throttleConfigure"},{"kind":"text","text":"("},{"text":"interval","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int32","preciseIdentifier":"s:s5Int32V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"acceleration","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int32","preciseIdentifier":"s:s5Int32V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deceleration"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"text":")","kind":"text"}],"externalID":"s:10SwiftGodot14ENetPacketPeerC17throttleConfigure8interval12acceleration12decelerationys5Int32V_A2ItF","roleHeading":"Instance Method","symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"throttleConfigure","kind":"identifier"},{"text":"(","kind":"text"},{"text":"interval","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"text":", ","kind":"text"},{"text":"acceleration","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int32","preciseIdentifier":"s:s5Int32V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"deceleration"},{"kind":"text","text":": "},{"text":"Int32","kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V"},{"text":")","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unreliable packets are dropped by ENet in response to the varying conditions of the Internet connection to the peer. The throttle represents a probability that an unreliable packet should not be dropped and thus sent by ENet to the peer. By measuring fluctuations in round trip times of reliable packets over the specified "},{"type":"codeVoice","code":"interval"},{"text":", ENet will either increase the probability by the amount specified in the ","type":"text"},{"type":"codeVoice","code":"acceleration"},{"type":"text","text":" parameter, or decrease it by the amount specified in the "},{"type":"codeVoice","code":"deceleration"},{"text":" parameter (both are ratios to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/packetThrottleScale"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the throttle has a value of "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/packetThrottleScale","isActive":true},{"type":"text","text":", no unreliable packets are dropped by ENet, and so 100% of all unreliable packets will be sent."}]},{"type":"paragraph","inlineContent":[{"text":"When the throttle has a value of ","type":"text"},{"code":"0","type":"codeVoice"},{"text":", all unreliable packets are dropped by ENet, and so 0% of all unreliable packets will be sent.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Intermediate values for the throttle represent intermediate probabilities between 0% and 100% of unreliable packets being sent. The bandwidth limits of the local and foreign hosts are taken into account to determine a sensible limit for the throttle probability above which it should not raise even in the best of conditions."}],"type":"paragraph"}]}],"abstract":[{"text":"Configures throttle parameter for a peer.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftgodot\/enetpacketpeer\/throttleconfigure(interval:acceleration:deceleration:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer"]]},"sections":[],"references":{"doc://SwiftGodot/documentation/SwiftGodot/ENetPacketPeer/throttleConfigure(interval:acceleration:deceleration:)":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer\/throttleConfigure(interval:acceleration:deceleration:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"throttleConfigure","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"interval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"acceleration"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"deceleration"},{"text":": ","kind":"text"},{"text":"Int32","kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V"},{"kind":"text","text":")"}],"type":"topic","url":"\/documentation\/swiftgodot\/enetpacketpeer\/throttleconfigure(interval:acceleration:deceleration:)","kind":"symbol","title":"throttleConfigure(interval:acceleration:deceleration:)","abstract":[{"text":"Configures throttle parameter for a peer.","type":"text"}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/ENetPacketPeer":{"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ENetPacketPeer","role":"symbol","title":"ENetPacketPeer","url":"\/documentation\/swiftgodot\/enetpacketpeer","abstract":[{"type":"text","text":"A wrap