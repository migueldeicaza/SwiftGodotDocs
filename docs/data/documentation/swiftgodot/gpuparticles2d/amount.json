{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D"]]},"abstract":[{"text":"The number of particles to emit in one emission cycle. The effective emission rate is ","type":"text"},{"code":"(amount * amount_ratio) \/ lifetime","type":"codeVoice"},{"text":" particles per second. Higher values will increase GPU requirements, even if not all particles are visible at a given time or if ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D\/amountRatio","isActive":true,"type":"reference"},{"text":" is decreased.","type":"text"}],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amount","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int32","preciseIdentifier":"s:s5Int32V","kind":"typeIdentifier"}],"title":"amount","symbolKind":"property","externalID":"s:10SwiftGodot14GPUParticles2DC6amounts5Int32Vvp","roleHeading":"Instance Property","role":"symbol","modules":[{"name":"SwiftGodot"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/gpuparticles2d\/amount"]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D\/amount","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"amount"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5Int32V","text":"Int32"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"content":[{"inlineContent":[{"type":"text","text":"Changing this value will cause the particle system to restart. To avoid this, change "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D\/amountRatio","type":"reference","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"}],"kind":"content"}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/GPUParticles2D/amountRatio":{"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D\/amountRatio","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"amountRatio","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"The ratio of particles that should actually be emitted. If set to a value lower than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":", this will set the amount of emitted particles throughout the lifetime to "},{"type":"codeVoice","code":"amount * amount_ratio"},{"type":"text","text":". Unlike changing "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D\/amount","isActive":true},{"type":"text","text":", changing "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D\/amountRatio","isActive":true},{"type":"text","text":" while emitting does not affect already-emitted particles and doesn’t cause the particle system to restart. "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GPUParticles2D\/amountRatio","isActive":true},{"type":"text","text":" can be used to create effects that make the number of emitted particles vary over time."}],"url":"\/documentation\/swiftgodot\/gpuparticles2d\/amountratio","title":"amountRatio","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/GPUParticles2D/amount":{"u