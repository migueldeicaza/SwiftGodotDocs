{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dampingRelaxation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"modules":[{"name":"SwiftGodot"}],"role":"symbol","roleHeading":"Instance Property","title":"dampingRelaxation","symbolKind":"property","externalID":"s:10SwiftGodot14VehicleWheel3DC17dampingRelaxationSdvp"},"abstract":[{"type":"text","text":"The damping applied to the suspension spring when rebounding or extending, meaning when the wheel is moving down relative to the vehicle. It is measured in Newton-seconds per millimeter (N⋅s\/mm), or megagrams per second (Mg\/s). This value should be between 0.0 (no damping) and 1.0, but may be more. This value should always be slightly higher than the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},{"type":"text","text":" property. For a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},{"type":"text","text":" value of 0.3, try a relaxation value of 0.5."}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dampingRelaxation","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D"]]},"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingRelaxation","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftgodot\/vehiclewheel3d\/dampingrelaxation"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/dampingCompression":{"title":"dampingCompression","type":"topic","abstract":[{"text":"The damping applied to the suspension spring when being compressed, meaning when the wheel is moving up relative to the vehicle. It is measured in Newton-seconds per millimeter (N⋅s\/mm), or megagrams per second (Mg\/s). This value should be between 0.0 (no damping) and 1.0, but may be more. A value of 0.0 means the car will keep bouncing as the spring keeps its energy. A good value for this is around 0.3 for a normal car, 0.5 for a race car.","type":"text"}],"url":"\/documentation\/swiftgodot\/vehiclewheel3d\/dampingcompression","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dampingCompression"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleBody3D":{"url":"\/documentation\/swiftgodot\/vehiclebody3d","title":"VehicleBody3D","abstract":[{"type":"text","text":"A 3D physics body that simulates the behavior of a car."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VehicleBody3D","kind":"identifier"}],"navigatorTitle":[{"text":"VehicleBody3D","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D":{"navigatorTitle":[{"text":"VehicleWheel3D","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftgodot\/vehiclewheel3d","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D","role":"symbol","abstract":[{"text":"A 3D physics body for a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleBody3D","type":"reference"},{"text":" that simulates the behavior of a wheel.","type":"text"}],"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VehicleWheel3D","kind":"identifier"}],"title":"VehicleWheel3D"},"doc://SwiftGodot/documentation/SwiftGodot/VehicleWheel3D/dampingRelaxation":{"title":"dampingRelaxation","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"dampingRelaxation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"abstract":[{"type":"text","text":"The damping applied to the suspension spring when rebounding or extending, meaning when the wheel is moving down relative to the vehicle. It is measured in Newton-seconds per millimeter (N⋅s\/mm), or megagrams per second (Mg\/s). This value should be between 0.0 (no damping) and 1.0, but may be more. This value should always be slightly higher than the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},{"type":"text","text":" property. For a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingCompression"},{"type":"text","text":" value of 0.3, try a relaxation value of 0.5."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VehicleWheel3D\/dampingRelaxation","url":"\/documentation\/swiftgodot\/vehiclewheel3d\/dampingrelaxation"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"}}}