{"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Exports"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signals","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RunningInEditor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MemoryManagement","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/TypesTranslation"],"title":"Articles and Tutorials","anchor":"Articles-and-Tutorials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/exports"]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"abstract":[{"type":"text","text":"In Godot, class members can be exported. This means their value gets saved along"},{"type":"text","text":" "},{"type":"text","text":"with the resource (such as the scene) they’re attached to. They will also be"},{"type":"text","text":" "},{"text":"available for editing in the property editor. Exporting is done by using the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Export"},{"type":"text","text":" annotation."}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This document deals with exporting properties, for information about exposing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"functions to the Godot world, see the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes"},{"type":"text","text":" document."}]},{"level":2,"text":"Introduction to Exports","anchor":"Introduction-to-Exports","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way of exporting a variable is to annotate it with the "},{"type":"codeVoice","code":"@Export"},{"text":" ","type":"text"},{"type":"text","text":"attribute, like this:"}]},{"syntax":"swift","code":["import SwiftGodot","","@Godot","public class ExportExample: Node3D","{","    @Export","    var number = 5","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"In that example the value 5 will be saved, and after building the current","type":"text"},{"text":" ","type":"text"},{"text":"project it will be visible in the property editor.","type":"text"}]},{"inlineContent":[{"text":"One of the fundamental benefits of exporting member variables is to have them","type":"text"},{"type":"text","text":" "},{"type":"text","text":"visible and editable in the editor. This way, artists and game designers can"},{"text":" ","type":"text"},{"text":"modify values that later influence how the program runs. For this, a special export syntax is provided.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"@Export","type":"codeVoice"},{"type":"text","text":" can be applied to non-static, non-class variables with following types:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible"},{"text":" types and their ","type":"text"},{"code":"Optional","type":"codeVoice"},{"type":"text","text":"s such as:"},{"text":" ","type":"text"},{"type":"text","text":"1.1. Swift primitive types ("},{"code":"Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"String","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"code":"Double","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Float"},{"type":"text","text":", any width signed and unsigned version "},{"type":"codeVoice","code":"BinaryInteger"},{"text":" (such as ","type":"text"},{"type":"codeVoice","code":"UInt32"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Int64"},{"text":").","type":"text"},{"type":"text","text":" "},{"text":"1.2. All builtin Godot types present in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot"},{"type":"text","text":", such as "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Vector3","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Callable","type":"reference"},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Signal","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"1.3. All "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","type":"reference"},{"text":"-derived types including your own types.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"1.4. Your custom "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible","isActive":true,"type":"reference"},{"text":" types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any Swift closures taking "},{"type":"codeVoice","code":"VariantConvertible"},{"text":" arguments and returning ","type":"text"},{"code":"Void","type":"codeVoice"},{"type":"text","text":" or "},{"code":"VariantConvertible","type":"codeVoice"},{"text":" value without ","type":"text"},{"type":"codeVoice","code":"async"},{"type":"text","text":" specifier."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Any "},{"type":"codeVoice","code":"CaseIterable"},{"text":" enum having integer ","type":"text"},{"code":"RawValue","type":"codeVoice"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"@Export"},{"text":" macro only works in your ","type":"text"},{"type":"codeVoice","code":"@Godot"},{"type":"text","text":" class declaration, and will not work on Swift class extensions."}]},{"syntax":"swift","code":["\/\/ Correct","@Godot","class YourClass {","    @Export var int = 42","}","","\/\/ Incorrect","extension YourClass {","    @Export var anotherInt = 48","}"],"type":"codeListing"},{"type":"heading","level":3,"text":"Basic Usage","anchor":"Basic-Usage"},{"type":"codeListing","syntax":"swift","code":["@Export","var number: Int","","@Export","var anotherNumber { get { ... } set { ... } }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Exported members can specify a default value:"}]},{"code":["@Export","var number: Int = 0","","@Export","var text: String? = nil        \/\/ Allows for nil","","@Export","var greeting = \"Hello World\"   \/\/ Exported field specifies a default value"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Resources and nodes can be exported."}],"type":"paragraph"},{"syntax":"swift","code":["@Export","public var resource: Resource { ","    get { ","        return myInternalResource","    } ","    set { ","        print (\"Setting my resource\")","    } ","}","","@Export","public var node: Node { ","    get { ","        return myInternalNode","    } ","    set { ","        print (\"Setting the node\")","    } ","}"],"type":"codeListing"},{"type":"heading","level":3,"text":"Grouping Exports","anchor":"Grouping-Exports"},{"type":"paragraph","inlineContent":[{"text":"It is possible to group your exported properties inside the Godot Inspector with","type":"text"},{"type":"text","text":" "},{"text":"the #exportGroup macro. Every exported property after this annotation will be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"added to the group.  Start a new group or use #export_group (””) to break out."}]},{"type":"codeListing","syntax":"swift","code":["#exportGroup(\"My Properties\")","@Export var number = 3"]},{"type":"paragraph","inlineContent":[{"text":"You can also specifiy that only properties with a given prefix be grouped, like","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this:"}]},{"type":"codeListing","syntax":"swift","code":["#exportGroup(\"My Properties\", prefix: \"health\")","@Export var health_reload_speed = 3"]},{"inlineContent":[{"type":"text","text":"Groups cannot be nested, use #exportSubgroup to create subgroups within a group."}],"type":"paragraph"},{"code":["#exportSubgroup(\"Extra Properties\")","#export var string = \"\"","#export var flag = false"],"syntax":"swift","type":"codeListing"},{"anchor":"Customizing-the-Exported-Value","type":"heading","text":"Customizing the Exported Value","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can pass a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PropertyHint"},{"text":" parameter to the Export attribute, along with additional","type":"text"},{"type":"text","text":" "},{"text":"data to control how the property is surfaced in the editor.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, to surface the property as a file and trigger the file selector in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"UI, use the "},{"code":".file","type":"codeVoice"},{"type":"text","text":" value:"}]},{"type":"codeListing","syntax":"swift","code":["@Export(.file)","var GameFile: String? "]},{"type":"paragraph","inlineContent":[{"type":"text","text":"String as a path to a directory."}]},{"syntax":"swift","type":"codeListing","code":["@Export(.dir)","var gameDirectory: String?"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"String as a path to a file, custom filter provided as hint."}]},{"type":"codeListing","syntax":"swift","code":["@Export (.file, \"*.txt\")","var GameFile: String?"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using paths in the global filesystem is also possible, but only in scripts in tool mode."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"String as a path to a PNG file in the global filesystem."}]},{"code":["@Export (.globalFile, \"*.png\")","var toolImage: String?"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"String as a path to a directory in the global filesystem."}],"type":"paragraph"},{"syntax":"swift","code":["@Export (.globalDir)","var toolDir: String?"],"type":"codeListing"},{"inlineContent":[{"text":"The multiline annotation tells the editor to show a large input field for editing over multiple lines.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Export (.multilineText)","var text: String?"],"type":"codeListing"},{"anchor":"Limiting-editor-input-ranges","level":3,"type":"heading","text":"Limiting editor input ranges"},{"inlineContent":[{"type":"text","text":"Using the range property hint allows you to limit what can be input as a value using the editor."}],"type":"paragraph"},{"inlineContent":[{"text":"Allow integer values from 0 to 20.","type":"text"}],"type":"paragraph"},{"code":["@Export(.range, \"0,20,\")","var number: Int = 0"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Allow integer values from -10 to 20.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Export(.range, \"-10,20,\")","var number: Int =  0"]},{"inlineContent":[{"type":"text","text":"Allow floats from -10 to 20 and snap the value to multiples of 0.2."}],"type":"paragraph"},{"code":["@Export(.range, \"-10,20,0.2\")","var number = 0"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you add the hints "},{"code":"or_greater","type":"codeVoice"},{"text":" and\/or ","type":"text"},{"type":"codeVoice","code":"or_less"},{"type":"text","text":" you can go above or below the limits when"},{"type":"text","text":" "},{"text":"adjusting the value by typing it instead of using the slider.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Export(.range, \"0,100,1,or_greater,or_less\")","var number: Int = 0"]},{"text":"Floats with easing hint","anchor":"Floats-with-easing-hint","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Display a visual representation of the "},{"code":"ease()","type":"codeVoice"},{"type":"text","text":" function when editing."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Export(.expEasing)","public transitionSpeed: Float = 0"]},{"level":3,"type":"heading","text":"Colors","anchor":"Colors"},{"inlineContent":[{"text":"Regular color given as red-green-blue-alpha value.","type":"text"}],"type":"paragraph"},{"code":["@Export","var color: Color { get {} set {} }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Color given as red-green-blue value (alpha will always be 1).","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Export(.colorNoAlpha)","var color: Color { get {} set {} }"],"type":"codeListing"},{"type":"heading","text":"Nodes","anchor":"Nodes","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since Godot 4.0, nodes can be directly exported without having to use NodePaths."}]},{"type":"codeListing","syntax":"swift","code":["@Export","public Node node { get; set; }"]},{"inlineContent":[{"text":"Custom node classes can also be used, see C# global classes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Exporting NodePaths like in Godot 3.x is still possible, in case you need it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["@Export","var nodePath: NodePath","","public override func _ready() ","{","    var node = GetNode(nodePath)","}"],"syntax":"swift"},{"inlineContent":[{"text":"Subclasses of ","type":"text"},{"type":"codeVoice","code":"Node"},{"text":" type will have their ","type":"text"},{"type":"codeVoice","code":".nodeType"},{"text":" automatically filled, so that Editor will allow","type":"text"},{"type":"text","text":" "},{"type":"text","text":"only "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Camera3D"},{"type":"text","text":" subtypes to be set to the following exported property:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Export \/\/ no need to write @Export(.nodeType, \"Camera3D\")","var camera: Camera3D? = nil"]},{"type":"heading","text":"Resources","anchor":"Resources","level":3},{"type":"codeListing","syntax":"swift","code":["@Export","var resource: Resource { get {} set {} }"]},{"inlineContent":[{"text":"In the Inspector, you can then drag and drop a resource file from the FileSystem dock into the variable slot.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Opening the inspector dropdown may result in an extremely long list of possible classes to create, however."},{"text":" ","type":"text"},{"type":"text","text":"Therefore, if you specify a type derived from Resource such as:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Export","var resource: AnimationNode"]},{"type":"paragraph","inlineContent":[{"text":"The drop-down menu will be limited to ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationNode","type":"reference","isActive":true},{"type":"text","text":" and all its inherited classes."},{"type":"text","text":" "},{"text":"Custom resource classes can also be used, see Swift global classes.","type":"text"}]},{"inlineContent":[{"text":"It must be noted that even if the script is not being run while in the editor, the exported","type":"text"},{"type":"text","text":" "},{"type":"text","text":"properties are still editable. This can be used in conjunction with a script in “tool” mode."}],"type":"paragraph"},{"anchor":"Arrays","level":3,"type":"heading","text":"Arrays"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To surface arrays in Godot, use a strong type for it, for example:"}]},{"code":["@Export","var myResources: TypedArray<Vector3>"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, if you want to surface an array of Godot objects, or even your own subclasses of those, use "},{"type":"codeVoice","code":"TypedArray<YourCustomType?>"},{"type":"text","text":", for example:"}]},{"code":["@Export","var myNodes: TypedArray<MySpinnerCube?>"],"syntax":"swift","type":"codeListing"},{"anchor":"%E2%9A%A0%EF%B8%8F-Note-%E2%9A%A0%EF%B8%8F","type":"heading","text":"⚠️ Note ⚠️","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Object"},{"type":"text","text":" derived types require optional "},{"code":"Element","type":"codeVoice"},{"type":"text","text":" type."},{"type":"text","text":" "},{"text":"That’s due to Godot absence of guarantee that that ","type":"text"},{"type":"codeVoice","code":"Array[Object]"},{"text":" doesn’t contain ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":"s."}]},{"anchor":"Enumeration-Values","text":"Enumeration Values","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To surface enumeration values, you need to use a "},{"code":"CaseIterable","type":"codeVoice"},{"type":"text","text":" enum with "},{"code":"RawValue","type":"codeVoice"},{"text":" conforming to ","type":"text"},{"code":"BinaryInteger","type":"codeVoice"}]},{"syntax":"swift","code":["enum MyEnum: Int, CaseIterable {","    case first","    case second","}","","@Godot","class Sample: Node {","    @Export \/\/ no need to use @Export(.enum), it will be filled automatically","    var myValue: MyEnum","}"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","modules":[{"name":"SwiftGodot"}],"title":"Exports","roleHeading":"Article"},"references":{"doc://SwiftGodot/documentation/SwiftGodot/VariantConvertible":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"VariantConvertible"}],"role":"symbol","title":"VariantConvertible","url":"\/documentation\/swiftgodot\/variantconvertible","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantConvertible"}],"type":"topic","abstract":[{"text":"Protocol for types that can be converted to and from ","type":"text"},{"type":"codeVoice","code":"Variant?"},{"text":" aka ","type":"text"},{"type":"codeVoice","code":"Godot Variant"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"Default implementations are provided for most of the functions.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Example of implementation:"}]},"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Signal":{"role":"symbol","kind":"symbol","url":"\/documentation\/swiftgodot\/signal","abstract":[{"type":"text","text":"A built-in type representing a signal of an "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","isActive":true,"type":"reference"},{"type":"text","text":"."}],"title":"Signal","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Signal","kind":"identifier"}],"navigatorTitle":[{"text":"Signal","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/Swif