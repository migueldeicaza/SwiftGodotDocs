g nodes from a scene in your code. In"},{"type":"text","text":" "},{"text":"GDScript, that is usually achieved by using the dollar sign and the name of the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"object you want to reference."}],"kind":"article","url":"\/documentation\/swiftgodot\/bindingnodes","type":"topic","title":"Referencing Nodes from your Scene","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/BindingNodes","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/Differences":{"kind":"article","type":"topic","title":"SwiftGodot API differences to GDScript","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Differences","url":"\/documentation\/swiftgodot\/differences","role":"article","abstract":[{"type":"text","text":"This document lists some common differences between GDSscript and SwiftGodot."}]},"doc://SwiftGodot/documentation/SwiftGodot/Variants":{"abstract":[{"type":"text","text":"Follow up on the fundamental building block of Godot’s data types."}],"kind":"article","url":"\/documentation\/swiftgodot\/variants","type":"topic","title":"Variants","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variants","role":"article"},"doc://SwiftGodot/documentation/SwiftGodot/AnimationTree":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationTree","url":"\/documentation\/swiftgodot\/animationtree","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnimationTree"}],"role":"symbol","title":"AnimationTree","abstract":[{"type":"text","text":"A node used for advanced animation transitions in an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationPlayer"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AnimationTree"}]},"doc://SwiftGodot/documentation/SwiftGodot/Object":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Object","url":"\/documentation\/swiftgodot\/object","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Object","kind":"identifier"}],"role":"symbol","title":"Object","abstract":[{"text":"Base class for all other classes in the engine.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Object","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/AnimationNode":{"navigatorTitle":[{"kind":"identifier","text":"AnimationNode"}],"title":"AnimationNode","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnimationNode"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationNode","role":"symbol","kind":"symbol","url":"\/documentation\/swiftgodot\/animationnode","abstract":[{"type":"text","text":"Base class for "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AnimationTree","isActive":true},{"type":"text","text":" nodes. Not related to scene nodes."}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Vector3":{"url":"\/documentation\/swiftgodot\/vector3","title":"Vector3","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Vector3","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Vector3","abstract":[{"type":"text","text":"A 3D vector using floating-point coordinates."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Vector3"}]},"doc://SwiftGodot/documentation/SwiftGodot/CustomTypes":{"kind":"article","type":"topic","title":"Using Custom Types","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CustomTypes","url":"\/documentation\/swiftgodot\/customtypes","role":"article","abstract":[{"type":"text","text":"You will typically extend the functionality of your Godot game by creating"},{"type":"text","text":" "},{"text":"classes that derive from one of the various Godot types and adjust the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"behavior accordingly."}]}}}