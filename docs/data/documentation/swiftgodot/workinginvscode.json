{"abstract":[{"text":"Develop and debug SwiftGodot Code in Visual Studio Code","type":"text"}],"variants":[{"paths":["\/documentation\/swiftgodot\/workinginvscode"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"metadata":{"modules":[{"name":"SwiftGodot"}],"roleHeading":"Article","role":"article","title":"Working in VS Code"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/WorkingInVsCode","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Developing-with-SwiftGodot","title":"Developing with SwiftGodot","identifiers":["doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DebugInXcode"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Visual Studio Code provides a compelling alternative to Xcode for SwiftGodot","type":"text"},{"text":" ","type":"text"},{"text":"developers on Mac, Linux, or Windows.","type":"text"}]},{"anchor":"Prerequisites","type":"heading","level":3,"text":"Prerequisites"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To develop with SwiftGodot in Visual Studio Code, you will need the following"},{"type":"text","text":" "},{"type":"text","text":"prerequisites:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Godot Engine without .NET support from the "},{"type":"reference","identifier":"https:\/\/godotengine.org\/download\/","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Visual Studio Code from the ","type":"text"},{"identifier":"https:\/\/code.visualstudio.com\/Download","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Install Swift from the "},{"identifier":"https:\/\/www.swift.org\/install\/","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"anchor":"Configuring-Visual-Studio-Code","type":"heading","level":3,"text":"Configuring Visual Studio Code"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Swift Extension for Visual Studio Code from the Swift Server Work Group"},{"type":"text","text":" "},{"type":"text","text":"provides code completion, code navigation, build task creation, and integration"},{"type":"text","text":" "},{"type":"text","text":"with LLDB for debugging, along with many other features for devloping code with"},{"type":"text","text":" "},{"type":"text","text":"Swift."}]},{"type":"paragraph","inlineContent":[{"text":"Install the Swift Extension for Visual Studio from the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/marketplace.visualstudio.com\/items?itemName=sswg.swift-lang"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"or search for Swift on the Extensions tab in Visual Studio Code.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Installing the Swift Extension will automatically install the CodeLLDB Extension","type":"text"},{"text":" ","type":"text"},{"text":"as a dependency for Visual Studio Code for debugging support.","type":"text"}]},{"anchor":"Create-a-Swift-library-package-for-your-project","type":"heading","level":3,"text":"Create a Swift library package for your project"},{"type":"paragraph","inlineContent":[{"text":"Create a folder on disk in a file location near the Godot project that you want","type":"text"},{"text":" ","type":"text"},{"text":"to use with SwiftGodot.  For this article, we will assume you are working","type":"text"},{"text":" ","type":"text"},{"text":"against the sample project and code from the ","type":"text"},{"isActive":true,"identifier":"https:\/\/migueldeicaza.github.io\/SwiftGodotDocs\/tutorials\/swiftgodot-tutorials","type":"reference"}]},{"type":"paragraph","inlineContent":[{"text":"On the commmand line, change directories into the folder you created and run the","type":"text"},{"text":" ","type":"text"},{"text":"swift package command to initialize a new library package:","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"swift package init --type library","type":"codeVoice"}]},{"type":"paragraph","inlineContent":[{"text":"You can now open your package folder in Visual Studio Code:","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"code .","type":"codeVoice"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the “Open Folder…” File menu option in Visual Studio Code."}]},{"anchor":"Setup-SwiftGodot-in-Packageswift","type":"heading","level":3,"text":"Setup SwiftGodot in Package.swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside Visual Studio Code, open Package.swift"}]},{"type":"paragraph","inlineContent":[{"text":"Set the minimum platform target to macOS 13 and set your library type to dynamic by adding ","type":"text"},{"code":"type: .dynamic,","type":"codeVoice"},{"text":" to the products library section of your package configuration. E.g.,","type":"text"}]},{"type":"codeListing","code":["platforms: [.macOS(.v13)],","products: [","   .library(","      name: \"SimpleRunnerDriver\",","      type: .dynamic,","      targets: [\"SimpleRunnerDriver\"]),","]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Add the SwiftGodot dependency to your package.","type":"text"}]},{"type":"codeListing","code":["dependencies: [","   .package(url: \"https:\/\/github.com\/migueldeicaza\/SwiftGodot\", branch: \"main\")","],"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Modify your library target to reference the SwitGodot dependency, and add","type":"text"},{"text":" ","type":"text"},{"text":"necessary swift compiler and linker settings:","type":"text"}]},{"type":"codeListing","code":[".target(","   name: \"SimpleRunnerDriver\",","   dependencies: [","         \"SwiftGodot\",","   ],","   swiftSettings: [.unsafeFlags([\"-suppress-warnings\"])]","),"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At this point, you should be able to follow the Meet SwiftGodot Tutorial"},{"type":"text","text":" "},{"type":"text","text":"beginning in Section 2."}]},{"anchor":"Building-your-SwiftGodot-package","type":"heading","level":3,"text":"Building your SwiftGodot package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you are ready to build your SwiftGodot package, the Swift Extension"},{"type":"text","text":" "},{"type":"text","text":"provides a default Build task you can execute with Visual Studio Code’s Build"},{"type":"text","text":" "},{"type":"text","text":"Shortcut - Ctrl+Shift+B (or Cmd+Shift+B on Mac)."}]},{"type":"paragraph","inlineContent":[{"text":"The initial build, especially on Windows, may take a very long time.","type":"text"}]},{"anchor":"Setting-up-your-gdextension","type":"heading","level":3,"text":"Setting up your gdextension"},{"type":"paragraph","inlineContent":[{"text":"When creating your ","type":"text"},{"code":"gdextension","type":"codeVoice"},{"text":" file, your configuration file will need to","type":"text"},{"text":" ","type":"text"},{"text":"contain settings specific to your platform, and you will need to copy the","type":"text"},{"text":" ","type":"text"},{"text":"libraries for your operating system and architecture to the ","type":"text"},{"code":"bin","type":"codeVoice"},{"text":" folder inside","type":"text"},{"text":" ","type":"text"},{"text":"your Godot project.","type":"text"}]},{"anchor":"Windows","type":"heading","level":4,"text":"Windows"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Windows does not deal well with long paths, so you should make sure that you"},{"type":"text","text":" "},{"type":"text","text":"either checkout your SwiftGodot into a toplevel directory, or use the Windows"},{"type":"text","text":" "},{"type":"codeVoice","code":"subst"},{"type":"text","text":" command to map a drive name to the location that contains your"},{"type":"text","text":" "},{"type":"text","text":"SwiftGodot builds."}]},{"type":"paragraph","inlineContent":[{"text":"If you are developing on Windows, your ","type":"text"},{"type":"codeVoice","code":"libraries"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"dependencies"},{"text":" will need","type":"text"},{"text":" ","type":"text"},{"text":"to be specified as ","type":"text"},{"type":"codeVoice","code":"windows.debug.x86_64"},{"text":" and your libraries will be compiled","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"type":"codeVoice","code":".dll"},{"text":" files, so that these sections should look like this:","type":"text"}]},{"type":"codeListing","code":["[libraries]","windows.debug.x86_64 = \"res:\/\/bin\/SimpleRunnerDriver.dll\"","","[dependencies]","windows.debug.x86_64 = {\"res:\/\/bin\/SwiftGodot.dll\" : \"\"}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can copy these files to your Godot projects ","type":"text"},{"code":"bin","type":"codeVoice"},{"text":" folder from the build","type":"text"},{"text":" ","type":"text"},{"text":"output folder located in ","type":"text"},{"code":".build\\x86_64-unknown-windows-msvc\\debug\\","type":"codeVoice"},{"text":" inside","type":"text"},{"text":" ","type":"text"},{"text":"the directory where you initialized your Swift package.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As an additional step on Windows, you will need to copy all of the Swift"},{"type":"text","text":" "},{"type":"text","text":"runtime libraries into the "},{"code":"bin","type":"codeVoice"},{"type":"text","text":" folder with SwiftGodot.dll.  This is means"},{"type":"text","text":" "},{"type":"text","text":"copying all "},{"code":"*.dll","type":"codeVoice"},{"type":"text","text":" files from "},{"code":"C:\\Program Files\\Swift\\runtime-development\\usr\\bin\\","type":"codeVoice"}]},{"anchor":"Linux","type":"heading","level":4,"text":"Linux"},{"type":"paragraph","inlineContent":[{"text":"If you are developing on Linux, your ","type":"text"},{"code":"libraries","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"dependencies","type":"codeVoice"},{"text":" will need","type":"text"},{"text":" ","type":"text"},{"text":"to be specified as ","type":"text"},{"code":"linux.debug.x86_64","type":"codeVoice"},{"text":" and your libraries will be compiled into","type":"text"},{"text":" ","type":"text"},{"code":"lib*.so","type":"codeVoice"},{"text":" files, so that these sections should look like this:","type":"text"}]},{"type":"codeListing","code":["[libraries]","linux.debug.x86_64 = \"res:\/\/bin\/libSimpleRunnerDriver.so\"","","[dependencies]","linux.debug.x86_64 = {\"res:\/\/bin\/libSwiftGodot.so\" : \"\"}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can copy these files to your Godot projects "},{"type":"codeVoice","code":"bin"},{"type":"text","text":" folder from the build"},{"type":"text","text":" "},{"type":"text","text":"output folder located in "},{"type":"codeVoice","code":".build\/x86_64-unknown-linux-gnu\/debug\/"},{"type":"text","text":" inside"},{"type":"text","text":" "},{"type":"text","text":"the directory where you initialized your Swift package."}]},{"anchor":"Debugging-your-SwiftGodot-code","type":"heading","level":3,"text":"Debugging your SwiftGodot code"},{"type":"paragraph","inlineContent":[{"text":"You can debug your SwiftGodot code on Windows or Linux using the","type":"text"},{"text":" ","type":"text"},{"text":"CodeLLDB Extension to launch your game directly from vscode.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In order to do this, you will need to add a Launch","type":"text"},{"text":" ","type":"text"},{"text":"task to your project.","type":"text"},{"text":" ","type":"text"},{"text":"In Visual Sutdio Code, switch to the “Run and Debug” tab.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Create a ","type":"text"},{"code":"launch.json","type":"codeVoice"},{"text":" file by tapping on “create a launch.json file”","type":"text"},{"text":" ","type":"text"},{"text":"and selecting “LLDB”, which should be the first suggested option.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the newly created launch.json file, you should modify the existing"},{"type":"text","text":" "},{"type":"text","text":"lldb task to support launching as follows:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Change the value for ","type":"text"},{"type":"codeVoice","code":"name"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"Launch Godot Game"}]}]},{"content":[{"inlineContent":[{"text":"Add a line for ","type":"text"},{"code":"program","type":"codeVoice"},{"text":" with the path to your Godot executable","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a line for ","type":"text"},{"code":"args","type":"codeVoice"},{"text":" with any necessary arguments to launch your game,","type":"text"},{"text":" ","type":"text"},{"text":"such as the path to your godot project","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"specify the "},{"type":"codeVoice","code":"cwd"},{"type":"text","text":" (current working directory)"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Your launch configuration for lldb should now look like this:","type":"text"}]},{"type":"codeListing","code":["{","   \"type\": \"lldb\",","   \"request\": \"launch\",","   \"name\": \"Launch Godot Game\",","   \"program\": \"path\/to\/your\/Godot\/executable\",","   \"args\": [\"--path\", \"path\/to\/your\/game\/project\"],","   \"cwd\": \"${workspaceFolder}\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you save this file, “Launch Godot Game” will appear as the default debug"},{"type":"text","text":" "},{"type":"text","text":"task in the “Run and Debug” sidebar."},{"type":"text","text":" "},{"type":"text","text":"To run this task, click on the green play button next to"},{"type":"text","text":" "},{"type":"text","text":"“Launch Godot Game” in the “Run and Debug” sidebar."},{"type":"text","text":" "},{"type":"text","text":"This action will launch the game with the LLDB debugger attached."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At this point, Visual Studio Code should now stop on any breakpoints you have"},{"type":"text","text":" "},{"type":"text","text":"set, and you should be able to inspect Variables, set Watches, etc."}]},{"anchor":"Optional-Add-a-Attach-Debug-task","type":"heading","level":4,"text":"(Optional) Add a `Attach` Debug task"},{"items":[{"content":[{"inlineContent":[{"text":"Open the launch.json file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a comma after the last closing brace ","type":"text"},{"type":"codeVoice","code":"}"},{"text":" of the existing configuration.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Paste the following configuration:","type":"text"}]}]}],"type":"orderedList"},{"type":"codeListing","code":["{","    \"type\": \"lldb\",","    \"request\": \"attach\",","    \"name\": \"Attach to PID\",","    \"pid\": \"${command:pickProcess}\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your "},{"type":"codeVoice","code":"launch.json"},{"type":"text","text":" should now look something like this:"}]},{"type":"codeListing","code":["{","   \"version\": \"0.2.0\",","   \"configurations\": [","      {","         \"type\": \"lldb\",","         \"request\": \"launch\",","         \"name\": \"Launch Godot Game\",","         \"program\": \"path\/to\/your\/Godot\/executable\",","         \"args\": [\"--path\", \"path\/to\/your\/game\/project\"],","         \"cwd\": \"${workspaceFolder}\"","      },","      {","         \"type\": \"lldb\",","         \"request\": \"attach\",","         \"name\": \"Attach to PID\",","         \"pid\": \"${command:pickProcess}\"","      }","   ]","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you save this file, “Attach to PID” should appear in the debug options list."}]},{"type":"paragraph","inlineContent":[{"text":"To debug your app using “Attach to PID”, follow these steps:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"First, take note of running Godot process PIDs by running “Attach to PID”","type":"text"},{"text":" ","type":"text"},{"text":"and searching for Godot.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Launch your game from Godot"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Return to Visual Studio and press F5 to run “Attach to PID” again.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Search again for Godot and select the PID for your game, which should be the"},{"type":"text","text":" "},{"type":"text","text":"only process that wasn’t listed in step (1) above."}],"type":"paragraph"}]}],"type":"orderedList"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On Linux or Mac, it may be possible to differentiate your game’s PID from other"},{"type":"text","text":" "},{"type":"text","text":"Godot PIDs by looking at the additional information Visual Studio Code lists about"},{"type":"text","text":" "},{"type":"text","text":"each process, including command line options.  On Windows, the Godot processes are"},{"type":"text","text":" "},{"type":"text","text":"pretty much identical, making it difficult to differentiate your game from the editor."}]}],"type":"aside","name":"Note"},{"style":"warning","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"On Mac, you will need to make your Godot engine debuggable following the steps from","type":"text"},{"text":" ","type":"text"},{"text":"this article ","type":"text"},{"identifier":"https:\/\/migueldeicaza.github.io\/SwiftGodotDocs\/documentation\/swiftgodot\/debuginxcode","isActive":true,"type":"reference"}]}],"type":"aside","name":"Warning"}]}],"kind":"article","references":{"https://marketplace.visualstudio.com/items?itemName=sswg.swift-lang":{"url":"https:\/\/marketplace.visualstudio.com\/items?itemName=sswg.swift-lang","titleInlineContent":[{"type":"text","text":"Visual Studio"},{"type":"text","text":" "},{"type":"text","text":"Marketplace"}],"type":"link","title":"Visual Studio Marketplace","identifier":"https:\/\/marketplace.visualstudio.com\/items?itemName=sswg.swift-lang"},"doc://SwiftGodot/tutorials/SwiftGodot-Tutorials":{"kind":"overview","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials","url":"\/tutorials\/swiftgodot-tutorials","abstract":[{"text":"SwiftGodot allows developers to take new and existing Swift packages and use them as extensions for the Godot game engine.","type":"text"}],"role":"overview","title":"Meet SwiftGodot","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/DebugInXcode":{"url":"\/documentation\/swiftgodot\/debuginxcode","abstract":[{"type":"text","text":"Debug Swift code written for Godot in Xcode."}],"title":"Debug in Xcode","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DebugInXcode","type":"topic","role":"article","kind":"article"},"https://godotengine.org/download/":{"title":"official Godot website","type":"link","titleInlineContent":[{"type":"text","text":"official Godot website"}],"identifier":"https:\/\/godotengine.org\/download\/","url":"https:\/\/godotengine.org\/download\/"},"https://migueldeicaza.github.io/SwiftGodotDocs/documentation/swiftgodot/debuginxcode":{"url":"https:\/\/migueldeicaza.github.io\/SwiftGodotDocs\/documentation\/swiftgodot\/debuginxcode","titleInlineContent":[{"type":"text","text":"Debug in Xcode"}],"type":"link","title":"Debug in Xcode","identifier":"https:\/\/migueldeicaza.github.io\/SwiftGodotDocs\/documentation\/swiftgodot\/debuginxcode"},"https://migueldeicaza.github.io/SwiftGodotDocs/tutorials/swiftgodot-tutorials":{"title":"Meet SwiftGodot Tutorial","type":"link","titleInlineContent":[{"type":"text","text":"Meet SwiftGodot Tutorial"}],"identifier":"https:\/\/migueldeicaza.github.io\/SwiftGodotDocs\/tutorials\/swiftgodot-tutorials","url":"https:\/\/migueldeicaza.github.io\/SwiftGodotDocs\/tutorials\/swiftgodot-tutorials"},"https://www.swift.org/install/":{"url":"https:\/\/www.swift.org\/install\/","titleInlineContent":[{"type":"text","text":"official Swift website"}],"type":"link","title":"official Swift website","identifier":"https:\/\/www.swift.org\/install\/"},"https://code.visualstudio.com/Download":{"title":"official Visual Studio Code website","type":"link","titleInlineContent":[{"type":"text","text":"official Visual Studio Code website"}],"identifier":"https:\/\/code.visualstudio.com\/Download","url":"https:\/\/code.visualstudio.com\/Download"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"}}}