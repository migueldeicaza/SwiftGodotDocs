{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/openxraction"]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OpenXRAction\/actionType-swift.property","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OpenXRAction\/localizedName","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OpenXRAction\/toplevelPaths"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OpenXRAction\/godotClassName"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"},{"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OpenXRAction\/ActionType-swift.enum"],"title":"Enumerations","generated":true,"anchor":"Enumerations"}],"metadata":{"externalID":"s:10SwiftGodot12OpenXRActionC","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenXRAction","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"OpenXRAction"}],"roleHeading":"Class","title":"OpenXRAction","symbolKind":"class","modules":[{"name":"SwiftGodot"}],"role":"symbol"},"abstract":[{"type":"text","text":"An OpenXR action."}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Resource"],"title":"Inherits From"},{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OpenXRAction","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This resource defines an OpenXR action. Actions can be used both for inputs (buttons, joysticks, triggers, etc.) and outputs (haptics).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenXR performs automatic conversion between action type and input type whenever possible. An analog trigger bound to a boolean action will thus return "},{"type":"codeVoice","code":"false"},{"type":"text","text":" if the trigger is depressed and "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if pressed fully."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are not directly bound to specific devices, instead OpenXR recognizes a limited number of top level paths that identify devices by usage. We can restrict which devices an action can be bound to by these top level paths. For instance an action that should only be used for hand held controllers can have the top level paths “\/user\/hand\/left” and “\/user\/hand\/right” associated with them. See the "},{"type":"text","text":"reserved path section in the OpenXR specification"},{"type":"text","text":" for more info on the top level paths."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the name of the resource is used to register the action with."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OpenXRAction"},"references":{"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/Resource":{"