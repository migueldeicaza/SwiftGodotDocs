{"relationshipsSections":[{"kind":"relationships","title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Node3D"]},{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"]}],"abstract":[{"type":"text","text":"3D obstacle used to affect navigation mesh baking or constrain velocities of avoidance controlled agents."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"topicSections":[{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/affectNavigationMesh","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/avoidanceEnabled","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/avoidanceLayers","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/carveNavigationMesh","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/height","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/radius","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/use3dAvoidance","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/velocity","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/vertices"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/getAvoidanceLayerValue(layerNumber:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/getNavigationMap()","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/getRid()","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/setAvoidanceLayerValue(layerNumber:value:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/setNavigationMap(_:)"]},{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/godotClassName"]}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationObstacle3D","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"An obstacle needs a navigation map and outline "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/vertices","type":"reference","isActive":true},{"type":"text","text":" defined to work correctly. The outlines can not cross or overlap and are restricted to a plane projection. This means the y-axis of the vertices is ignored, instead the obstacle’s global y-axis position is used for placement. The projected shape is extruded by the obstacles height along the y-axis."}],"type":"paragraph"},{"inlineContent":[{"text":"Obstacles can be included in the navigation mesh baking process when ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/affectNavigationMesh","type":"reference"},{"text":" is enabled. They do not add walkable geometry, instead their role is to discard other source geometry inside the shape. This can be used to prevent navigation mesh from appearing in unwanted places, e.g. inside “solid” geometry or on top of it. If ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/carveNavigationMesh","type":"reference"},{"text":" is enabled the baked shape will not be affected by offsets of the navigation mesh baking, e.g. the agent radius.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"With ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/avoidanceEnabled"},{"text":" the obstacle can constrain the avoidance velocities of avoidance using agents. If the obstacle’s vertices are wound in clockwise order, avoidance agents will be pushed in by the obstacle, otherwise, avoidance agents will be pushed out. Obstacles using vertices and avoidance can warp to a new position but should not be moved every single frame as each change requires a rebuild of the avoidance map.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftgodot\/navigationobstacle3d"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftGodot"}],"symbolKind":"class","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationObstacle3D","kind":"identifier"}],"externalID":"s:10SwiftGodot20NavigationObstacle3DC","title":"NavigationObstacle3D","navigatorTitle":[{"text":"NavigationObstacle3D","kind":"identifier"}],"roleHeading":"Class"},"kind":"symbol","references":{"doc://SwiftGodot/documentation/SwiftGodot/NavigationServer3D":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"NavigationServer3D"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationServer3D","title":"NavigationServer3D","abstract":[{"type":"text","text":"A server interface for low-level 3D navigation access."}],"url":"\/documentation\/swiftgodot\/navigationserver3d","navigatorTitle":[{"kind":"identifier","text":"NavigationServer3D"}]},"doc://SwiftGodot/SH":{"identifier":"doc:\/\/SwiftGodot\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D/godotClassName":{"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"godotClassName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC","kind":"typeIdentifier","text":"StringName"}],"abstract":[],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/godotClassName","url":"\/documentation\/swiftgodot\/navigationobstacle3d\/godotclassname","title":"godotClassName","kind":"symbol","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D/avoidanceEnabled":{"abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"type":"text","text":" the obstacle affects avoidance using agents."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"avoidanceEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"type":"topic","title":"avoidanceEnabled","url":"\/documentation\/swiftgodot\/navigationobstacle3d\/avoidanceenabled","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/avoidanceEnabled","role":"symbol","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D/vertices":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"vertices","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiftGodotRuntime18PackedVector3ArrayC","text":"PackedVector3Array","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/swiftgodot\/navigationobstacle3d\/vertices","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/vertices","title":"vertices","role":"symbol","kind":"symbol","abstract":[{"text":"The outline vertices of the obstacle. If the vertices are winded in clockwise order agents will be pushed in by the obstacle, else they will be pushed out. Outlines can not be crossed or overlap. Should the vertices using obstacle be warped to a new position agent’s can not predict this movement and may get trapped inside the obstacle.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D/affectNavigationMesh":{"role":"symbol","url":"\/documentation\/swiftgodot\/navigationobstacle3d\/affectnavigationmesh","abstract":[{"type":"text","text":"If enabled and parsed in a navigation mesh baking process the obstacle will discard source geometry inside its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/vertices"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/height"},{"type":"text","text":" defined shape."}],"type":"topic","title":"affectNavigationMesh","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/affectNavigationMesh","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"affectNavigationMesh"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D/setNavigationMap(_:)":{"abstract":[{"text":"Sets the ","type":"text"},{"code":"RID","type":"codeVoice"},{"text":" of the navigation map this NavigationObstacle node should use and also updates the ","type":"text"},{"code":"obstacle","type":"codeVoice"},{"text":" on the NavigationServer.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/setNavigationMap(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setNavigationMap","kind":"identifier"},{"text":"(","kind":"text"},{"text":"RID","preciseIdentifier":"s:17SwiftGodotRuntime3RIDC","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"setNavigationMap(_:)","url":"\/documentation\/swiftgodot\/navigationobstacle3d\/setnavigationmap(_:)","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D/avoidanceLayers":{"url":"\/documentation\/swiftgodot\/navigationobstacle3d\/avoidancelayers","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/avoidanceLayers","role":"symbol","title":"avoidanceLayers","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"avoidanceLayers"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt32V","kind":"typeIdentifier","text":"UInt32"}],"abstract":[{"type":"text","text":"A bitfield determining the avoidance layers for this obstacle. Agents with a matching bit on the their avoidance mask will avoid this obstacle."}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D/carveNavigationMesh":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NavigationObstacle3D\/carveNavigationMesh","abstract":[{"type":"text","text":"If enabled the obstacle vertices will carve into the baked navigation mesh with the shape unaffected by additional offsets (e.g. agent radius)."}],"url":"\/documentation\/swiftgodot\/navigationobstacle3d\/carvenavigationmesh","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"carveNavigationMesh"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"title":"carveNavigationMesh","type":"topic","role":"symbol","kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/NavigationObstacle3D":{"kind":"symbol","title":"NavigationObstacle3D","abstract":[{"type":"text","text":"3D obstacle used to affect navigation mesh baking or constrain velocities