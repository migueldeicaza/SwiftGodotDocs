{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"AStar3D","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A* (A star) is a computer algorithm used in pathfinding and graph traversal, the process of plotting short paths among vertices (points), passing through a given set of edges (segments). It enjoys widespread use due to its performance and accuracy. Godot’s A* implementation uses points in 3D space and Euclidean distances by default.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must add points manually with "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/addPoint(id:position:weightScale:)","isActive":true,"type":"reference"},{"type":"text","text":" and create segments manually with "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/connectPoints(id:toId:bidirectional:)","isActive":true},{"text":". Once done, you can test if there is a path between two points with the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/arePointsConnected(id:toId:bidirectional:)","type":"reference"},{"text":" function, get a path containing indices by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/getIdPath(fromId:toId:allowPartialPath:)"},{"text":", or one containing actual coordinates with ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/getPointPath(fromId:toId:allowPartialPath:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is also possible to use non-Euclidean distances. To do so, create a script that extends "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D"},{"type":"text","text":" and override the methods "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_computeCost(fromId:toId:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_estimateCost(fromId:endId:)","isActive":true,"type":"reference"},{"text":". Both should take two point IDs and return the distance between the corresponding points.","type":"text"}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Example:"}],"type":"strong"},{"text":" Use Manhattan distance instead of Euclidean distance:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_estimateCost(fromId:endId:)","isActive":true,"type":"reference"},{"text":" should return a lower bound of the distance, i.e. ","type":"text"},{"code":"_estimate_cost(u, v) <= _compute_cost(u, v)","type":"codeVoice"},{"type":"text","text":". This serves as a hint to the algorithm because the custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_computeCost(fromId:toId:)"},{"type":"text","text":" might be computation-heavy. If this is not the case, make "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_estimateCost(fromId:endId:)","type":"reference","isActive":true},{"type":"text","text":" return the same value as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_computeCost(fromId:toId:)"},{"type":"text","text":" to provide the algorithm with the most accurate information."}],"type":"paragraph"},{"inlineContent":[{"text":"If the default ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_estimateCost(fromId:endId:)"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_computeCost(fromId:toId:)","type":"reference"},{"type":"text","text":" methods are used, or if the supplied "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_estimateCost(fromId:endId:)","isActive":true,"type":"reference"},{"type":"text","text":" method returns a lower bound of the cost, then the paths returned by A* will be the lowest-cost paths. Here, the cost of a path equals the sum of the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/AStar3D\/_computeCost(fromId:toId:)","isActive":true},{"text":" results of all segments in the path multiplied by the ","type":"text"},{"type":"codeVoice","code":"weight_scale"},{"type":"text","text":"s of the endpoints of the respective segments. If the default methods are used and the "},{"type":"codeVoice","code":"weight_scale"},{"text":"s of all points are set to ","type":"text"},{"type":"codeVoice","code":"1.0"},{"type":"text","text":", then this equals the sum of Euclidean distances of all segments in the path."}],"type":"paragraph"}]}],"sections":[],"abstract":[{"text":"An implementation of A* for finding the shortest path between two vertices on a connected graph in 3D space.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftgodot\/astar3d"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RefCounted"],"type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible"],"type":"conformsTo","title":"Conforms To"}],"kind":"symbol","identifier":{"url":"doc:\/\/Sw