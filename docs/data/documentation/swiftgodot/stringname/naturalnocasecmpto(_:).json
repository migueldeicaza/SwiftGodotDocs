t":"always"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To get a [bool] result from a string comparison, use the "},{"type":"codeVoice","code":"=="},{"text":" operator instead. See also ","type":"text"},{"type":"codeVoice","code":"naturalcasecmpTo(to:)"},{"text":", ","type":"text"},{"code":"filenocasecmpTo(to:)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"casecmpTo(to:)","type":"codeVoice"},{"text":".","type":"text"}]}]}],"metadata":{"externalID":"s:10SwiftGodot10StringNameC18naturalnocasecmpToys5Int64VSSF","roleHeading":"Instance Method","title":"naturalnocasecmpTo(_:)","symbolKind":"method","modules":[{"name":"SwiftGodot"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"naturalnocasecmpTo","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":") -> ","kind":"text"},{"text":"Int64","kind":"typeIdentifier","preciseIdentifier":"s:s5Int64V"}]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Performs a "},{"inlineContent":[{"text":"case-insensitive","type":"text"}],"type":"strong"},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"natural order","type":"text"}]},{"text":" comparison to another string. Returns ","type":"text"},{"code":"-1","type":"codeVoice"},{"type":"text","text":" if less than, "},{"type":"codeVoice","code":"1"},{"type":"text","text":" if greater than, or "},{"code":"0","type":"codeVoice"},{"type":"text","text":" if equal. “Less than” or “greater than” are determined by the "},{"type":"text","text":"Unicode code points"},{"type":"text","text":" of each string, which roughly matches the alphabetical order. Internally, lowercase characters are converted to uppercase for the comparison."}],"references":{"d