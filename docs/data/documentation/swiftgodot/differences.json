:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantArray","abstract":[{"type":"text","text":"A built-in data structure that holds a sequence of elements."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VariantArray","kind":"identifier"}],"url":"\/documentation\/swiftgodot\/variantarray","title":"VariantArray","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"VariantArray"}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Variant/asObject(_:)":{"title":"asObject(_:)","abstract":[{"type":"text","text":"Attempts to cast the Variant into a SwiftGodot.Object, if the variant contains a value of type "},{"type":"codeVoice","code":".object"},{"type":"text","text":", then"},{"text":" ","type":"text"},{"type":"text","text":"a "},{"type":"codeVoice","code":".object, the value "},{"text":"nil` is returned.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/swiftgodot\/variant\/asobject(_:)","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Variant\/asObject(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"asObject","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":".Type) -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"}}}