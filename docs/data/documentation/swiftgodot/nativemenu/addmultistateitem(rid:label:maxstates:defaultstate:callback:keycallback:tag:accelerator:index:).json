ragraph","inlineContent":[{"type":"text","text":"By default, there’s no indication of the current item state, it should be changed manually."}]}],"name":"Note","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"callback"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"keyCallback"},{"text":" Callables need to accept exactly one Variant parameter, the parameter passed to the Callables will be the value passed to ","type":"text"},{"type":"codeVoice","code":"tag"},{"text":".","type":"text"}]}],"name":"Note","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is implemented on macOS and Windows."}]}],"name":"Note","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"On Windows, ","type":"text"},{"type":"codeVoice","code":"accelerator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"keyCallback"},{"text":" are ignored.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"}],"kind":"content"}],"kind":"symbol","sections":[],"abstract":[{"text":"Adds a new item with text ","type":"text"},{"code":"label","type":"codeVoice"},{"text":" to the global menu ","type":"text"},{"code":"rid","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/nativemenu\/addmultistateitem(rid:label:maxstates:defaultstate:callback:keycallback:tag:accelerator:index:)"]}],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/NativeMenu\/addMultistateItem(rid:label:maxStates:defaultState:callback:keyCallback:tag:accelerator:index:)","interfaceLanguage":"swift"},"references":{"doc://SwiftGodot/documentation/SwiftGodot/NativeMenu/addMultistateItem(rid:label:maxStates:defaultState:callback:keyCallback:tag:accelerator:index:)":{"url":"\/documentation\/swiftgodot\/nativemenu\/addmultistateitem(rid:label:maxs