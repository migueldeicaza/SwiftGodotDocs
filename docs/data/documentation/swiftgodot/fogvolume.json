Godot/documentation/SwiftGodot/RenderingServer/FogVolumeShape/cone":{"role":"symbol","url":"\/documentation\/swiftgodot\/renderingserver\/fogvolumeshape\/cone","type":"topic","abstract":[{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume","isActive":true},{"text":" will be shaped like a cone pointing upwards (in local coordinates). The cone’s angle is set automatically to fill the size. The cone will be adjusted to fit within the size. Rotate the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume","isActive":true},{"text":" node to reorient the cone. Non-uniform scaling via size is not supported (scale the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume","isActive":true},{"text":" node instead).","type":"text"}],"title":"RenderingServer.FogVolumeShape.cone","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cone","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/FogVolumeShape\/cone"},"doc://SwiftGodot/SH":{"identifier":"doc:\/\/SwiftGodot\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/Material":{"url":"\/documentation\/swiftgodot\/material","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Material","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Material","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Material","abstract":[{"type":"text","text":"Virtual base class for applying visual properties to an object, such as color and roughness."}],"title":"Material"},"doc://SwiftGodot/documentation/SwiftGodot/Environment/volumetricFogEnabled":{"url":"\/documentation\/swiftgodot\/environment\/volumetricfogenabled","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/volumetricFogEnabled","role":"symbol","title":"volumetricFogEnabled","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"volumetricFogEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Enables the volumetric fog effect. Volumetric fog uses a screen-aligned froxel buffer to calculate accurate volumetric scattering in the short to medium range. Volumetric fog interacts with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume"},{"type":"text","text":"s and lights to calculate localized and global fog. Volumetric fog uses a PBR single-scattering model based on extinction, scattering, and emission which it exposes to users as density, albedo, and emission."}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/FogMaterial/density":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogMaterial\/density","title":"density","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"density","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"type":"topic","role":"symbol","url":"\/documentation\/swiftgodot\/fogmaterial\/density","abstract":[{"type":"text","text":"The density of the "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume","isActive":true},{"type":"text","text":". Denser objects are more opaque, but may suffer from under-sampling artifacts that look like stripes. Negative values can be used to subtract fog from other "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume","isActive":true},{"type":"text","text":"s or global volumetric fog."}]},"doc://SwiftGodot/documentation/SwiftGodot/FogVolume/material":{"abstract":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Material","type":"reference"},{"text":" used by the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume","type":"reference"},{"text":". Can be either a built-in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogMaterial","type":"reference"},{"text":" or a custom ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/ShaderMaterial","type":"reference"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/FogVolume\/material","url":"\/documentation\/swiftgodot\/fogvolume\/material","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"material","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Material","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot8MaterialC"},{"text":"?","kind":"text"}],"role":"symbol","title":"material"},"doc://SwiftGodot/17SwiftGodotRuntime18VariantConvertibleP":{"identifier":"doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP","type":"unresolvable","title":"SwiftGodotRuntime.VariantConvertible"},"doc://SwiftGodot/documentation/SwiftGodot/Environment/volumetricFogDensity":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"volumetricFogDensity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"title":"volumetricFogDensity","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/volumetricFogDensity","type":"topic","kind":"symbol","role":"symbol","abstract":[{"text":"The base ","type":"text"},{"inlineContent":[{"text":"exponential","type":"text"}],"type":"emphasis"},{"text":" density of the volumetric fog. Set this to the lowest density you want to have globally. ","type":"tex