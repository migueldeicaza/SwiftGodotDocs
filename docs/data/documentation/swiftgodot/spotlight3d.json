{"variants":[{"paths":["\/documentation\/swiftgodot\/spotlight3d"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/spotAngle","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/spotAngleAttenuation","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/spotAttenuation","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/spotRange"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/godotClassName"]}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D"],"type":"inheritsFrom"},{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"],"type":"conformsTo"}],"metadata":{"modules":[{"name":"SwiftGodot"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpotLight3D","kind":"identifier"}],"title":"SpotLight3D","roleHeading":"Class","navigatorTitle":[{"text":"SpotLight3D","kind":"identifier"}],"externalID":"s:10SwiftGodot11SpotLight3DC","symbolKind":"class","role":"symbol"},"abstract":[{"text":"A spotlight, such as a reflector spotlight or a lantern.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpotLight3D"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A Spotlight is a type of ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D","isActive":true,"type":"reference"},{"text":" node that emits lights in a specific direction, in the shape of a cone. The light is attenuated through the distance. This attenuation can be configured by changing the energy, radius and attenuation parameters of ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"When using the Mobile rendering method, only 8 spot lights can be displayed on each mesh resource. Attempting to display more than 8 spot lights on a single mesh resource will result in spot lights flickering in and out as the camera moves. When using the Compatibility rendering method, only 8 spot lights can be displayed on each mesh resource by default, but this can be increased by adjusting "},{"code":"ProjectSettings\/rendering\/limits\/opengl\/maxLightsPerObject","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"When using the Mobile or Compatibility rendering methods, spot lights will only correctly affect meshes whose visibility AABB intersects with the light’s AABB. If using a shader to deform the mesh in a way that makes it go outside its AABB, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/extraCullMargin"},{"type":"text","text":" must be increased on the mesh. Otherwise, the light may not be visible on the mesh."}],"type":"paragraph"}],"style":"note","name":"Note"}],"kind":"content"}],"references":{"doc://SwiftGodot/s23CustomStringConvertibleP":{"identifier":"doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible","type":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/SpotLight3D/godotClassName":{"abstract":[],"role":"symbol","url":"\/documentation\/swiftgodot\/spotlight3d\/godotclassname","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/godotClassName","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"godotClassName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"StringName","preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC"}],"title":"godotClassName"},"doc://SwiftGodot/SH":{"type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/SH","title":"Swift.Hashable"},"doc://SwiftGodot/documentation/SwiftGodot/SpotLight3D":{"navigatorTitle":[{"text":"SpotLight3D","kind":"identifier"}],"abstract":[{"type":"text","text":"A spotlight, such as a reflector spotlight or a lantern."}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpotLight3D","kind":"identifier"}],"kind":"symbol","title":"SpotLight3D","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D","role":"symbol","url":"\/documentation\/swiftgodot\/spotlight3d"},"doc://SwiftGodot/17SwiftGodotRuntime18VariantConvertibleP":{"identifier":"doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP","title":"SwiftGodotRuntime.VariantConvertible","type":"unresolvable"},"doc://SwiftGodot/documentation/SwiftGodot/SpotLight3D/spotAngle":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/spotAngle","abstract":[{"text":"The spotlight’s angle in degrees.","type":"text"}],"kind":"symbol","title":"spotAngle","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","tex