{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Controls the distance attenuation function for spotlights.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"spotAttenuation"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value of "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" will maintain a constant brightness through most of the range, but smoothly attenuate the light at the edge of the range. Use a value of "},{"type":"codeVoice","code":"2.0"},{"type":"text","text":" for physically accurate lights as it results in the proper inverse square attenutation."}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Setting attenuation to "},{"type":"codeVoice","code":"2.0"},{"type":"text","text":" or higher may result in distant objects receiving minimal light, even within range. For example, with a range of "},{"type":"codeVoice","code":"4096"},{"type":"text","text":", an object at "},{"type":"codeVoice","code":"100"},{"type":"text","text":" units is attenuated by a factor of "},{"type":"codeVoice","code":"0.0001"},{"type":"text","text":". With a default brightness of "},{"type":"codeVoice","code":"1"},{"type":"text","text":", the light would not be visible at that distance."}],"type":"paragraph"}],"style":"note"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Using negative or 