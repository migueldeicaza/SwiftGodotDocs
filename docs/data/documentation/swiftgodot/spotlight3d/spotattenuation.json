{"abstract":[{"type":"text","text":"Controls the distance attenuation function for spotlights."}],"metadata":{"title":"spotAttenuation","modules":[{"name":"SwiftGodot"}],"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"spotAttenuation","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"symbolKind":"property","externalID":"s:10SwiftGodot11SpotLight3DC15spotAttenuationSdvp","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/spotAttenuation"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"spotAttenuation","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"text":" { ","kind":"text"},{"kind":"keyword","text":"get"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"A value of ","type":"text"},{"code":"0.0","type":"codeVoice"},{"text":" will maintain a constant brightness through most of the range, but smoothly attenuate the light at the edge of the range. Use a value of ","type":"text"},{"type":"codeVoice","code":"2.0"},{"type":"text","text":" for physically accurate lights as it results in the proper inverse square attenutation."}]},{"content":[{"inlineContent":[{"type":"text","text":"Setting attenuation to "},{"code":"2.0","type":"codeVoice"},{"text":" or higher may result in distant objects receiving minimal light, even within range. For example, with a range of ","type":"text"},{"type":"codeVoice","code":"4096"},{"text":", an object at ","type":"text"},{"type":"codeVoice","code":"100"},{"text":" units is attenuated by a factor of ","type":"text"},{"type":"codeVoice","code":"0.0001"},{"type":"text","text":". With a default brightness of "},{"type":"codeVoice","code":"1"},{"text":", the light would not be visible at that distance.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Using negative or values higher than "},{"type":"codeVoice","code":"10.0"},{"type":"text","text":" may lead to unexpected results."}]}],"type":"aside","style":"note","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D"]]},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/spotlight3d\/spotattenuation"]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/SpotLight3D":{"kind":"symbol","type":"topic","title":"SpotLight3D","url":"\/documentation\/swiftgodot\/spotlight3d","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpotLight3D"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D","role":"symbol","navigatorTitle":[{"text":"SpotLight3D","kind":"identifier"}],"abstract":[{"type":"text","text":"A spotlight, such as a reflector spotlight or a lantern."}]},"doc://SwiftGodot/documentation/SwiftGodot/SpotLight3D/spotAttenuation":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"spotAttenuation","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D\/spotAttenuation","title":"spotAttenuation","url":"\/documentation\/swiftgodot\/spotlight3d\/spotattenuation","abstract":[{"type":"text","text":"Controls the distance attenuation function for spotlights."}],"kind":"symbol","role":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"}}}