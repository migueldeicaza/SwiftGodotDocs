{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/lightmapgi"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"LightmapGI"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":" node is used to compute and store baked lightmaps. Lightmaps are used to provide high-quality indirect lighting with very little light leaking. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI"},{"text":" can also provide rough reflections using spherical harmonics if ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/directional","type":"reference","isActive":true},{"type":"text","text":" is enabled. Dynamic objects can receive indirect lighting thanks to "},{"inlineContent":[{"text":"light probes","type":"text"}],"type":"emphasis"},{"text":", which can be automatically placed by setting ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/generateProbesSubdiv","isActive":true,"type":"reference"},{"type":"text","text":" to a value other than "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/GenerateProbes\/disabled","isActive":true},{"type":"text","text":". Additional lightmap probes can also be added by creating "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapProbe","isActive":true,"type":"reference"},{"text":" nodes. The downside is that lightmaps are fully static and cannot be baked in an exported project. Baking a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI"},{"text":" node is also slower compared to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VoxelGI"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Procedural generation:","type":"text"}],"type":"strong"},{"type":"text","text":" Lightmap baking functionality is only available in the editor. This means "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI"},{"type":"text","text":" is not suited to procedurally generated or user-built levels. For procedurally generated or user-built levels, use "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VoxelGI","type":"reference"},{"type":"text","text":" or SDFGI instead (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/sdfgiEnabled"},{"text":").","type":"text"}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Performance:","type":"text"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true},{"type":"text","text":" provides the best possible run-time performance for global illumination. It is suitable for low-end hardware including integrated graphics and mobile devices."}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Due to how lightmaps work, most properties only have a visible effect once lightmaps are baked again."}]}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Lightmap baking on ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CSGShape3D","type":"reference","isActive":true},{"text":"s and ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PrimitiveMesh","isActive":true,"type":"reference"},{"text":"es is not supported, as these cannot store UV2 data required for baking.","type":"text"}]}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If no custom lightmappers are installed, "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":" can only be baked from devices that support the Forward+ or Mobile renderers.","type":"text"}]}],"name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":" node only bakes light data for child nodes of its parent. Nodes further up the hierarchy of the scene will not be baked.","type":"text"}]}],"type":"aside","name":"Note","style":"note"}],"kind":"content"}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VisualInstance3D"],"type":"inheritsFrom"},{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VariantConvertible"],"title":"Conforms To"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"metadata":{"externalID":"s:10SwiftGodot10LightmapGIC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"LightmapGI","kind":"identifier"}],"role":"symbol","modules":[{"name":"SwiftGodot"}],"symbolKind":"class","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"LightmapGI"}],"title":"LightmapGI"},"abstract":[{"text":"Computes and stores