ments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"disabled","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/GenerateProbes\/disabled","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/environmentCustomEnergy":{"url":"\/documentation\/swiftgodot\/lightmapgi\/environmentcustomenergy","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/environmentCustomEnergy","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"environmentCustomEnergy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"kind":"symbol","title":"environmentCustomEnergy","abstract":[{"type":"text","text":"The color multiplier to use for environment lighting. Only effective if "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/environmentMode-swift.property","isActive":true},{"type":"text","text":" is "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/EnvironmentMode-swift.enum\/customColor","isActive":true},{"type":"text","text":"."}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/bounceIndirectEnergy":{"url":"\/documentation\/swiftgodot\/lightmapgi\/bounceindirectenergy","title":"bounceIndirectEnergy","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bounceIndirectEnergy","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The energy multiplier for each bounce. Higher values will make indirect lighting brighter. A value of "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" represents physically accurate behavior, but higher values can be used to make indirect lighting propagate more visibly when using a low number of bounces. This can be used to speed up bake times by lowering the number of "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bounces","type":"reference","isActive":true},{"type":"text","text":" then increasing "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bounceIndirectEnergy","type":"reference","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bounceIndirectEnergy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/EnvironmentMode-swift.enum/customSky":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/EnvironmentMode-swift.enum\/customSky","url":"\/documentation\/swiftgodot\/lightmapgi\/environmentmode-swift.enum\/customsky","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customSky","kind":"identifier"}],"title":"LightmapGI.EnvironmentMode.customSky","abstract":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/environmentCustomSky","type":"reference","isActive":true},{"type":"text","text":" as a source of environment lighting when baking lightmaps."}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/generateProbesSubdiv":{"abstract":[{"type":"text","text":"The level of subdivision to use when automatically generating "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapProbe","isActive":true},{"type":"text","text":"s for dynamic object lighting. Higher values result in more accurate indirect lighting on dynamic objects, at the cost of longer bake times and larger file sizes."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/generateProbesSubdiv","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"generateProbesSubdiv"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10SwiftGodot10LightmapGIC","kind":"typeIdentifier","text":"LightmapGI"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10SwiftGodot10LightmapGIC14GenerateProbesO","kind":"typeIdentifier","text":"GenerateProbes"}],"title":"generateProbesSubdiv","url":"\/documentation\/swiftgodot\/lightmapgi\/generateprobessubdiv","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/environmentCustomColor":{"url":"\/documentation\/swiftgodot\/lightmapgi\/environmentcustomcolor","type":"topic","role":"symbol","title":"environmentCustomColor","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/environmentCustomColor","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"environmentCustomColor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Color","kind":"typeIdentifier","preciseIdentifier":"s:17SwiftGodotRuntime5ColorV"}],"abstract":[{"text":"The color to use for environment lighting. Only effective if ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/environmentMode-swift.property","type":"reference","isActive":true},{"text":" is ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/EnvironmentMode-swift.enum\/customColor","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/directional":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"directional"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/directional","abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", bakes lightmaps to contain directional information as spherical harmonics. This results in more realistic lighting appearance, especially with normal mapped materials and for lights that have their direct light baked ("},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightBakeMode","type":"reference","isActive":true},{"type":"text","text":" set to "},{"type":"codeVoice","code":"Light3D\/BakeMode\/`static``` and with "},{"type":"text","text":"Light3D\/editorOnly`` set to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"). The directional information is also used to provide rough reflections for static and dynamic objects. This has a small run-time performance cost as the shader has to perform more work to interpret the direction information from the lightmap. Directional lightmaps also take longer to bake and result in larger file sizes."}],"role":"symbol","url":"\/documentation\/swiftgodot\/lightmapgi\/directional","title":"directional"},"doc://SwiftGodot/documentation/SwiftGodot/CSGShape3D":{"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CSGShape3D","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CSGShape3D","kind":"identifier"}],"abstract":[{"type":"text","text":"The CSG base class."}],"url":"\/documentation\/swiftgodot\/csgshape3d","navigatorTitle":[{"text":"CSGShape3D","kind":"identifier"}],"type":"topic","title":"CSGShape3D"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/cameraAttributes":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cameraAttributes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CameraAttributes","preciseIdentifier":"s:10SwiftGodot16CameraAttributesC"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/cameraAttributes","role":"symbol","kind":"symbol","title":"cameraAttributes","abstract":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributes","type":"reference","isActive":true},{"type":"text","text":" resource that specifies exposure levels to bake at. Auto-exposure and non exposure properties will be ignored. Exposure settings should be used to reduce the dynamic range present when baking. If exposure is too high, the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","type":"reference","isActive":true},{"type":"text","text":" will have banding artifacts or may have over-exposure artifacts."}],"url":"\/documentation\/swiftgodot\/lightmapgi\/cameraattributes"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/BakeQuality":{"kind":"symbol","title":"LightmapGI.BakeQuality","type":"topic","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BakeQuality"}],"navigatorTitle":[{"kind":"identifier","text":"BakeQuality"}],"url":"\/documentation\/swiftgodot\/lightmapgi\/bakequality","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/BakeQuality"},"doc://SwiftGodot/17SwiftGodotRuntime18VariantConvertibleP":{"identifier":"doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP","type":"unresolvable","title":"SwiftGodotRuntime.VariantConvertible"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/supersamplingFactor":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"supersamplingFactor"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/swiftgodot\/lightmapgi\/supersamplingfactor","kind":"symbol","title":"supersamplingFactor","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The factor by which the texel density is multiplied for supersampling. For best results, use an integer value. While fractional values are allowed, they can result in increased light leaking and a blurry lightmap."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersamplingFactor"},"doc://SwiftGodot/documentation/SwiftGodot/Environment/sdfgiEnabled":{"title":"sdfgiEnabled","type":"topic","kind":"symbol","abstract":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", enables signed distance field global illumination for meshes that have their ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/giMode-swift.property","isActive":true},{"text":" set to ``GeometryInstance3D\/GIMode\/`static```. SDFGI is a real-time global illumination technique that works well with procedurally generated and user-built levels, including in situations where geometry is created during gameplay. The signed distance field is automatically generated around the camera as it moves. Dynamic lights are supported, but dynamic occluders and emissive surfaces are not.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sdfgiEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/swiftgodot\/environment\/sdfgienabled","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/sdfgiEnabled"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/godotClassName":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/godotClassName","abstract":[],"title":"godotClassName","url":"\/documentation\/swiftgodot\/lightmapgi\/godotclassname","kind":"symbol","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"godotClassName","kind":"identifier"},{"text":": ","kind":"text"},{"text":"StringName","preciseIdentifier":"s:17SwiftGodotRuntime10StringNameC","kind":"typeIdentifier"}],"type":"topic"},"doc://SwiftGodot/documentation/Swif