tGodot\/documentation\/SwiftGodot\/LightmapGI\/maxTextureSize","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/quality","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/shadowmaskMode","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersampling","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersamplingFactor","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/texelScale","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/useDenoiser","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/useTextureForBounces"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/godotClassName"],"title":"Type Properties","anchor":"Type-Properties"},{"generated":true,"identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/BakeError","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/BakeQuality","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/EnvironmentMode-swift.enum","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/GenerateProbes"],"title":"Enumerations","anchor":"Enumerations"}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"metadata":{"roleHeading":"Class","modules":[{"name":"SwiftGodot"}],"role":"symbol","title":"LightmapGI","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LightmapGI"}],"navigatorTitle":[{"kind":"identifier","text":"LightmapGI"}],"externalID":"s:10SwiftGodot10LightmapGIC","symbolKind":"class"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LightmapGI"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":" node is used to compute and store baked lightmaps. Lightmaps are used to provide high-quality indirect lighting with very little light leaking. ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":" can also provide rough reflections using spherical harmonics if ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/directional","isActive":true,"type":"reference"},{"text":" is enabled. Dynamic objects can receive indirect lighting thanks to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"light probes"}]},{"text":", which can be automatically placed by setting ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/generateProbesSubdiv","isActive":true,"type":"reference"},{"text":" to a value other than ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/GenerateProbes\/disabled","isActive":true,"type":"reference"},{"text":". Additional lightmap probes can also be added by creating ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapProbe","isActive":true,"type":"reference"},{"text":" nodes. The downside is that lightmaps are fully static and cannot be baked in an exported project. Baking a ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":" node is also slower compared to ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VoxelGI","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Procedural generation:","type":"text"}]},{"type":"text","text":" Lightmap baking functionality is only available in the editor. This means "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true},{"type":"text","text":" is not suited to procedurally generated or user-built levels. For procedurally generated or user-built levels, use "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/VoxelGI","isActive":true},{"type":"text","text":" or SDFGI instead (see "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/sdfgiEnabled","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Performance:"}],"type":"strong"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI"},{"type":"text","text":" provides the best possible run-time performance for global illumination. It is suitable for low-end hardware including integrated graphics and mobile devices."}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Due to how lightmaps work, most properties only have a visible effect once lightmaps are baked again.","type":"text"}]}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"text":"Lightmap baking on ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CSGShape3D","isActive":true},{"text":"s and ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PrimitiveMesh","isActive":true},{"text":"es is not supported, as these cannot store UV2 data required for baking.","type":"text"}],"type":"paragraph"}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If no custom lightmappers are installed, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI"},{"type":"text","text":" can only be baked from devices that support the Forward+ or Mobile renderers."}]}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true},{"text":" node only bakes light data for child nodes of its parent. Nodes further up the hierarchy of the scene will not be baked.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/environmentCustomSky":{"title":"environmentCustomSky","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"environmentCustomSky","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Sky","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot3SkyC"},{"text":"?","kind":"text"}],"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/environmentCustomSky","kind":"symbol","url":"\/documentation\/swiftgodot\/lightmapgi\/environmentcustomsky","abstract":[{"text":"The sky to use as a source of environment lighting. Only effective if ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/environmentMode-swift.property","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/EnvironmentMode-swift.enum\/customSky","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/useDenoiser":{"url":"\/documentation\/swiftgodot\/lightmapgi\/usedenoiser","kind":"symbol","abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", uses a GPU-based denoising algorithm on the generated lightmap. This eliminates most noise within the generated lightmap at the cost of longer bake times. Fil