bes for lighting dynamic objects."}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/swiftgodot\/lightmapgi\/generateprobes\/disabled"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/godotClassName":{"url":"\/documentation\/swiftgodot\/lightmapgi\/godotclassname","type":"topic","role":"symbol","title":"godotClassName","abstract":[],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/godotClassName","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"godotClassName","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10SwiftGodot10StringNameC","text":"StringName","kind":"typeIdentifier"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/cameraAttributes":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/cameraAttributes","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"cameraAttributes"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10SwiftGodot16CameraAttributesC","kind":"typeIdentifier","text":"CameraAttributes"},{"text":"?","kind":"text"}],"title":"cameraAttributes","abstract":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/CameraAttributes"},{"text":" resource that specifies exposure levels to bake at. Auto-exposure and non exposure properties will be ignored. Exposure settings should be used to reduce the dynamic range present when baking. If exposure is too high, the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI"},{"text":" will have banding artifacts or may have over-exposure artifacts.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/swiftgodot\/lightmapgi\/cameraattributes"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/useDenoiser":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/useDenoiser","url":"\/documentation\/swiftgodot\/lightmapgi\/usedenoiser","abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"type":"text","text":", uses a GPU-based denoising algorithm on the generated lightmap. This eliminates most noise within the generated lightmap at the cost of longer bake times. File sizes are generally not impacted significantly by the use of a denoiser, although lossless compression may do a better job at compressing a denoised image."}],"kind":"symbol","title":"useDenoiser","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"useDenoiser","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightBakeMode":{"kind":"symbol","type":"topic","url":"\/documentation\/swiftgodot\/light3d\/lightbakemode","abstract":[{"type":"text","text":"The light’s bake mode. This will affect the global illumination techniques that have an effect on the light’s rendering. See "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/BakeMode","type":"reference","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightBakeMode","title":"lightBakeMode","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"lightBakeMode","kind":"identifier"},{"kind":"text","text":": "},{"text":"Light3D","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot7Light3DC"},{"text":".","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot7Light3DC8BakeModeO","text":"BakeMode"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/supersamplingFactor":{"abstract":[{"text":"The factor by which the texel density is multiplied for supersampling. For best results, use an integer value. While fractional values are allowed, they can result in increased light leaking and a blurry lightmap.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersamplingFactor","title":"supersamplingFactor","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"supersamplingFactor","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/swiftgodot\/lightmapgi\/supersamplingfactor"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/bias":{"type":"topic","url":"\/documentation\/swiftgodot\/lightmapgi\/bias","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bias","title":"bias","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"bias","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"}],"abstract":[{"type":"text","text":"The bias to use when computing shadows. Increasing "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bias","isActive":true,"type":"reference"},{"type":"text","text":" can fix shadow acne on the resulting baked lightmap, but can introduce peter-panning (shadows not connecting to their casters). Real-time "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D","type":"reference","isActive":true},{"type":"text","text":" shadows are not affected by this "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bias","type":"reference"},{"text":" property.","type":"text"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/shadowmaskMode":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/shadowmaskMode","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The shadowmasking policy to use for directional shadows on static objects that are baked with this "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":" instance.","type":"text"}],"url":"\/documentation\/swiftgodot\/lightmapgi\/shadowmaskmode","title":"shadowmaskMode","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"shadowmaskMode","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10SwiftGodot14LightmapGIDataC","text":"LightmapGIData","kind":"typeIdentifier"},{"text":".","kind":"text"},{"kind":"typeIdentifier","text":"ShadowmaskMode","preciseIdentifier":"s:10SwiftGodot14LightmapGIDataC14ShadowmaskModeO"}]},"doc://SwiftGodot/documentation/SwiftGodot/Environment/sdfgiEnabled":{"role":"symbol","title":"sdfgiEnabled","kind":"symbol","type":"topic","abstract":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", enables signed distance field global illumination for meshes that have their "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/giMode-swift.property","isActive":true},{"text":" set to ``GeometryInstance3D\/GIMode\/`static```. SDFGI is a real-time global illumination technique that works well with procedurally generated and user-built levels, including in situations where geometry is created during gameplay. The signed distance field is automatically generated around the camera as it moves. Dynamic lights are supported, but dynamic occluders and emissive surfaces are not.","type":"text"}],"url":"\/documentation\/swiftgodot\/environment\/sdfgienabled","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Environment\/sdfgiEnabled","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"sdfgiEnabled"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/generateProbesSubdiv":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"generateProbesSubdiv"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"LightmapGI","preciseIdentifier":"s:10SwiftGodot10LightmapGIC"},{"kind":"text","text":"."},{"preciseIdentifier":"s:10SwiftGodot10LightmapGIC14GenerateProbesO","text":"GenerateProbes","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/generateProbesSubdiv","type":"topic","url":"\/documentation\/swiftgodot\/lightmapgi\/generateprobessubdiv","abstract":[{"type":"text","text":"The level of subdivision to use when automatically generating "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapProbe"},{"type":"text","text":"s for dynamic object lighting. Higher values result in more accurate indirect lighting on dynamic objects, at the cost of longer bake times and larger file sizes."}],"title":"generateProbesSubdiv","role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/supersampling":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersampling","title":"supersampling","role":"symbol","url":"\/documentation\/swiftgodot\/lightmapgi\/supersampling","abstract":[{"type":"text","text":"If "},{"type":"codeVoice","code":"true"},{"text":", lightmaps are baked with the texel scale multiplied with ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/supersamplingFactor","isActive":true},{"type":"text","text":" and downsampled before saving the lightmap (so the effective texel density is identical to having supersampling disabled)."}],"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"supersampling"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/denoiserStrength":{"type":"topic","title":"denoiserStrength","abstract":[{"text":"The strength of denoising step applied to the generated lightmaps. Only effective if ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/useDenoiser","isActive":true,"type":"reference"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ProjectSettings\/rendering\/lightmapping\/denoising\/denoiser"},{"text":" is set to JNLM.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/denoiserStrength","url":"\/documentation\/swiftgodot\/lightmapgi\/denoiserstrength","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"denoiserStrength"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"kind":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/directional":{"kind":"symbol","type":"topic","url":"\/documentation\/swiftgodot\/lightmapgi\/directional","abstract":[{"type":"text","text":"If "},{"code":"true","type":"codeVoice"},{"type":"text","text":", bakes lightmaps to contain directional information as spherical harmonics. This results in more realistic lighting appearance, especially with normal mapped materials and for lights that have their direct light baked ("},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightBakeMode","isActive":true},{"type":"text","text":" set to "},{"code":"Light3D\/BakeMode\/`static``` and with ","type":"codeVoice"},{"type":"text","text":"Light3D\/editorOnly`` set to "},{"type":"codeVoice","code":"false"},{"text":"). The directional information is also used to provide rough reflections for static and dynamic objects. This has a small run-time performance cost as the shader has to perform more work to interpret the direction information from the lightmap. Directional lightmaps also take longer to bake and result in larger file sizes.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/directional","title":"directional","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"directional","kind":"identifier"},{"kind":"text","text":": "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGIData":{"role":"symbol","abstract":[{"type":"text","text":"Contains baked lightmap and dynamic object probe data for "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"LightmapGIData","url":"\/documentation\/swiftgodot\/lightmapgidata","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGIData","kind":"symbol","navigatorTitle":[{"text":"LightmapGIData","kind":"identifier"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LightmapGIData","kind":"identifier"}]},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/texelScale":{"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"texelScale"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"}],"abstract":[{"text":"Scales the lightmap texel density of all meshes for the current bake. This is a multiplier that builds upon the existing lightmap texel size defined in each imported 3D scene, along with the per-mesh density multiplier (which is designed to be used when the same mesh is used at different scales). Lower values will result in faster bake times.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/texelScale","url":"\/documentation\/swiftgodot\/lightmapgi\/texelscale","kind":"symbol","title":"texelScale"},"doc://SwiftGodot/documentation/SwiftGodot/LightmapGI/bounceIndirectEnergy":{"type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bounceIndirectEnergy","kind":"symbol","abstract":[{"text":"The energy multiplier for each bounce. Higher values will make indirect lighting brighter. A value of ","type":"text"},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" represents physically accurate behavior, but higher values can be used to make indirect lighting propagate more visibly when using a low number of bounces. This can be used to speed up bake times by lowering the number of "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bounces","isActive":true,"type":"reference"},{"text":" then increasing ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/LightmapGI\/bounceIndirectEnergy","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"bounceIndirectEnergy","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"bounceIndirectEnergy","kind":"identifier"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"url":"\/documentation\/swiftgodot\/lightmapgi\/bounceindirectenergy"},"doc://SwiftGodot/s23CustomStringConvertibleP":{"title":"Swift.CustomStringConvertible","type":"unresolvable","identifier":"doc:\/\/SwiftGodot\/s23CustomStringConvertibleP"},"doc://SwiftGodot/documentation/SwiftGodot/PrimitiveMesh":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/PrimitiveMesh","abstract":[{"type":"text","text":"Base class for all primitive meshes. Handles applying a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Material"},{"type":"text","text":" to a primitive mesh."}],"navigatorTitle":[{"kind":"identifier","text":"PrimitiveMesh"}],"type":"topic","title":"PrimitiveMesh","kind":"symbol","role":"symbol","url":"\/documentation\/swiftgodot\/primitivemesh","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PrimitiveMesh"}]}}}