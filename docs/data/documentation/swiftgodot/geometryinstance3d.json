o avoid the expensive "},{"type":"codeVoice","code":"AABB"},{"type":"text","text":" recalculation that happens when a skeleton is used with a "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MeshInstance3D","type":"reference","isActive":true},{"type":"text","text":" or to have precise control over the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MeshInstance3D","type":"reference","isActive":true},{"type":"text","text":"’s bounding box. To use the default AABB, set value to an "},{"type":"codeVoice","code":"AABB"},{"type":"text","text":" with all fields set to "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":". To avoid frustum culling, set "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/customAabb","type":"reference"},{"text":" to a very large AABB that covers your entire game world such as ","type":"text"},{"type":"codeVoice","code":"AABB(-10000, -10000, -10000, 20000, 20000, 20000)"},{"text":". To disable all forms of culling (including occlusion culling), call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/instanceSetIgnoreCulling(instance:enabled:)","type":"reference"},{"text":" on the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D","type":"reference"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"RID"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/customAabb"},"doc://SwiftGodot/documentation/SwiftGodot/SpriteBase3D":{"type":"topic","url":"\/documentation\/swiftgodot\/spritebase3d","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpriteBase3D","kind":"symbol","title":"SpriteBase3D","navigatorTitle":[{"kind":"identifier","text":"SpriteBase3D"}],"abstract":[{"text":"2D sprite node in 3D environment.","type":"text"}],"fragments":[{"kind":