ftGodot\/HTTPClient\/requestRaw(method:url:headers:body:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/setHttpProxy(host:port:)","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/setHttpsProxy(host:port:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Properties","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/godotClassName"],"generated":true,"anchor":"Type-Properties"},{"title":"Enumerations","identifiers":["doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/Method","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/ResponseCode","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/Status"],"generated":true,"anchor":"Enumerations"}],"abstract":[{"text":"Low-level hyper-text transfer protocol client.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot"]]},"kind":"symbol","relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/SwiftGodot\/17SwiftGodotRuntime10RefCountedC"],"type":"inheritsFrom","kind":"relationships"},{"title":"Conforms To","identifiers":["doc:\/\/SwiftGodot\/s23CustomStringConvertibleP","doc:\/\/SwiftGodot\/SQ","doc:\/\/SwiftGodot\/SH","doc:\/\/SwiftGodot\/s12IdentifiableP","doc:\/\/SwiftGodot\/17SwiftGodotRuntime18VariantConvertibleP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HTTPClient","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hyper-text transfer protocol client (sometimes called “User Agent”). Used to make HTTP requests to download web content, upload files and other data or to communicate with various services, among other use cases."}]},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPRequest","isActive":true,"type":"reference"},{"text":" node for a higher-level alternative.","type":"text"}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This client only needs to connect to a host once (see "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/connectToHost(_:port:tlsOptions:)","isActive":true,"type":"reference"},{"type":"text","text":") to send multiple requests. Because of this, methods that take URLs usually take just the part after the host instead of the full URL, as the client is already connected to a host. See "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient\/request(method:url:headers:body:)","isActive":true,"type":"reference"},{"type":"text","text":" for a full example and to get started."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/HTTPClient"},{"type":"text","text":" should be reused between multiple requests or to connect to different hosts instead of creating one client per request. Supports Transport Layer Security (TLS), including server certificate verification. HTTP status codes in the 2xx range indicate success, 3xx redirection (i.e. “try again, but over here”), 4xx something was wrong with the request, and 5xx something went wrong on the server’s side."}]},{"type":"paragraph","inlineContent":[{"text":"For more information on HTTP, see ","type":"text"},{"text":"MDN’s documentation on HTTP","type":"text"},{"text":" (or read ","type":"text"},{"text":"RFC 2616","type":"text"},{"text":" to get it straight from the source).","type":"text"}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"When exporting to Android, make sure to enable the ","type":"text"},{"type":"codeVoice","code":"INTERNET"},{"text":" permission in the Android export preset before exporting the project or using one-click deploy. Otherwise, network communication of any kind will be blocked by Android.","type":"text"}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s recommended to use transport encryption (TLS) and to avoid sending sensitive information (such as login credentials) in HTTP GET URL parameters. Consider using HTTP POST requests or HTTP headers for such information instead."}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When performing HTTP requests from a project exported to Web, keep in mind the remote server may not allow requests from foreign origins due to "},{"type":"text","text":"CORS"},{"type":"text","text":". If you host the server in question, you should modify its backend to allow requests from foreign origins by adding the "},{"code":"Access-Control-Allow-Origin: *","type":"codeVoice"},{"type":"text","text":" HTTP header."}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"TLS support is currently limited to TLSv1.2 and TLSv1.3. Attempting to connect to a server that only supports older (insecure) TLS versions will return an error.","type":"text"}]}]},{"type":"aside","name":"Warning","style":"warning","content":[{"inlineContent":[{"text":"TLS certificate revocation and certificate pinning are currently not supported. Revoked certificates are accepted as long as they are otherwise valid. If this is a concern, you may want to use automatically managed certificates with a short validity period.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/httpclient"]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/