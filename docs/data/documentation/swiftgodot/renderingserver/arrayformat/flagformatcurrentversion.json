ompressAttributes","kind":"identifier"},{"kind":"text","text":": "},{"text":"RenderingServer","kind":"typeIdentifier","preciseIdentifier":"s:10SwiftGodot15RenderingServerC"},{"text":".","kind":"text"},{"text":"ArrayFormat","preciseIdentifier":"s:10SwiftGodot15RenderingServerC11ArrayFormatV","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ArrayFormat\/flagCompressAttributes","abstract":[{"text":"Flag used to mark that a mesh is using compressed attributes (vertices, normals, tangents, UVs). When this form of compression is enabled, vertex positions will be packed into an RGBA16UNORM attribute and scaled in the vertex shader. The normal and tangent will be packed into an RG16UNORM representing an axis, and a 16-bit float stored in the A-channel of the vertex. UVs will use 16-bit normalized floats instead of full 32-bit signed floats. When using this compression mode you must use either vertices, normals, and tangents or only vertices. You cannot use normals without tangents. Importers will automatically enable this compression if they can.","type":"text"}],"type":"topic","url":"\/documentation\/swiftgodot\/renderingserver\/arrayformat\/flagcompressattributes","title":"flagCompressAttributes"},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ArrayFormat":{"navigatorTitle":[{"text":"ArrayFormat","kind":"identifier"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ArrayFormat","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ArrayFormat","kind":"identifier"}],"type":"topic","title":"RenderingServer.ArrayFormat","kind":"symbol","url":"\/documentation\/swiftgodot\/renderingserver\/arrayformat","abstract":[],"role":"symbol"}}}