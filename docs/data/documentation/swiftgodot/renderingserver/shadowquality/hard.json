{"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ShadowQuality\/hard","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Lowest shadow filtering quality (fastest). Soft shadows are not available with this quality setting, which means the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBlur","type":"reference","isActive":true},{"type":"text","text":" property is ignored if "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightSize","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightAngularDistance","type":"reference","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/swiftgodot\/renderingserver\/shadowquality\/hard"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","symbolKind":"case","title":"RenderingServer.ShadowQuality.hard","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hard","kind":"identifier"}],"externalID":"s:10SwiftGodot15RenderingServerC13ShadowQualityO4hardyA2EmF","modules":[{"name":"SwiftGodot"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ShadowQuality"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hard","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The variable shadow blur performed by "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightSize","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightAngularDistance","isActive":true,"type":"reference"},{"type":"text","text":" is still effective when using hard shadow filtering. In this case, "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBlur","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"is"}]},{"type":"text","text":" taken into account. However, the results will not be blurred, instead the blur amount is treated as a maximum radius for the penumbra."}]}]}]}],"references":{"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ShadowQuality/hard":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hard","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftgodot\/renderingserver\/shadowquality\/hard","title":"RenderingServer.ShadowQuality.hard","kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ShadowQuality\/hard","abstract":[{"type":"text","text":"Lowest shadow filtering quality (fastest). Soft shadows are not available with this quality setting, which means the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBlur"},{"type":"text","text":" property is ignored if "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightSize"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightAngularDistance"},{"type":"text","text":" is "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":"."}],"role":"symbol"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightAngularDistance":{"title":"lightAngularDistance","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightAngularDistance","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lightAngularDistance","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/light3d\/lightangulardistance","role":"symbol","abstract":[{"type":"text","text":"The light’s angular size in degrees. Increasing this will make shadows softer at greater distances (also called percentage-closer soft shadows, or PCSS). Only available for "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D","isActive":true,"type":"reference"},{"type":"text","text":"s. For reference, the Sun from the Earth is approximately "},{"type":"codeVoice","code":"0.5"},{"type":"text","text":". Increasing this value above "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" for lights with shadows enabled will have a noticeable performance cost due to PCSS."}]},"doc://SwiftGodot/documentation/SwiftGodot/OmniLight3D":{"title":"OmniLight3D","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Omnidirectional light, such as a light bulb or a candle."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"OmniLight3D"}],"url":"\/documentation\/swiftgodot\/omnilight3d","navigatorTitle":[{"kind":"identifier","text":"OmniLight3D"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"