kind":"keyword"},{"text":" ","kind":"text"},{"text":"shadowBlur","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/light3d\/shadowblur","title":"shadowBlur","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBlur","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D":{"title":"DirectionalLight3D","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D","role":"symbol","kind":"symbol","url":"\/documentation\/swiftgodot\/directionallight3d","type":"topic","abstract":[{"type":"text","text":"Directional light from a distance, as from the Sun."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DirectionalLight3D"}],"navigatorTitle":[{"kind":"identifier","text":"DirectionalLight3D"}]},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightSize":{"title":"lightSize","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightSize","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lightSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/light3d\/lightsize","role":"symbol","abstract":[{"type":"text","text":"The size of the light in Godot units. Only available for "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D","isActive":true,"type":"reference"},{"type":"text","text":"s and "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D","isActive":true,"type":"reference"},{"type":"text","text":"s. Increasing this value will make the light fade out slower and shadows appear blurrier (also called percentage-closer soft shadows, or PCSS). This can be used to simulate area lights to an extent. Increasing this value above "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" for lights with shadows enabled will have a noticeable performance cost due to PCSS."}]}}}