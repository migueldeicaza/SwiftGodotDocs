{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"softUltra"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softUltra","kind":"identifier"}],"role":"symbol","title":"RenderingServer.ShadowQuality.softUltra","roleHeading":"Case","modules":[{"name":"SwiftGodot"}],"externalID":"s:10SwiftGodot15RenderingServerC13ShadowQualityO9softUltrayA2EmF","symbolKind":"case"},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ShadowQuality"]]},"abstract":[{"type":"text","text":"Highest low shadow filtering quality (slowest). When using this quality setting, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBlur"},{"type":"text","text":" is automatically multiplied by 2× to better make use of the high sample count. This increased blur also improves the stability of dynamic object shadows. This multiplier only applies to lights whose "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightSize"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightAngularDistance"},{"type":"text","text":" is "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":")."}],"sections":[],"identifier":{"url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ShadowQuality\/softUltra","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/swiftgodot\/renderingserver\/shadowquality\/softultra"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://SwiftGodot/documentation/SwiftGodot/Light3D/shadowBlur":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Blurs the edges of the shadow. Can be used to hide pixel artifacts in low-resolution shadow maps. A high value can impact performance, make shadows appear grainy and can cause other unwanted artifacts. Try to keep as near default as possible."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shadowBlur","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/light3d\/shadowblur","title":"shadowBlur","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/shadowBlur","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightAngularDistance":{"title":"lightAngularDistance","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightAngularDistance","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lightAngularDistance","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/light3d\/lightangulardistance","role":"symbol","abstract":[{"type":"text","text":"The light’s angular size in degrees. Increasing this will make shadows softer at greater distances (also called percentage-closer soft shadows, or PCSS). Only available for "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D","isActive":true,"type":"reference"},{"type":"text","text":"s. For reference, the Sun from the Earth is approximately "},{"type":"codeVoice","code":"0.5"},{"type":"text","text":". Increasing this value above "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" for lights with shadows enabled will have a noticeable performance cost due to PCSS."}]},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ShadowQuality":{"role":"symbol","abstract":[],"title":"RenderingServer.ShadowQuality","navigatorTitle":[{"kind":"identifier","text":"ShadowQuality"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ShadowQuality","type":"topic","url":"\/documentation\/swiftgodot\/renderingserver\/shadowquality","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ShadowQuality"}]},"doc://SwiftGodot/documentation/SwiftGodot/Light3D/lightSize":{"title":"lightSize","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Light3D\/lightSize","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lightSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"}],"url":"\/documentation\/swiftgodot\/light3d\/lightsize","role":"symbol","abstract":[{"type":"text","text":"The size of the light in Godot units. Only available for "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/OmniLight3D","isActive":true,"type":"reference"},{"type":"text","text":"s and "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/SpotLight3D","isActive":true,"type":"reference"},{"type":"text","text":"s. Increasing this value will make the light fade out slower and shadows appear blurrier (also called percentage-closer soft shadows, or PCSS). This can be used to simulate area lights to an extent. Increasing this value above "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" for lights with shadows enabled will have a noticeable performance cost due to PCSS."}]},"doc://SwiftGodot/documentation/SwiftGodot/DirectionalLight3D":{"title":"DirectionalLight3D","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/DirectionalLight3D","role":"symbol","kind":"symbol","url":"\/documentation\/swiftgodot\/directionallight3d","type":"topic","abstract":[{"type":"text",