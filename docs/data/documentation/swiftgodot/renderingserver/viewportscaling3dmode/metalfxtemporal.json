{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode"]]},"metadata":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"metalfxTemporal","kind":"identifier"}],"role":"symbol","modules":[{"name":"SwiftGodot"}],"roleHeading":"Case","symbolKind":"case","externalID":"s:10SwiftGodot15RenderingServerC21ViewportScaling3DModeO15metalfxTemporalyA2EmF","title":"RenderingServer.ViewportScaling3DMode.metalfxTemporal"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"metalfxTemporal"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Only supported when the Metal rendering driver is in use, which limits this scaling mode to macOS and iOS."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode\/metalfxTemporal"},"variants":[{"paths":["\/documentation\/swiftgodot\/renderingserver\/viewportscaling3dmode\/metalfxtemporal"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Use MetalFX temporal upscaling for the viewport’s 3D buffer. The amount of scaling can be set using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","type":"reference"},{"type":"text","text":". Values less than "},{"type":"codeVoice","code":"1.0"},{"text":" will be result in the viewport being upscaled using MetalFX. Values greater than ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" are not supported and bilinear downsampling will be used instead. A value of ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" will use MetalFX at native resolution as a TAA solution.","type":"text"}],"sections":[],"kind":"symbol","references":{"doc://SwiftGodot/documentation/SwiftGodot":{"role":"collection","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","url":"\/documentation\/swiftgodot","title":"SwiftGodot","kind":"symbol","abstract":[{"text":"Framework to write Godot Game Extensions using the Swift Programming Language.","type":"text"}],"type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ViewportScaling3DMode/metalfxTemporal":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"metalfxTemporal","kind":"identifier"}],"role":"symbol","title":"RenderingServer.ViewportScaling3DMode.metalfxTemporal","url":"\/documentation\/swiftgodot\/renderingserver\/viewportscaling3dmode\/metalfxtemporal","abstract":[{"text":"Use MetalFX temporal upscaling for the viewport’s 3D buffer. The amount of scaling can be set using ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","isActive":true},{"type":"text","text":". Values less than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" will be result in the viewport being upscaled using MetalFX. Values greater than "},{"code":"1.0","type":"codeVoice"},{"text":" are not supported and bilinear downsampling will be used instead. A value of ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" will use MetalFX at native resolution as a TAA solution.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode\/metalfxTemporal"},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer":{"role":"symbol","url":"\/documentation\/swiftgodot\/renderingserver","title":"RenderingServer","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RenderingServer"}],"abstract":[{"text":"Server for anything visible.","type":"text"}],"navigatorTitle":[{"text":"RenderingServer","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/scaling3dScale":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling3dScale"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","title":"scaling3dScale","abstract":[{"text":"Scales the 3D render buffer based on the viewport size uses an image filter specified in ","type":"text"},{"type":"codeVoice","code":"ProjectSettings\/rendering\/scaling3d\/mode"},{"type":"text","text":" to scale the output image to the full viewport size. Values lower than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" can be used to speed up 3D rendering at the cost of quality (undersampling). Values greater than "},{"type":"codeVoice","code":"1.0"},{"text":" are only valid for bilinear mode and can be used to improve 3D rendering quality at a high performance cost (supersampling). See also ","type":"text"},{"type":"codeVoice","code":"ProjectSettings\/rendering\/antiAliasing\/quality\/msaa3d"},{"type":"text","text":" for multi-sample antialiasing, which is significantly cheaper but only smooths the edges of polygons."}],"url":"\/documentation\/swiftgodot\/viewport\/scaling3dscale"},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ViewportScaling3DMode":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ViewportScaling3DMode"}],"role":"symbol","title":"Rendering