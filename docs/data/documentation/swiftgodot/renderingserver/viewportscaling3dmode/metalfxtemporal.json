{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"metalfxTemporal"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only supported when the Metal rendering driver is in use, which limits this scaling mode to macOS and iOS."}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftGodot\/documentation\/SwiftGodot","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer","doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftgodot\/renderingserver\/viewportscaling3dmode\/metalfxtemporal"]}],"kind":"symbol","abstract":[{"type":"text","text":"Use MetalFX temporal upscaling for the viewport’s 3D buffer. The amount of scaling can be set using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale"},{"type":"text","text":". Values less than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" will be result in the viewport being upscaled using MetalFX. Values greater than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" are not supported and bilinear downsampling will be used instead. A value of "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" will use MetalFX at native resolution as a TAA solution."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode\/metalfxTemporal"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"metalfxTemporal"}],"externalID":"s:10SwiftGodot15RenderingServerC21ViewportScaling3DModeO15metalfxTemporalyA2EmF","roleHeading":"Case","title":"RenderingServer.ViewportScaling3DMode.metalfxTemporal","symbolKind":"case","role":"symbol","modules":[{"name":"SwiftGodot"}]},"references":{"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ViewportScaling3DMode/metalfxTemporal":{"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode\/metalfxTemporal","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"metalfxTemporal","kind":"identifier"}],"role":"symbol","title":"RenderingServer.ViewportScaling3DMode.metalfxTemporal","abstract":[{"type":"text","text":"Use MetalFX temporal upscaling for the viewport’s 3D buffer. The amount of scaling can be set using "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale","isActive":true},{"type":"text","text":". Values less than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" will be result in the viewport being upscaled using MetalFX. Values greater than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" are not supported and bilinear downsampling will be used instead. A value of "},{"code":"1.0","type":"codeVoice"},{"text":" will use MetalFX at native resolution as a TAA solution.","type":"text"}],"url":"\/documentation\/swiftgodot\/renderingserver\/viewportscaling3dmode\/metalfxtemporal"},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer":{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer","role":"symbol","navigatorTitle":[{"text":"RenderingServer","kind":"identifier"}],"title":"RenderingServer","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderingServer","kind":"identifier"}],"abstract":[{"text":"Server for anything visible.","type":"text"}],"url":"\/documentation\/swiftgodot\/renderingserver","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ViewportScaling3DMode":{"role":"symbol","type":"topic","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode","title":"RenderingServer.ViewportScaling3DMode","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ViewportScaling3DMode","kind":"identifier"}],"navigatorTitle":[{"text":"ViewportScaling3DMode","kind":"identifier"}],"kind":"symbol","abstract":[],"url":"\/documentation\/swiftgodot\/renderingserver\/viewportscaling3dmode"},"doc://SwiftGodot/documentation/SwiftGodot/Viewport/scaling3dScale":{"abstract":[{"type":"text","text":"Scales the 3D render buffer based on the viewport size uses an image filter specified in "},{"code":"ProjectSettings\/rendering\/scaling3d\/mode","type":"codeVoice"},{"type":"text","text":" to scale the output image to the full viewport size. Values lower than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" can be used to speed up 3D rendering at the cost of quality (undersampling). Values greater than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" are only valid for bilinear mode and can be used to improve 3D rendering quality at a high performance cost (supersampling). See also "},{"type":"codeVoice","code":"ProjectSettings\/rendering\/antiAliasing\/quality\/msaa3d"},{"type":"text","text":" for multi-sample antialiasing, which is significantly cheaper but only smooths the edges of polygons."}],"type":"topic","title":"scaling3dScale","url":"\/documentation\/swiftgodot\/viewport\/scaling3dscale","role":"sym