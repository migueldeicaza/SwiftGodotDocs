ales the 3D render buffer based on the viewport size uses an image filter specified in "},{"code":"ProjectSettings\/rendering\/scaling3d\/mode","type":"codeVoice"},{"type":"text","text":" to scale the output image to the full viewport size. Values lower than "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" can be used to speed up 3D rendering at the cost of quality (undersampling). Values greater than "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" are only valid for bilinear mode and can be used to improve 3D rendering quality at a high performance cost (supersampling). See also "},{"type":"codeVoice","code":"ProjectSettings\/rendering\/antiAliasing\/quality\/msaa3d"},{"type":"text","text":" for multi-sample antialiasing, which is significantly cheaper but only smooths the edges of polygons."}],"type":"topic","title":"scaling3dScale","url":"\/documentation\/swiftgodot\/viewport\/scaling3dscale","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scaling3dScale"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/Viewport\/scaling3dScale"},"doc://SwiftGodot/documentation/SwiftGodot":{"url":"\/documentation\/swiftgodot","abstract":[{"type":"text","text":"Framework to write Godot Game Extensions using the Swift Programming Language."}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot","title":"SwiftGodot","kind":"symbol","type":"topic","role":"collection"},"doc://SwiftGodot/documentation/SwiftGodot/RenderingServer/ViewportScaling3DMode/fsr2":{"title":"RenderingServer.ViewportScaling3DMode.fsr2","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"fsr2"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/ViewportScaling3DMode\/fsr2","url":"\/