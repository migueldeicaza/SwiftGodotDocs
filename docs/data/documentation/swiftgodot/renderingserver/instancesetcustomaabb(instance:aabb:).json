ot\/GeometryInstance3D\/ignoreOcclusionCulling","type":"reference","isActive":true},{"text":", which only ignores occlusion culling and leaves frustum culling intact.","type":"text"}],"title":"instanceSetIgnoreCulling(instance:enabled:)","url":"\/documentation\/swiftgodot\/renderingserver\/instancesetignoreculling(instance:enabled:)","role":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/instanceSetIgnoreCulling(instance:enabled:)","type":"topic"},"doc://SwiftGodot/documentation/SwiftGodot/GeometryInstance3D":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"GeometryInstance3D"}],"kind":"symbol","identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D","url":"\/documentation\/swiftgodot\/geometryinstance3d","type":"topic","navigatorTitle":[{"kind":"identifier","text":"GeometryInstance3D"}],"abstract":[{"text":"Base node for geometry-based visual instances.","type":"text"}],"role":"symbol","title":"GeometryInstance3D"},"doc://SwiftGodot/documentation/SwiftGodot/GeometryInstance3D/customAabb":{"title":"customAabb","url":"\/documentation\/swiftgodot\/geometryinstance3d\/customaabb","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"customAabb"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiftGodotRuntime4AABBV","kind":"typeIdentifier","text":"AABB"}],"abstract":[{"type":"text","text":"Overrides the bounding box of this node with a custom one. This can be used to avoid the expensive "},{"type":"codeVoice","code":"AABB"},{"type":"text","text":" recalculation that happens when a skeleton is used with a "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MeshInstance3D","type":"reference","isActive":true},{"type":"text","text":" or to have precise control over the "},{"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/MeshInstance3D","type":"reference","isActive":true},{"type":"text","text":"’s bounding box. To use the default AABB, set value to an "},{"type":"codeVoice","code":"AABB"},{"type":"text","text":" with all fields set to "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":". To avoid frustum culling, set "},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/customAabb","type":"reference"},{"text":" to a very large AABB that covers your entire game world such as ","type":"text"},{"type":"codeVoice","code":"AABB(-10000, -10000, -10000, 20000, 20000, 20000)"},{"text":". To disable all forms of culling (including occlusion culling), call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/RenderingServer\/instanceSetIgnoreCulling(instance:enabled:)","type":"reference"},{"text":" on the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D","type":"reference"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"RID"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/documentation\/SwiftGodot\/GeometryInstance3D\/customAabb"}}}