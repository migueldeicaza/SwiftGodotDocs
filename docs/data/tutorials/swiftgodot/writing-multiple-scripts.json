{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/swiftgodot\/writing-multiple-scripts"]}],"metadata":{"title":"Writing Multiple Scripts","role":"project","category":"SwiftGodot","categoryPathComponent":"SwiftGodot-Tutorials"},"kind":"project","sections":[{"estimatedTimeInMinutes":15,"kind":"hero","chapter":"SwiftGodot Essentials","image":"RunnerHeader.png","backgroundImage":"RunnerHeader.png","title":"Writing Multiple Scripts","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial builds off the Simple Runner game introduced in "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","isActive":true},{"type":"text","text":" and will introduce you"},{"type":"text","text":" "},{"type":"text","text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating"},{"type":"text","text":" "},{"type":"text","text":"an infinite runner."}]}]},{"tasks":[{"anchor":"Handle-vertical-movement","title":"Handle vertical movement","contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"The player currently only moves along the horizontal axis, but remains in place vertically. Let’s adjust the","type":"text"},{"text":" ","type":"text"},{"text":"player code to include vertical motion.","type":"text"}]}]}],"stepsSection":[{"type":"step","caption":[],"runtimePreview":null,"media":null,"content":[{"inlineContent":[{"text":"In ","type":"text"},{"code":"PlayerController.swift","type":"codeVoice"},{"text":", find the ","type":"text"},{"code":"movementVector","type":"codeVoice"},{"text":" computed property and update its y value to","type":"text"},{"text":" ","type":"text"},{"text":"include a constant speed of one.","type":"text"}],"type":"paragraph"}],"code":"PlayerController-multiscript-2.swift"},{"type":"step","caption":[],"runtimePreview":null,"media":"SwiftBuild.png","content":[{"type":"paragraph","inlineContent":[{"text":"In the terminal, navigate to the SimpleRunnerDriver package and run ","type":"text"},{"type":"codeVoice","code":"swift build"},{"text":" to build the package.","type":"text"}]}],"code":null},{"type":"step","caption":[],"runtimePreview":null,"media":"OpenSwiftBuild.png","content":[{"inlineContent":[{"text":"Open the ","type":"text"},{"type":"codeVoice","code":".build\/{arch}\/debug"},{"text":" directory in the Finder using the ","type":"text"},{"type":"codeVoice","code":"open"},{"text":" command, replacing ","type":"text"},{"type":"codeVoice","code":"arch"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"text":"your Mac’s architecture folder.","type":"text"}],"type":"paragraph"}],"code":null},{"type":"step","caption":[],"runtimePreview":null,"media":"DylibCopy.png","content":[{"inlineContent":[{"text":"Copy the ","type":"text"},{"type":"codeVoice","code":"libSimpleRunnerDriver.dylib"},{"text":" file into the ","type":"text"},{"type":"codeVoice","code":"bin"},{"text":" directory of the SimpleRunner Godot project.","type":"text"}],"type":"paragraph"}],"code":null},{"type":"step","caption":[],"runtimePreview":null,"media":"GodotMainEditor.png","content":[{"inlineContent":[{"type":"text","text":"Open the project in the Godot editor and open the "},{"type":"codeVoice","code":"main.tscn"},{"type":"text","text":" scene file."}],"type":"paragraph"}],"code":null},{"type":"step","caption":[],"runtimePreview":null,"media":"SimpleRunner-vertical.gif","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run the project by pressing the Play button in the toolbar. The player should now be moving down the"},{"type":"text","text":" "},{"type":"text","text":"screen, past the edges of the level."}]}],"code":null}]},{"anchor":"Teleport-the-player","title":"Teleport the player","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Now that the player can run down the screen, let’s allow the player to teleport to the top of the level when","type":"text"},{"text":" ","type":"text"},{"text":"they reach the bottom.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To do so, you will create a new node class that represents the main level logic and detect when the player"},{"type":"text","text":" "},{"type":"text","text":"has reached the bottom and teleport them to the top."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"stepsSection":[{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"Create a new Swift file called ","type":"text"},{"inlineContent":[{"type":"text","text":"MainLevel"}],"type":"strong"},{"text":" in the SimpleRunnerDriver package and import the SwiftGodot","type":"text"},{"text":" ","type":"text"},{"text":"library.","type":"text"}]}],"media":null,"type":"step","code":"MainLevel-multiscript-init.swift","runtimePreview":null},{"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Write a new "},{"type":"codeVoice","code":"MainLevel"},{"type":"text","text":" class that inherits from "},{"type":"codeVoice","code":"Node2D"},{"type":"text","text":" and has the "},{"type":"codeVoice","code":"@Godot"},{"type":"text","text":" attribute"}],"type":"paragraph"}],"media":null,"type":"step","code":"MainLevel-multiscript-2.swift","runtimePreview":null},{"caption":[{"inlineContent":[{"text":"Note that these properties are marked optional, as they may not exist in the scene tree.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"code":"player","type":"codeVoice"},{"type":"text","text":", "},{"code":"spawnpoint","type":"codeVoice"},{"type":"text","text":", and "},{"code":"teleportArea","type":"codeVoice"},{"type":"text","text":" properties to "},{"code":"MainLevel","type":"codeVoice"},{"type":"text","text":", using the "},{"code":"@SceneTree","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"macro to list their names in the scene tree."}],"type":"paragraph"}],"media":null,"type":"step","code":"MainLevel-multiscript-3.swift","runtimePreview":"Godot-MainLevel-SceneTree.png"},{"caption":[{"type":"paragraph","inlineContent":[{"code":"GD.pushWarning(_:)","type":"codeVoice"},{"text":" allows us to send warning messages to Godot’s console.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"Create a new ","type":"text"},{"code":"teleportPlayerToTop()","type":"codeVoice"},{"text":" method and add a guard statement to check that the player and spawn","type":"text"},{"text":" ","type":"text"},{"text":"point exist.","type":"text"}]}],"media":null,"type":"step","code":"MainLevel-multiscript-4.swift","runtimePreview":null},{"caption":[{"inlineContent":[{"type":"text","text":"This will effectively teleport the player to the top of the map, preserving where the player was on the"},{"type":"text","text":" "},{"type":"text","text":"horizontal axis."}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Set the player’s position so that their horizontal coordinate is kept, but the vertical coordinate is","type":"text"},{"text":" ","type":"text"},{"text":"that of the spawn point.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step","code":"MainLevel-multiscript-5.swift","runtimePreview":null},{"caption":[],"content":[{"inlineContent":[{"type":"text","text":"In the "},{"code":"_ready()","type":"codeVoice"},{"type":"text","text":" method, connect the teleport area’s "},{"code":"bodyEntered","type":"codeVoice"},{"type":"text","text":" signal method to check if the player"},{"type":"text","text":" "},{"type":"text","text":"has entered the area and teleport them when necessary."}],"type":"paragraph"}],"media":null,"type":"step","code":"MainLevel-multiscript-6.swift","runtimePreview":null},{"caption":[],"content":[{"inlineContent":[{"text":"Register the class type in ","type":"text"},{"type":"codeVoice","code":"SimpleRunnerDriver.swift"},{"text":" to expose it to Godot.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step","code":"SimpleRunnerDriver-multiscript-2.swift","runtimePreview":null}]},{"anchor":"Using-the-new-main-level-node","title":"Using the new main level node","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Now that the main level code has been added, let’s replace the current main level node with its new instance","type":"text"},{"text":" ","type":"text"},{"text":"provided by your extension.","type":"text"}]}],"mediaPosition":"trailing"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rebuild the extension and copy over "},{"type":"codeVoice","code":"libSimpleRunnerDriver.dylib"},{"type":"text","text":" as before."}]}],"media":"SwiftBuild.png","type":"step","caption":[],"runtimePreview":null,"code":null},{"content":[{"inlineContent":[{"text":"Open the project in the Godot editor and open the ","type":"text"},{"type":"codeVoice","code":"main.tscn"},{"text":" scene file.","type":"text"}],"type":"paragraph"}],"media":"GodotMainEditor.png","type":"step","caption":[],"runtimePreview":null,"code":null},{"content":[{"inlineContent":[{"type":"text","text":"Right click on the Main Level node and select "},{"inlineContent":[{"text":"Change Type","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}],"media":"Godot-MainLevel-ChangeType.png","type":"step","caption":[],"runtimePreview":null,"code":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Search for “MainLevel” and set the node’s type to the new MainLevel node you created."}]}],"media":"Godot-ChangeType-MainLevel.png","type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the node doesn’t appear in the search results, retry the steps for registering the class, rebuilding"},{"type":"text","text":" "},{"type":"text","text":"the extension, and re-opening Godot."}]}],"runtimePreview":null,"code":null},{"content":[{"inlineContent":[{"text":"Run the project by pressing the Play button in the toolbar. The player should now be moving down the","type":"text"},{"text":" ","type":"text"},{"text":"screen, teleporting to the top of the screen once the player reaches the bottom. 🎉","type":"text"}],"type":"paragraph"}],"media":"SimpleRunner-teleport.gif","type":"step","caption":[],"runtimePreview":null,"code":null}]}],"kind":"tasks"},{"abstract":[{"text":"SwiftGodotKit lets you drive Godot entirely from Swift, and treat Godot as just another Swift framework you can call into.","type":"text"}],"action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit"},"title":"Using SwiftGodotKit","featuredEyebrow":"Tutorial","kind":"callToAction"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts"},"hierarchy":{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials","modules":[{"projects":[{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","sections":[{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Create-a-Swift-package","kind":"task"},{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Create-a-player-character","kind":"task"},{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Set-up-the-extension","kind":"task"},{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Use-the-new-player-controller","kind":"task"}]},{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts","sections":[{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Handle-vertical-movement","kind":"task"},{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Teleport-the-player","kind":"task"},{"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Using-the-new-main-level-node","kind":"task"}]}],"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials\/SwiftGodot-Essentials"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit#SwiftGodotKit-from-Xcode"}],"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit"}],"reference":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials\/Embedding-Godot-in-Swift"}],"paths":[["doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials","doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials\/$volume","doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials\/SwiftGodot-Essentials"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"GodotMainEditor.png":{"identifier":"GodotMainEditor.png","alt":"The Godot editor open with the main SimpleRunnerProject.","variants":[{"url":"\/images\/SwiftGodot\/GodotMainEditor.png","traits":["1x","light"]}],"type":"image"},"doc://SwiftGodot/tutorials/SwiftGodot-Tutorials":{"kind":"overview","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials","url":"\/tutorials\/swiftgodot-tutorials","abstract":[{"text":"SwiftGodot allows developers to take new and existing Swift packages and use them as extensions for the Godot game engine.","type":"text"}],"role":"overview","title":"Meet SwiftGodot","type":"topic"},"SwiftBuild.png":{"identifier":"SwiftBuild.png","alt":"A terminal window at the SwiftRunnerDriver package, about to run swift build.","variants":[{"url":"\/images\/SwiftGodot\/SwiftBuild.png","traits":["1x","light"]}],"type":"image"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension#Use-the-new-player-controller":{"type":"section","kind":"section","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Use-the-new-player-controller","url":"\/tutorials\/swiftgodot\/your-first-extension#Use-the-new-player-controller","role":"pseudoSymbol","title":"Use the new player controller","abstract":[{"text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll","type":"text"},{"text":" ","type":"text"},{"text":"start by building off the Simple Runner game project and create a player character to move the character along","type":"text"},{"text":" ","type":"text"},{"text":"the horizontal axis.","type":"text"}]},"MainLevel-multiscript-init.swift":{"identifier":"MainLevel-multiscript-init.swift","fileName":"MainLevel.swift","type":"file","syntax":"swift","highlights":[],"fileType":"swift","content":["\/\/","\/\/  MainLevel.swift","\/\/  ","\/\/","\/\/  Created by Marquis Kurt on 7\/22\/23.","\/\/","","import SwiftGodot"]},"PlayerController-multiscript-2.swift":{"content":["\/\/","\/\/  PlayerController.swift","\/\/","\/\/","\/\/  Created by Marquis Kurt on 7\/19\/23.","\/\/","","import SwiftGodot","","@Godot","class PlayerController: CharacterBody2D {","    var acceleration: Float = 100","    var friction: Double = 100","    var speed: Double = 200","","    var movementVector: Vector2 {","        var movement = Vector2.zero","        movement.x = Float(","            Input.getActionStrength(action: \"move_right\") - Input.getActionStrength(action: \"move_left\"))","        movement.y = 1.0","        return movement.normalized()","    }","","    override func _physicsProcess(delta: Double) {","        if Engine.isEditorHint() { return }","        if movementVector != .zero {","            let acceleratedVector = Vector2(x: acceleration, y: acceleration)","            let acceleratedMovement = movementVector * acceleratedVector","            self.velocity = acceleratedMovement.limitLength(speed)","        } else {","            velocity = velocity.moveToward(to: .zero, delta: friction)","        }","        self.moveAndSlide()","    }","}"],"syntax":"swift","fileType":"swift","fileName":"PlayerController.swift","identifier":"PlayerController-multiscript-2.swift","highlights":[{"line":20}],"type":"file"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension":{"role":"project","title":"Your First Extension","type":"topic","kind":"project","abstract":[{"type":"text","text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll"},{"type":"text","text":" "},{"type":"text","text":"start by building off the Simple Runner game project and create a player character to move the character along"},{"type":"text","text":" "},{"type":"text","text":"the horizontal axis."}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","estimatedTime":"30min","url":"\/tutorials\/swiftgodot\/your-first-extension"},"MainLevel-multiscript-4.swift":{"content":["\/\/","\/\/  MainLevel.swift","\/\/  ","\/\/","\/\/  Created by Marquis Kurt on 7\/22\/23.","\/\/","","import SwiftGodot","","@Godot","class MainLevel: Node2D {","    @Node(\"CharacterBody2D\") var player: PlayerController?","    @Node(\"Spawnpoint\") var spawnpoint: Node2D?","    @Node(\"Telepoint\") var teleportArea: Area2D?","","    private func teleportPlayerToTop() {","        guard let player, let spawnpoint else {","            GD.pushWarning(\"Player or spawnpoint is missing.\")","            return","        }","        ","    }","}"],"fileType":"swift","syntax":"swift","highlights":[{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"fileName":"MainLevel.swift","identifier":"MainLevel-multiscript-4.swift","type":"file"},"doc://SwiftGodot/tutorials/SwiftGodot/Writing-Multiple-Scripts#Teleport-the-player":{"abstract":[{"text":"This tutorial builds off the Simple Runner game introduced in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension"},{"text":" and will introduce you","type":"text"},{"text":" ","type":"text"},{"text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating","type":"text"},{"text":" ","type":"text"},{"text":"an infinite runner.","type":"text"}],"type":"section","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Teleport-the-player","kind":"section","title":"Teleport the player","role":"pseudoSymbol","url":"\/tutorials\/swiftgodot\/writing-multiple-scripts#Teleport-the-player"},"doc://SwiftGodot/tutorials/SwiftGodot-Tutorials/SwiftGodot-Essentials":{"role":"article","kind":"article","title":"SwiftGodot Essentials","abstract":[],"url":"\/tutorials\/swiftgodot-tutorials\/swiftgodot-essentials","type":"topic","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials\/SwiftGodot-Essentials"},"RunnerHeader.png":{"identifier":"RunnerHeader.png","alt":"A screenshot of the Simple Runner game. The player wears a bird costume and runs alongside boxes.","variants":[{"traits":["1x","light"],"url":"\/images\/SwiftGodot\/RunnerHeader.png"}],"type":"image"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension#Set-up-the-extension":{"title":"Set up the extension","url":"\/tutorials\/swiftgodot\/your-first-extension#Set-up-the-extension","abstract":[{"type":"text","text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll"},{"type":"text","text":" "},{"type":"text","text":"start by building off the Simple Runner game project and create a player character to move the character along"},{"type":"text","text":" "},{"type":"text","text":"the horizontal axis."}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Set-up-the-extension","kind":"section","role":"pseudoSymbol","type":"section"},"OpenSwiftBuild.png":{"identifier":"OpenSwiftBuild.png","alt":"A terminal window at the SwiftRunnerDriver package, about to run open.","variants":[{"traits":["1x","light"],"url":"\/images\/SwiftGodot\/OpenSwiftBuild.png"}],"type":"image"},"Godot-ChangeType-MainLevel.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/SwiftGodot\/Godot-ChangeType-MainLevel.png"}],"identifier":"Godot-ChangeType-MainLevel.png","type":"image","alt":"The Godot editor with the context menu for Main Level open, highlighting Change Type."},"MainLevel-multiscript-6.swift":{"syntax":"swift","content":["\/\/","\/\/  MainLevel.swift","\/\/  ","\/\/","\/\/  Created by Marquis Kurt on 7\/22\/23.","\/\/","","import SwiftGodot","","@Godot","class MainLevel: Node2D {","    @Node(\"CharacterBody2D\") var player: PlayerController?","    @Node(\"Spawnpoint\") var spawnpoint: Node2D?","    @Node(\"Telepoint\") var teleportArea: Area2D?","","    override func _ready() {","        teleportArea?.bodyEntered.connect { [self] enteredBody in","            if enteredBody.isClass(\"\\(PlayerController.self)\") {","                teleportPlayerToTop()","            }","        }","    }","","    private func teleportPlayerToTop() {","        guard let player, let spawnpoint else {","            GD.pushWarning(\"Player or spawnpoint is missing.\")","            return","        }","","        player.position = Vector2(x: player.position.x, y: spawnpoint.position.y)","    }","}"],"identifier":"MainLevel-multiscript-6.swift","type":"file","fileType":"swift","highlights":[{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"fileName":"MainLevel.swift"},"doc://SwiftGodot/tutorials/SwiftGodot/Using-Swift-Godot-Kit#SwiftGodotKit-from-Xcode":{"url":"\/tutorials\/swiftgodot\/using-swift-godot-kit#SwiftGodotKit-from-Xcode","role":"pseudoSymbol","kind":"section","abstract":[{"type":"text","text":"SwiftGodotKit lets you drive Godot entirely from Swift, and treat Godot as just another Swift framework you can call into."}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit#SwiftGodotKit-from-Xcode","type":"section","title":"SwiftGodotKit from X