ft"},"metadata":{"title":"Your First Extension","role":"project","category":"SwiftGodot Tutorials","categoryPathComponent":"SwiftGodot-Tutorials"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[{"image":"RunnerHeader.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll"},{"type":"text","text":" "},{"type":"text","text":"start by building off the Simple Runner game project and create a player character to move the character along"},{"text":" ","type":"text"},{"type":"text","text":"the horizontal axis."}]}],"chapter":"SwiftGodot Essentials","estimatedTimeInMinutes":30,"backgroundImage":"RunnerHeader.png","title":"Your First Extension","kind":"hero","projectFiles":"SimpleRunner-Starter.zip"},{"tasks":[{"title":"Create a Swift package","stepsSection":[{"type":"step","caption":[],"media":"NewPackage.png","content":[{"inlineContent":[{"type":"text","text":"Open Xcode and select "},{"inlineContent":[{"type":"text","text":"File > New > Package…"}],"type":"strong"},{"text":" to create a new Swift package.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null},{"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the template chooser, select "},{"type":"strong","inlineContent":[{"text":"Library","type":"text"}]},{"type":"text","text":" and save the project near your game’s project files as"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"SimpleRunnerDriver","type":"text"}]},{"text":".","type":"text"}]}],"code":null,"caption":[],"media":"LibraryPackageTemplate.png"},{"code":"Package-starter-2.swift","runtimePreview":null,"type":"step","media":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Package.swift, add the SwiftGodot binary dependency to your package."}]}]},{"code":"Package-starter-3.swift","content":[{"inlineContent":[{"type":"text","text":"Set the type of the SimpleRunnerDriver library to dynamic and set the minimum platform target to macOS 13."}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"caption":[]},{"caption":[],"code":"Package-starter-4.swift","media":null,"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Update the SimpleRunnerDriver target to add in the appropriate Swift compiler and linker settings. These","type":"text"},{"text":" ","type":"text"},{"text":"flags are needed to allow dynamic lookup with the Godot engine.","type":"text"}]}]},{"code":"SimpleRunnerDriver-starter-2.swift","runtimePreview":null,"caption":[],"type":"step","content":[{"inlineContent":[{"type":"text","text":"In SimpleRunnerDriver.swift, import the SwiftGodot library and call the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"initSwiftExtension"},{"type":"text","text":" macro to create an entry point. For now, we can pass an empty array for the nodes"},{"type":"text","text":" "},{"text":"to be registered.","type":"text"}],"type":"paragraph"}],"media":null}],"anchor":"Create-a-Swift-package","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your extension for Godot lives as a Swift package alongside your Godot project. While Godot currently"},{"type":"text","text":" "},{"text":"doesn’t support editing Swift packages in its editor, you can use Xcode to do most of the heavy lifting.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}]},{"title":"Create a player character","stepsSection":[{"runtimePreview":null,"media":null,"content":[{"inlineContent":[{"text":"Create a new Swift file called ","type":"text"},{"type":"strong","inlineContent":[{"text":"PlayerController.swift","type":"text"}]},{"text":" in the ","type":"text"},{"code":"Sources\/SimpleRunnerDriver","type":"codeVoice"},{"type":"text","text":" directory and import the"},{"text":" ","type":"text"},{"type":"text","text":"SwiftGodot library."}],"type":"paragraph"}],"code":"PlayerController-starter-init.swift","type":"step","caption":[]},{"type":"step","code":"PlayerController-starter-2.swift","runtimePreview":null,"media":null,"caption":[],"content":[{"inlineContent":[{"text":"Write a new ","type":"text"},{"code":"PlayerController","type":"codeVoice"},{"text":" class that inherits from ","type":"text"},{"type":"codeVoice","code":"CharacterBody2D"},{"type":"text","text":" and add its required"},{"text":" ","type":"text"},{"text":"initializers.","type":"text"}],"type":"paragraph"}]},{"media":null,"code":"PlayerController-starter-3.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"These will be used to calculate the final velocity of the player.","type":"text"}]}],"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"acceleration","type":"codeVoice"},{"type":"text","text":", "},{"code":"friction","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"speed","type":"codeVoice"},{"type":"text","text":" properties to the player controller."}]}]},{"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"code":"movementVector","type":"codeVoice"},{"type":"text","text":" computed property that creates a new vector and sets its X coordinate to the"},{"text":" ","type":"text"},{"type":"text","text":"difference between the "},{"code":"move_right","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"move_left","type":"codeVoice"},{"text":" actions. Return the normalized vector in the block.","type":"text"}]}],"code":"PlayerController-starter-4.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This vector will be used to determine the direction that the player is moving in along the X axis. For"},{"text":" ","type":"text"},{"text":"now, we will assume that the player does ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"text":" move on the vertical axis.","type":"text"}]}]},{"media":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This check is needed here to ensure that keypresses are registered only when running in-game, as the"},{"type":"text","text":" "},{"type":"text","text":"extension runs at the engine level."}]}],"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"_physicsProcess","type":"codeVoice"},{"text":" method to the player controller class and return from the function if the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"engine reports that we’re in the editor."}],"type":"paragraph"}],"code":"PlayerController-starter-5.swift","runtimePreview":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"limitLength","type":"codeVoice"},{"text":" method is used to clamp the velocity down to the maximum ","type":"text"},{"code":"speed","type":"codeVoice"},{"type":"text","text":" value so that the"},{"type":"text","text":" "},{"type":"text","text":"player doesn’t build up a lot of speed."}]}],"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Check if the movement vector is a non-zero value (i.e., the player is actively pressing a key), and"},{"type":"text","text":" "},{"type":"text","text":"calculate the velocity at which the player moves. If your "},{"type":"codeVoice","code":"acceleration"},{"type":"text","text":", "},{"type":"codeVoice","code":"friction"},{"text":", and\/or ","type":"text"},{"type":"codeVoice","code":"speed"},{"type":"text","text":" "},{"text":"values are integers, be sure to explicitly define their types as floats\/doubles.","type":"text"}],"type":"paragraph"}],"media":null,"code":"PlayerController-starter-6.swift"},{"code":"PlayerController-starter-7.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Add an else case that will have the player’s velocity moving towards zero, applying any ","type":"text"},{"type":"codeVoice","code":"friction"},{"type":"text","text":" as"},{"text":" ","type":"text"},{"text":"necessary.","type":"text"}]}],"type":"step","media":null,"caption":[]},{"type":"step","code":"PlayerController-starter-8.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Finally, call ","type":"text"},{"type":"codeVoice","code":"moveAndSlide"},{"text":" to move the player, sliding along any edges the player collides with, and","type":"text"},{"type":"text","text":" "},{"text":"call the parent’s ","type":"text"},{"type":"codeVoice","code":"physicsProcess(delta:)"},{"text":" method.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[]},{"code":"SimpleRunnerDriver-starter-3.swift","type":"step","runtimePreview":null,"media":null,"caption":[{"inlineContent":[{"text":"This registration call exposed the class type to Godot as a valid node that can be used in the engine.","type":"text"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In, SimpleRunnerDriver.swift, register the "},{"type":"codeVoice","code":"PlayerController"},{"type":"text","text":" class type by adding this to the array"},{"text":" ","type":"text"},{"type":"text","text":"in "},{"type":"codeVoice","code":"initSwiftExtension"},{"text":".","type":"text"}]}]}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Now that our package is set up, we can create a player controller to move the player around in.","type":"text"}]}],"mediaPosition":"trailing"}],"anchor":"Create-a-player-character"},{"stepsSection":[{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a new "},{"type":"codeVoice","code":"bin"},{"text":" folder in the SimpleRunner Godot project with an empty file","type":"text"},{"text":" ","type":"text"},{"typ