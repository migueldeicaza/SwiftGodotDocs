{"identifier":{"url":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","interfaceLanguage":"swift"},"variants":[{"paths":["\/tutorials\/swiftgodot\/your-first-extension"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"categoryPathComponent":"SwiftGodot-Tutorials","role":"project","title":"Your First Extension","category":"SwiftGodot"},"sections":[{"chapter":"SwiftGodot Essentials","projectFiles":"SimpleRunner-Starter.zip","content":[{"inlineContent":[{"text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll","type":"text"},{"text":" ","type":"text"},{"text":"start by building off the Simple Runner game project and create a player character to move the character along","type":"text"},{"text":" ","type":"text"},{"text":"the horizontal axis.","type":"text"}],"type":"paragraph"}],"title":"Your First Extension","backgroundImage":"RunnerHeader.png","image":"RunnerHeader.png","estimatedTimeInMinutes":30,"kind":"hero"},{"tasks":[{"title":"Create a Swift package","anchor":"Create-a-Swift-package","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Your extension for Godot lives as a Swift package alongside your Godot project. While Godot currently","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t support editing Swift packages in its editor, you can use Xcode to do most of the heavy lifting.","type":"text"}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"Open Xcode and select "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Package…"}]},{"type":"text","text":" to create a new Swift package."}],"type":"paragraph"}],"code":null,"type":"step","caption":[],"media":"NewPackage.png","runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the template chooser, select "},{"type":"strong","inlineContent":[{"type":"text","text":"Library"}]},{"type":"text","text":" and save the project near your game’s project files as"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"SimpleRunnerDriver","type":"text"}]},{"type":"text","text":"."}]}],"code":null,"type":"step","caption":[],"media":"LibraryPackageTemplate.png","runtimePreview":null},{"content":[{"inlineContent":[{"text":"In Package.swift, add the SwiftGodot binary dependency to your package.","type":"text"}],"type":"paragraph"}],"code":"Package-starter-2.swift","type":"step","caption":[],"media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set the type of the SimpleRunnerDriver library to dynamic and set the minimum platform target to macOS 14.","type":"text"}]}],"code":"Package-starter-3.swift","type":"step","caption":[],"media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the SimpleRunnerDriver target to add in the appropriate Swift compiler and linker settings. These"},{"type":"text","text":" "},{"type":"text","text":"flags are needed to allow dynamic lookup with the Godot engine."}]}],"code":"Package-starter-4.swift","type":"step","caption":[],"media":null,"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"text":"In SimpleRunnerDriver.swift, import the SwiftGodot library and call the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"initSwiftExtension"},{"text":" macro to create an entry point. For now, we can pass an empty array for the nodes","type":"text"},{"text":" ","type":"text"},{"text":"to be registered.","type":"text"}]}],"code":"SimpleRunnerDriver-starter-2.swift","type":"step","caption":[],"media":null,"runtimePreview":null}]},{"title":"Create a player character","anchor":"Create-a-player-character","contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Now that our package is set up, we can create a player controller to move the player around in.","type":"text"}]}],"kind":"contentAndMedia"}],"stepsSection":[{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Create a new Swift file called ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"PlayerController.swift"}]},{"text":" in the ","type":"text"},{"type":"codeVoice","code":"Sources\/SimpleRunnerDriver"},{"text":" directory and import the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftGodot library.","type":"text"}]}],"type":"step","caption":[],"code":"PlayerController-starter-init.swift","media":null},{"runtimePreview":null,"content":[{"inlineContent":[{"text":"Write a new ","type":"text"},{"code":"PlayerController","type":"codeVoice"},{"text":" class that inherits from ","type":"text"},{"code":"CharacterBody2D","type":"codeVoice"},{"text":" and add its required","type":"text"},{"text":" ","type":"text"},{"text":"initializers.","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"code":"PlayerController-starter-2.swift","media":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"acceleration","type":"codeVoice"},{"type":"text","text":", "},{"code":"friction","type":"codeVoice"},{"type":"text","text":", and "},{"code":"speed","type":"codeVoice"},{"type":"text","text":" properties to the player controller."}]}],"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"These will be used to calculate the final velocity of the player."}]}],"code":"PlayerController-starter-3.swift","media":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"code":"movementVector","type":"codeVoice"},{"type":"text","text":" computed property that creates a new vector and sets its X coordinate to the"},{"type":"text","text":" "},{"type":"text","text":"difference between the "},{"code":"move_right","type":"codeVoice"},{"type":"text","text":" and "},{"code":"move_left","type":"codeVoice"},{"type":"text","text":" actions. Return the normalized vector in the block."}]}],"type":"step","caption":[{"type":"paragraph","inlineContent":[{"text":"This vector will be used to determine the direction that the player is moving in along the X axis. For","type":"text"},{"text":" ","type":"text"},{"text":"now, we will assume that the player does ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"text":" move on the vertical axis.","type":"text"}]}],"code":"PlayerController-starter-4.swift","media":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"_physicsProcess","type":"codeVoice"},{"type":"text","text":" method to the player controller class and return from the function if the"},{"type":"text","text":" "},{"type":"text","text":"engine reports that we’re in the editor."}]}],"type":"step","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This check is needed here to ensure that keypresses are registered only when running in-game, as the"},{"type":"text","text":" "},{"type":"text","text":"extension runs at the engine level."}]}],"code":"PlayerController-starter-5.swift","media":null},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Check if the movement vector is a non-zero value (i.e., the player is actively pressing a key), and"},{"type":"text","text":" "},{"type":"text","text":"calculate the velocity at which the player moves. If your "},{"type":"codeVoice","code":"acceleration"},{"type":"text","text":", "},{"type":"codeVoice","code":"friction"},{"type":"text","text":", and\/or "},{"type":"codeVoice","code":"speed"},{"type":"text","text":" "},{"type":"text","text":"values are integers, be sure to explicitly define their types as floats\/doubles."}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"limitLength","type":"codeVoice"},{"text":" method is used to clamp the velocity down to the maximum ","type":"text"},{"code":"speed","type":"codeVoice"},{"text":" value so that the","type":"text"},{"text":" ","type":"text"},{"text":"player doesn’t build up a lot of speed.","type":"text"}],"type":"paragraph"}],"code":"PlayerController-starter-6.swift","media":null},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Add an else case that will have the player’s velocity moving towards zero, applying any "},{"type":"codeVoice","code":"friction"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"text","text":"necessary."}],"type":"paragraph"}],"type":"step","caption":[],"code":"PlayerController-starter-7.swift","media":null},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Finally, call "},{"type":"codeVoice","code":"moveAndSlide"},{"type":"text","text":" to move the player, sliding along any edges the player collides with, and"},{"type":"text","text":" "},{"type":"text","text":"call the parent’s "},{"type":"codeVoice","code":"physicsProcess(delta:)"},{"type":"text","text":" method."}],"type":"paragraph"}],"type":"step","caption":[],"code":"PlayerController-starter-8.swift","media":null},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"In, SimpleRunnerDriver.swift, register the "},{"code":"PlayerController","type":"codeVoice"},{"type":"text","text":" class type by adding this to the array"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"initSwiftExtension","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","caption":[{"inlineContent":[{"text":"This registration call exposed the class type to Godot as a valid node that can be used in the engine.","type":"text"}],"type":"paragraph"}],"code":"SimpleRunnerDriver-starter-3.swift","media":null}]},{"title":"Set up the extension","anchor":"Set-up-the-extension","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Before our Swift package can be built and used, the extension must be created and registered with Godot. To"},{"type":"text","text":" "},{"type":"text","text":"do this, you will create a "},{"code":"gdextension","type":"codeVoice"},{"type":"text","text":" file that tells Godot where to look for the dynamic libraries."}],"type":"paragraph"}],"mediaPosition":"trailing"}],"stepsSection":[{"media":"NewExtensionFile.png","type":"step","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Download the provided Example project "},{"inlineContent":[{"type":"text","text":"SimpleRunner-Starter.zip"}],"type":"strong"},{"type":"text","text":" at the top of the page."}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"Create a new "},{"code":"bin","type":"codeVoice"},{"type":"text","text":" folder in the SimpleRunner Godot project with an empty file"},{"type":"text","text":" "},{"code":"SimpleRunnerDriver.gdextension","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"code":null},{"media":null,"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In SimpleRunnerDriver.gdextension, create a configuration section with an ","type":"text"},{"type":"codeVoice","code":"entry_point"},{"text":" key that points","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"\"swift_entry_point\""},{"text":".","type":"text"}]}],"caption":[],"code":"SimpleRunnerDriver-starter-2.txt"},{"media":null,"type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"code":"libraries","type":"codeVoice"},{"type":"text","text":" section and set the path of "},{"code":"macos.debug","type":"codeVoice"},{"type":"text","text":" to"},{"type":"text","text":" "},{"code":"res:\/\/bin\/libSimpleRunnerDriver.dylib","type":"codeVoice"},{"type":"text","text":". And a "},{"code":"dependencies","type":"codeVoice"},{"type":"text","text":" section that will be used to copy the library into the application when exporting the project."}]}],"caption":[{"type":"paragraph","inlineContent":[{"text":"The name of the file corresponds to the built version of the dynamic library.","type":"text"}]}],"code":"SimpleRunnerDriver-starter-3.txt"},{"media":"SwiftBuild.png","type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"In the terminal, navigate to the SimpleRunnerDriver package and run ","type":"text"},{"code":"swift build","type":"codeVoice"},{"text":" to build the package.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This will build both SwiftGodot and the SimpleRunnerDriver packages, creating the dynamic library files"},{"type":"text","text":" "},{"type":"text","text":"we need for Godot."}]}],"code":null},{"media":"OpenSwiftBuild.png","type":"step","runtimePreview":null,"content":[{"inlineContent":[{"text":"Open the ","type":"text"},{"type":"codeVoice","code":".build\/{arch}\/debug"},{"text":" directory in the Finder using the ","type":"text"},{"type":"codeVoice","code":"open"},{"text":" command, replacing ","type":"text"},{"type":"codeVoice","code":"arch"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"text":"your Mac’s architecture folder.","type":"text"}],"type":"paragraph"}],"caption":[],"code":null},{"media":"DylibCopy.png","type":"step","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Copy the "},{"type":"codeVoice","code":"libSimpleRunnerDriver.dylib"},{"type":"text","text":" and "},{"type":"codeVoice","code":"libSwiftGodot.dylib"},{"type":"text","text":" files into the "},{"type":"codeVoice","code":"bin"},{"type":"text","text":" directory of the"},{"type":"text","text":" "},{"type":"text","text":"SimpleRunner Godot project."}],"type":"paragraph"}