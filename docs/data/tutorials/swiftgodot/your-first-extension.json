r\",","    platforms: [.macOS(.v13)],","    products: [","        \/\/ Products define the executables and libraries a package produces, making them visible to other packages.","        .library(","            name: \"SimpleRunnerDriver\",","            type: .dynamic,","            targets: [\"SimpleRunnerDriver\"]),","    ],","    dependencies: [","        .package(url: \"https:\/\/github.com\/migueldeicaza\/SwiftGodot\", branch: \"main\")","    ],","    targets: [","        \/\/ Targets are the basic building blocks of a package, defining a module or a test suite.","        \/\/ Targets can depend on other targets in this package and products from dependencies.","        .target(","            name: \"SimpleRunnerDriver\",","            dependencies: [","                \"SwiftGodot\",","            ],","            swiftSettings: [.unsafeFlags([\"-suppress-warnings\"])]","        ),","        .testTarget(","            name: \"SimpleRunnerDriverTests\",","            dependencies: [\"SimpleRunnerDriver\"]),","    ]",")"],"fileName":"Package.swift","type":"file","fileType":"swift","identifier":"Package-starter-4.swift","highlights":[{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28}],"syntax":"swift"},"doc://SwiftGodot/tutorials/SwiftGodot/Using-Swift-Godot-Kit":{"title":"Using SwiftGodotKit","estimatedTime":"5min","kind":"project","url":"\/tutorials\/swiftgodot\/using-swift-godot-kit","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit","type":"topic","abstract":[{"text":"SwiftGodotKit lets you drive Godot entirely from Swift, and treat Godot as just another Swift framework you can call into.","type":"text"}],"role":"project"},"doc://SwiftGodot/tutorials/SwiftGodot/Writing-Multiple-Scripts#Teleport-the-player":{"url":"\/tutorials\/swiftgodot\/writing-multiple-scripts#Teleport-the-player","kind":"section","type":"section","title":"Teleport the player","abstract":[{"text":"This tutorial builds off the Simple Runner game introduced in ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","isActive":true,"type":"reference"},{"type":"text","text":" and will introduce you"},{"type":"text","text":" "},{"type":"text","text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating"},{"type":"text","text":" "},{"text":"an infinite runner.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Teleport-the-player"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension":{"title":"Your First Extension","estimatedTime":"30min","kind":"project","url":"\/tutorials\/swiftgodot\/your-first-extension","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","type":"topic","abstract":[{"text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll","type":"text"},{"type":"text","text":" "},{"type":"text","text":"start by building off the Simple Runner game project and create a player character to move the character along"},{"text":" ","type":"text"},{"text":"the horizontal axis.","type":"text"}],"role":"project"},"PlayerController-starter-3.swift":{"type":"file","syntax":"swift","identifier":"PlayerController-starter-3.swift","fileType":"swift","content":["\/\/","\/\/  PlayerController.swift","\/\/","\/\/","\/\/  Created by Marquis Kurt on 7\/19\/23.","\/\/","","import SwiftGodot","","@Godot","class PlayerController: CharacterBody2D {","    var acceleration = 100","    var friction = 100","    var speed = 200","","}"],"fileName":"PlayerController.swift","highlights":[{"line":12},{"line":13},{"line":14},{"line":15}]},"PlayerController-starter-8.swift":{"highlights":[{"line":32},{"line":33}],"type":"file","fileType":"swift","fileName":"PlayerController.swift","identifier":"PlayerController-starter-8.swift","syntax":"swift","content":["\/\/","\/\/  PlayerCo