uce you"},{"text":" ","type":"text"},{"type":"text","text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating"},{"type":"text","text":" "},{"type":"text","text":"an infinite runner."}],"title":"Using the new main level node","kind":"section","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Using-the-new-main-level-node","type":"section"},"doc://SwiftGodot/tutorials/SwiftGodot-Tutorials":{"type":"topic","title":"Meet SwiftGodot","kind":"overview","abstract":[{"text":"SwiftGodot allows developers to take new and existing Swift packages and use them as extensions for the Godot game engine.","type":"text"}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials","url":"\/tutorials\/swiftgodot-tutorials","role":"overview"},"doc://SwiftGodot/tutorials/SwiftGodot/Writing-Multiple-Scripts":{"estimatedTime":"15min","url":"\/tutorials\/swiftgodot\/writing-multiple-scripts","role":"project","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts","type":"topic","title":"Writing Multiple Scripts","abstract":[{"text":"This tutorial builds off the Simple Runner game introduced in ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","isActive":true},{"type":"text","text":" and will introduce you"},{"text":" ","type":"text"},{"type":"text","text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating"},{"type":"text","text":" "},{"text":"an infinite runner.","type":"text"}],"kind":"project"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension":{"title":"Your First Extension","estimatedTime":"30min","kind":"project","url":"\/tutorials\/swiftgodot\/your-first-extension","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","type":"topic","abstract":[{"text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll","type":"text"},{"type":"text","text":" "},{"type":"text","text":"start by building off the Simple Runner game project and create a player character to move the character along"},{"text":" ","type":"text"},{"text":"the horizontal axis.","type":"text"}],"role":"project"},"doc://SwiftGodot/tutorials/SwiftGodot/Writing-Multiple-Scripts#Handle-vertical-movement":{"title":"Handle vertical movement","abstract":[{"type":"text","text":"This tutorial builds off the Simple Runner game introduced in "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","isActive":true},{"type":"text","text":" and will introduce you"},{"text":" ","type":"text"},{"type":"text","text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating"},{"text":" ","type":"text"},{"text":"an infinite runner.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Handle-vertical-movement","kind":"section","url":"\/tutorials\/swiftgodot\/writing-multiple-scripts#Handle-vertical-movement","type":"section"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension#Use-the-new-player-controller":{"url":"\/tutorials\/swiftgodot\/your-first-extension#Use-the-new-player-controller","kind":"section","type":"section","title":"Use the new player controller","abstract":[{"type":"text","text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll"},{"type":"text","text":" "},{"text":"start by building off the Simple Runner game project and create a player character to move the character along","type":"text"},{"text":" ","type":"text"},{"text":"the horizontal axis.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Use-the-new-player-controller"},"SwiftGodotKit-Main.swift":{"highlights":[],"fileName":"SwiftGodotKit-Main.swift","content":["\/\/","\/\/  main.swift","\/\/  SimpleGodotApp","\/\/","\/\/  Created by Miguel de Icaza on 9\/6\/23.","\/\/","","import Foundation","import SwiftGodotKit","import SwiftGodot","","func loadScene (scene: SceneTree) {","    let rootNode = Node3D()","    let camera = Camera3D ()","    camera.current = true","    camera.position = Vector3(x: 0, y: 0, z: 2)","    ","    rootNode.addChild(node: camera)","    ","    func makeCuteNode (_ pos: Vector3) -> Node {","        let n = SpinningCube()","        n.position = pos","        return n","    }","    rootNode.addChild(node: makeCuteNode(Vector3(x: 1, y: 1, z: 1)))","    rootNode.addChild(node: makeCuteNode(Vector3(x: -1, y: -1, z: -1)))","    rootNode.addChild(node: makeCuteNode(Vector3(x: 0, y: 1, z: 1)))","    scene.root?.addChild(node: rootNode)","}","","@Godot","class SpinningCube: Node3D {","    override func _ready () {","        let meshRender = MeshInstance3D()","        meshRender.mesh = BoxMesh()","        addChild(node: meshRender)","    }   ","","    override func _input (event: InputEvent) {","        guard event.isPressed () && !event.isEcho () else { return }","        print (\"SpinningCube: event: isPressed \")","    }","    ","    public override func _process(delta: Double) {","        rotateY(angle: delta)","    }","}","","func registerTypes (level: GDExtension.InitializationLevel) {","    switch level {","    case .scene:","        register (type: SpinningCube.self)","    default:","        break","    }","}","","guard let projectPath = Bundle.main.path(forResource: \"Project\", ofType: nil) else {","    fatalError(\"Could not load resource path\")","}","","runGodot(args: [\"--path\", projectPath], initHook: registerTypes, loadScene: loadScene, loadProjectSettings: { settings in })"],"syntax":"swift","type":"file","identifier":"SwiftGodotKit-Main.swift","fileType":"swift"},"doc://SwiftGodot/tutorials/SwiftGodot/Using-Swift-Godot-Kit#SwiftGodotKit-from-Xcode":{"title":"SwiftGodotKit from Xcode","abstract":[{"text":"SwiftGodotKit lets you drive Godot entirely from Swift, and treat Godot as just another Swift framework you can call into.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit#SwiftGodotKit-from-Xcode","kind":"section","url":"\/tutorials\/swiftgodot\/using-swift-godot-kit#SwiftGodotKit-from-Xcode","type":"section"},"doc://SwiftGodot/tutorials/SwiftGodot/Writing-Multiple-Scripts#Teleport-the-player":{"url":"\/tutorials\/swiftgodot\/writing-multiple-scripts#Teleport-the-player","kind":"section","type":"section","title":"Teleport the player","abstract":[{"text":"This tutorial builds off the Simple Runner game introduced in ","type":"text"},{"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","isActive":true,"type":"reference"},{"type":"text","text":" and will introduce you"},{"type":"text","text":" "},{"type":"text","text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating"},{"type":"text","text":" "},{"text":"an infinite runner.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Teleport-the-player"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension#Create-a-player-character":{"title":"Create a player character","abstract":[{"type":"text","text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll"},{"text":" ","type":"text"},{"type":"text","text":"start by building off the Simple Runner game project and create a player character to move the character along"},{"type":"text","text":" "},{"type":"text","text":"the horizontal axis."}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Create-a-player-character","kind":"section","url":"\/tutorials\/swiftgodot\/your-first-extension#Create-a-player-character","type":"section"},"SwiftGodotKit-Xcode-4-HardenedRuntime.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/SwiftGodot\/SwiftGodotKit-Xcode-4-HardenedRuntime.png"}],"alt":"Two Finder windows that show the dynamic library files being copied to the game's files.","identifier":"SwiftGodotKit-Xcode-4-HardenedRuntime.png"},"doc://SwiftGodot/tutorials/SwiftGodot-Tutorials/SwiftGodot-Essentials":{"title":"SwiftGodot Essentials","abstract":[],"role":"article","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials\/SwiftGodot-Essentials","kind":"article","url":"\/tutorials\/swiftgodot-tutorials\/swiftgodot-essentials","type":"topic"}}}