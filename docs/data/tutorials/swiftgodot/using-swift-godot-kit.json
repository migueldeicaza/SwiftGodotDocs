rive Godot entirely from Swift, and treat Godot as just another Swift framework you can call into."}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit#SwiftGodotKit-from-Xcode","type":"section","title":"SwiftGodotKit from Xcode"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension#Create-a-player-character":{"url":"\/tutorials\/swiftgodot\/your-first-extension#Create-a-player-character","abstract":[{"text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll","type":"text"},{"text":" ","type":"text"},{"text":"start by building off the Simple Runner game project and create a player character to move the character along","type":"text"},{"text":" ","type":"text"},{"text":"the horizontal axis.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Create-a-player-character","kind":"section","title":"Create a player character","type":"section"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension#Use-the-new-player-controller":{"type":"section","kind":"section","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension#Use-the-new-player-controller","url":"\/tutorials\/swiftgodot\/your-first-extension#Use-the-new-player-controller","role":"pseudoSymbol","title":"Use the new player controller","abstract":[{"text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll","type":"text"},{"text":" ","type":"text"},{"text":"start by building off the Simple Runner game project and create a player character to move the character along","type":"text"},{"text":" ","type":"text"},{"text":"the horizontal axis.","type":"text"}]},"doc://SwiftGodot/tutorials/SwiftGodot/Writing-Multiple-Scripts":{"role":"project","kind":"project","title":"Writing Multiple Scripts","url":"\/tutorials\/swiftgodot\/writing-multiple-scripts","type":"topic","estimatedTime":"15min","abstract":[{"type":"text","text":"This tutorial builds off the Simple Runner game introduced in "},{"type":"reference","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","isActive":true},{"type":"text","text":" and will introduce you"},{"type":"text","text":" "},{"type":"text","text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating"},{"type":"text","text":" "},{"type":"text","text":"an infinite runner."}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts"},"SwiftGodotKit-Xcode-3-AddTarget.png":{"identifier":"SwiftGodotKit-Xcode-3-AddTarget.png","variants":[{"url":"\/images\/SwiftGodot\/SwiftGodotKit-Xcode-3-AddTarget.png","traits":["1x","light"]}],"type":"image","alt":"Dialog showing which package products are available from SwiftGodotKit"},"doc://SwiftGodot/tutorials/SwiftGodot-Tutorials":{"kind":"overview","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot-Tutorials","url":"\/tutorials\/swiftgodot-tutorials","abstract":[{"text":"SwiftGodot allows developers to take new and existing Swift packages and use them as extensions for the Godot game engine.","type":"text"}],"role":"overview","title":"Meet SwiftGodot","type":"topic"},"SwiftGodotKit-Main.swift":{"type":"file","identifier":"SwiftGodotKit-Main.swift","syntax":"swift","highlights":[],"fileName":"SwiftGodotKit-Main.swift","fileType":"swift","content":["\/\/","\/\/  main.swift","\/\/  SimpleGodotApp","\/\/","\/\/  Created by Miguel de Icaza on 9\/6\/23.","\/\/","","import Foundation","import SwiftGodotKit","import SwiftGodot","","func loadScene (scene: SceneTree) {","    let rootNode = Node3D()","    let camera = Camera3D ()","    camera.current = true","    camera.position = Vector3(x: 0, y: 0, z: 2)","    ","    rootNode.addChild(node: camera)","    ","    func makeCuteNode (_ pos: Vector3) -> Node {","        let n = SpinningCube()","        n.position = pos","        return n","    }","    rootNode.addChild(node: makeCuteNode(Vector3(x: 1, y: 1, z: 1)))","    rootNode.addChild(node: makeCuteNode(Vector3(x: -1, y: -1, z: -1)))","    rootNode.addChild(node: makeCuteNode(Vector3(x: 0, y: 1, z: 1)))","    scene.root?.addChild(node: rootNode)","}","","@Godot","class SpinningCube: Node3D {","    override func _ready () {","        let meshRender = MeshInstance3D()","        meshRender.mesh = BoxMesh()","        addChild(node: meshRender)","    }   ","","    override func _input (event: InputEvent) {","        guard event.isPressed () && !event.isEcho () else { return }","        print (\"SpinningCube: event: isPressed \")","    }","    ","    public override func _process(delta: Double) {","        rotateY(angle: delta)","    }","}","","func registerTypes (level: ExtensionInitializationLevel) {","    switch level {","    case .scene:","        register (type: SpinningCube.self)","    default:","        break","    }","}","","guard let projectPath = Bundle.main.path(forResource: \"Project\", ofType: nil) else {","    fatalError(\"Could not load resource path\")","}","","runGodot(args: [\"--path\", projectPath], initHook: registerTypes, loadScene: loadScene, loadProjectSettings: { settings in })"]},"doc://SwiftGodot/tutorials/SwiftGodot/Using-Swift-Godot-Kit":{"role":"project","kind":"project","title":"Using SwiftGodotKit","url":"\/tutorials\/swiftgodot\/using-swift-godot-kit","type":"topic","estimatedTime":"5min","abstract":[{"type":"text","text":"SwiftGodotKit lets you drive Godot entirely from Swift, and treat Godot as just another Swift framework you can call into."}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Using-Swift-Godot-Kit"},"SwiftGodotKit-Xcode-2-AddPackage.png":{"identifier":"SwiftGodotKit-Xcode-2-AddPackage.png","variants":[{"url":"\/images\/SwiftGodot\/SwiftGodotKit-Xcode-2-AddPackage.png","traits":["1x","light"]}],"type":"image","alt":"Adding the package to the project"},"doc://SwiftGodot/tutorials/SwiftGodot/Writing-Multiple-Scripts#Teleport-the-player":{"abstract":[{"text":"This tutorial builds off the Simple Runner game introduced in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension"},{"text":" and will introduce you","type":"text"},{"text":" ","type":"text"},{"text":"to working with multiple scripts and interacting with Godot’s existing signals to teleport the player, creating","type":"text"},{"text":" ","type":"text"},{"text":"an infinite runner.","type":"text"}],"type":"section","identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Writing-Multiple-Scripts#Teleport-the-player","kind":"section","title":"Teleport the player","role":"pseudoSymbol","url":"\/tutorials\/swiftgodot\/writing-multiple-scripts#Teleport-the-player"},"doc://SwiftGodot/tutorials/SwiftGodot/Your-First-Extension":{"role":"project","title":"Your First Extension","type":"topic","kind":"project","abstract":[{"type":"text","text":"This tutorial will guide you through making your first Godot extension to create a player character. You’ll"},{"type":"text","text":" "},{"type":"text","text":"start by building off the Simple Runner game project and create a player character to move the character along"},{"type":"text","text":" "},{"type":"text","text":"the horizontal axis."}],"identifier":"doc:\/\/SwiftGodot\/tutorials\/SwiftGodot\/Your-First-Extension","estimatedTime":"30min","url":"\/tutorials\/swiftgodot\/your-first-extension"},"RunnerHeader.png":{"identifier":"RunnerHeader.png","variants":[{"url":"\/images\/SwiftGodot\/RunnerHeader.png","traits":["1x","light"]}],"type":"image","alt":"A screenshot of the Simple Runner game. The player wears a bird costume and runs alongside boxes."},"doc://SwiftGodot/tutorials/SwiftGodot-Tutorials/SwiftGodot-Essentials":{"role":"article","kind":"article","title":"SwiftGodot Essentials","abstract":[],"url":"\/tutorials\/swiftgodot-tutorials\/swiftgodot-essentials","type":"topic","identifier"